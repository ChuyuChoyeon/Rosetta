# ============================================================
# Rosetta 环境配置示例
# ============================================================
# 复制此文件为 .env 并根据您的环境修改配置
#
# 环境说明:
# - 开发环境 (development): SQLite + 内存缓存,简单快速启动
# - 生产环境 (production): PostgreSQL + Redis,高性能可扩展
# ============================================================

# ------------------------------------------------------------
# 应用配置
# ------------------------------------------------------------
APP_NAME=Rosetta Blog
APP_ENV=development
DEBUG=true

# ------------------------------------------------------------
# 数据库配置
# ------------------------------------------------------------
# 开发环境: SQLite(默认)
DATABASE_URL=sqlite+aiosqlite:///./rosetta.db

# 生产环境: PostgreSQL(取消注释并修改)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/rosetta

# 数据库连接池(仅 PostgreSQL 有效)
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ------------------------------------------------------------
# Redis 配置
# ------------------------------------------------------------
# 开发环境: 可不启用 Redis
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0

# 生产环境: 建议启用 Redis(取消注释)
# REDIS_ENABLED=true
# REDIS_URL=redis://:password@localhost:6379/0

# ------------------------------------------------------------
# JWT 认证配置
# ------------------------------------------------------------
# 生产环境必须更改此密钥!使用 `openssl rand -hex 32` 生成
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------
# CORS 配置
# ------------------------------------------------------------
# JSON 数组格式,列出允许的前端来源
# 开发环境默认放行所有来源,生产环境必须显式列出
CORS_ORIGINS=["http://localhost:4321", "http://127.0.0.1:4321"]

# ------------------------------------------------------------
# 站点配置
# ------------------------------------------------------------
SITE_NAME=Rosetta Blog
SITE_DESCRIPTION=Rosetta开源博客系统
SITE_KEYWORDS=blog,rosetta,astro,fastapi,svelte
SITE_AUTHOR=Administrator
SITE_EMAIL=admin@example.com
SITE_URL=http://localhost:4321

# ------------------------------------------------------------
# 功能开关
# ------------------------------------------------------------
ENABLE_COMMENTS=true
ENABLE_REGISTRATION=true
ENABLE_RSS_FEED=true

# ------------------------------------------------------------
# 日志配置
# ------------------------------------------------------------
LOG_LEVEL=INFO

# ------------------------------------------------------------
# 文件上传配置
# ------------------------------------------------------------
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=["jpg","jpeg","png","gif","webp","svg","pdf"]

# ------------------------------------------------------------
# 前端配置(仅 dev 模式生效)
# ------------------------------------------------------------
# Vite 开发代理目标后端地址
API_BASE_URL=http://localhost:8000

# 前端 API 客户端基址(构建时通过 import.meta.env 注入)
ROSETTA_API_BASE=http://localhost:8000/api

# ------------------------------------------------------------
# 管理员初始账号(OOBE 时使用,仅首次创建)
# ------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin123456
ADMIN_NICKNAME=Administrator

# ------------------------------------------------------------
# Docker Compose 配置(仅 docker compose 时生效)
# ------------------------------------------------------------
DB_USER=rosetta
DB_PASSWORD=rosetta_secret
DB_NAME=rosetta
DB_PORT=5432
REDIS_PASSWORD=redis_secret
REDIS_PORT=6379
BACKEND_PORT=8000
FRONTEND_PORT=80
BACKEND_WORKERS=4
