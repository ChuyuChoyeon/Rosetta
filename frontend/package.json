{
  "name": "frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "dev:all": "pwsh -NoProfile -NoLogo -ExecutionPolicy Bypass -File ../dev.ps1",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test home.spec --project=chromium",
    "playwright:install": "playwright install chromium"
  },
  "dependencies": {
    "@lucide/vue": "^1.31.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@pinia/nuxt": "^1.0.2",
    "@vee-validate/zod": "^4.15.1",
    "@vueuse/core": "^11.3.0",
    "@vueuse/shared": "^14.4.0",
    "dompurify": "^3.4.13",
    "highlight.js": "^11.12.0",
    "lucide-vue-next": "^1.0.0",
    "marked": "^18.0.9",
    "marked-highlight": "^2.2.4",
    "nuxt": "^4.5.1",
    "pinia": "^2.2.8",
    "radix-vue": "^1.9.17",
    "reka-ui": "^2.10.3",
    "vee-validate": "^4.15.1",
    "viewerjs": "^1.11.8",
    "vue-advanced-cropper": "^2.8.9",
    "vue-sonner": "^2.0.9",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/kit": "^4.5.2",
    "@nuxt/test-utils": "^4.1.0",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@vue/test-utils": "^2.4.11",
    "autoprefixer": "^10.5.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^10.8.1",
    "happy-dom": "^20.11.6",
    "ini": "^1.3.8",
    "postcss": "^8.5.26",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
