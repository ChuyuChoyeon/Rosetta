---
import { Icon } from "astro-icon/components";
import type { Announcement as AnnouncementItem } from "@/api/site";
import { getAnnouncements } from "@/api/site";
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import { announcementConfig as fallbackAnnouncementConfig } from "@/config/announcementConfig";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import type { WidgetComponentConfig } from "@/types/config";

interface Props {
	class?: string;
	style?: string;
	widgetConfig?: WidgetComponentConfig;
}
const { class: className, style, widgetConfig } = Astro.props;

const showTitle = widgetConfig?.showTitle !== false;

// 从后端 API 获取公告列表，失败时使用静态配置作为 fallback
let announcements: AnnouncementItem[] = [];
try {
	announcements = await getAnnouncements();
} catch (e) {
	console.warn("[Announcement] Failed to fetch from API, using fallback:", e);
}

// 公告类型对应的样式和图标
const typeStyleMap: Record<
	string,
	{ bg: string; icon: string; iconColor: string; border: string }
> = {
	info: {
		bg: "bg-blue-50 dark:bg-blue-900/20",
		icon: "material-symbols:info-outline-rounded",
		iconColor: "text-blue-500",
		border: "",
	},
	success: {
		bg: "bg-green-50 dark:bg-green-900/20",
		icon: "material-symbols:check-circle-outline-rounded",
		iconColor: "text-green-500",
		border: "",
	},
	warning: {
		bg: "bg-amber-50 dark:bg-amber-900/20",
		icon: "material-symbols:warning-outline-rounded",
		iconColor: "text-amber-500",
		border: "",
	},
	error: {
		bg: "bg-red-50 dark:bg-red-900/20",
		icon: "material-symbols:error-outline-rounded",
		iconColor: "text-red-500",
		border: "",
	},
};

// 如果后端没有公告，使用静态配置 fallback 渲染单条
const hasApiAnnouncements = announcements.length > 0;
---

<WidgetLayout
  name={i18n(I18nKey.announcement)}
  showTitle={showTitle}
  id="announcement"
  class={className}
  style={style}
>
  <div class="flex flex-col gap-3">
    {hasApiAnnouncements ? (
      /* ===== 后端API公告列表：每条独立卡片 ===== */
      announcements.map((ann, idx) => {
        const styleCfg = typeStyleMap[ann.type] || typeStyleMap.info;
        const annId = `ann-item-${ann.id}`;
        return (
          <div
            id={annId}
            class:list={[
              "rounded-lg p-3.5 pl-3.5 shadow-sm",
              styleCfg.bg,
              styleCfg.border,
            ]}
          >
            <div class="flex items-start justify-between gap-2 mb-1.5">
              <div class="flex items-center gap-2 min-w-0">
                <Icon
                  is:inline
                  name={styleCfg.icon}
                  class:list={["shrink-0 text-lg", styleCfg.iconColor]}
                />
                <h4 class="font-semibold text-sm truncate text-neutral-800 dark:text-neutral-100">
                  {ann.title}
                </h4>
              </div>
              {ann.is_dismissible && (
                <button
                  class="btn-plain rounded-md h-7 w-7 shrink-0 text-sm hover:bg-black/5 dark:hover:bg-white/10 transition-colors"
                  onclick={`const el=document.getElementById('${annId}'); if(el) el.style.display='none';`}
                  aria-label={i18n(I18nKey.announcementClose)}
                >
                  <Icon is:inline name="fa7-solid:xmark" class="text-xs opacity-70" />
                </button>
              )}
            </div>
            <div class="pl-7 text-sm text-neutral-600 dark:text-neutral-300 leading-relaxed whitespace-pre-line">
              {ann.content}
            </div>
          </div>
        );
      })
    ) : (
      /* ===== Fallback：静态单条公告（兼容旧配置） ===== */
      <div class:list={[
        "rounded-lg p-3.5 pl-3.5 shadow-sm",
        typeStyleMap.info.bg,
        typeStyleMap.info.border,
      ]}>
        <div class="flex items-start justify-between gap-2 mb-1.5">
          <div class="flex items-center gap-2 min-w-0">
            <Icon
              is:inline
              name={typeStyleMap.info.icon}
              class:list={["shrink-0 text-lg", typeStyleMap.info.iconColor]}
            />
            <h4 class="font-semibold text-sm truncate text-neutral-800 dark:text-neutral-100">
              {fallbackAnnouncementConfig.title || i18n(I18nKey.announcement)}
            </h4>
          </div>
          {fallbackAnnouncementConfig.closable && (
            <button
              class="btn-plain rounded-md h-7 w-7 shrink-0 text-sm hover:bg-black/5 dark:hover:bg-white/10 transition-colors"
              onclick="this.closest('widget-layout').style.display='none'"
              aria-label={i18n(I18nKey.announcementClose)}
            >
              <Icon is:inline name="fa7-solid:xmark" class="text-xs opacity-70" />
            </button>
          )}
        </div>
        <div class="pl-7 text-sm text-neutral-600 dark:text-neutral-300 leading-relaxed whitespace-pre-line">
          {fallbackAnnouncementConfig.content}
        </div>
        {fallbackAnnouncementConfig.link && fallbackAnnouncementConfig.link.enable !== false && (
          <div class="pl-7 mt-2.5">
            <a
              href={fallbackAnnouncementConfig.link.url}
              target={fallbackAnnouncementConfig.link.external ? "_blank" : "_self"}
              rel={fallbackAnnouncementConfig.link.external ? "noopener noreferrer" : undefined}
              class="btn-regular rounded-lg px-3 py-1.5 text-sm font-medium active:scale-95 transition-transform inline-block"
            >
              {fallbackAnnouncementConfig.link.text}
            </a>
          </div>
        )}
      </div>
    )}
  </div>
</WidgetLayout>
