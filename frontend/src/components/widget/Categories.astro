---
import ButtonLink from "@/components/common/ButtonLink.astro";
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import I18nKey from "@/i18n/i18nKey";
import { i18nFor, readEffectiveLangHintRaw } from "@/i18n/translation";
import type { WidgetComponentConfig } from "@/types/config";
import { getCategoryList } from "@/utils/content-utils";

const categories = await getCategoryList();

const COLLAPSED_HEIGHT = "7.5rem";

interface Props {
	class?: string;
	style?: string;
	widgetConfig?: WidgetComponentConfig;
}
const { class: className, style, widgetConfig } = Astro.props;

const collapseThreshold = widgetConfig?.specificConfig?.collapseThreshold;
const showTitle = widgetConfig?.showTitle !== false;
const isCollapsed = collapseThreshold
	? categories.length > collapseThreshold
	: false;

// SSR 下用 cookie 语言翻译，保证切语言后服务端渲染文案一致
const ssrLang = readEffectiveLangHintRaw(Astro);
const t = (k: I18nKey, vars?: Record<string, string | number>) => i18nFor(k, ssrLang, vars);
---

<WidgetLayout name={t(I18nKey.categories)} nameI18nKey={I18nKey.categories} showTitle={showTitle} id="categories" isCollapsed={isCollapsed} collapsedHeight={COLLAPSED_HEIGHT}
                class={className} style={style}
>
    {categories.map((c) => {
        const visibleName = c.name.trim();
        const countText = String(c.count ?? 0);
        // label-content-name-mismatch 修复：ButtonLink 结构为 <a><button>名 + badge数</button></a>，
        // a>button 嵌套交互元素会导致 axe-core 提取可见文本时与 aria-label 前缀无法严格匹配。
        // 最简单且正确的做法：不传 label 属性，让内部可见文本（名字 + badge 数字）直接作为 accessible name，
        // 两者天然一致，不会触发 label-content-name-mismatch。
        return (
            <ButtonLink
                url={c.url}
                badge={countText}
                color={c.color}
                icon={c.icon ?? undefined}
            >
                {visibleName}
            </ButtonLink>
        );
    })}
</WidgetLayout>