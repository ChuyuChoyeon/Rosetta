---
import { Icon } from "astro-icon/components";
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import DynamicSidebar from "@/components/widget/DynamicSidebar.svelte";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import type { WidgetComponentConfig } from "@/types/config";
import { loadDynamicConfig } from "@/utils/dynamic-config";
import { url } from "@/utils/url-utils";

interface Props {
	class?: string;
	style?: string;
	widgetConfig?: WidgetComponentConfig;
}

const { class: className, style, widgetConfig } = Astro.props;
const showTitle = widgetConfig?.showTitle !== false;
const configuredLimit = widgetConfig?.specificConfig?.dynamic?.limit ?? 3;
const limit = Math.max(1, Math.floor(configuredLimit));

// 从后端加载配置，使用 dynamicPage 和 sidebar 配置
const config = await loadDynamicConfig();
const dynamicCfg = config.dynamicPage;

const apiUrl = dynamicCfg.apiUrl?.startsWith("http")
	? dynamicCfg.apiUrl
	: url(dynamicCfg.apiUrl || "/api/activities");
const memos = dynamicCfg.memos;

// 使用后端 sidebar.showDynamics 作为显示开关，兜底 pages.dynamic
const showDynamicWidget =
	config.sidebar?.showDynamics ?? config.pages.dynamic ?? true;
---

{
	showDynamicWidget && (
		<WidgetLayout
			name={i18n(I18nKey.latestDynamics)}
			showTitle={showTitle}
			id="latest-dynamics"
			class={className}
			style={style}
		>
			<DynamicSidebar client:load apiUrl={apiUrl} limit={limit} {memos} />
			<a
				class="btn-plain mt-2 flex items-center justify-center gap-1 rounded-lg p-1.5
					text-sm text-(--primary)"
				href={url("/dynamic/")}
			>
				<Icon
					is:inline
					name="material-symbols:dynamic-feed-rounded"
					class="size-4.5"
					aria-hidden="true"
				/>
				<span>{i18n(I18nKey.moreDynamics)}</span>
				<span data-dynamic-count class="opacity-60"></span>
			</a>
		</WidgetLayout>
	)
}
