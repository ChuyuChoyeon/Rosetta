---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import { Icon } from "astro-icon/components";
import CoverImage from "@/components/common/CoverImage.astro";
import PostMetadata from "@/components/layout/PostMeta.astro";
import PostStats from "@/components/layout/PostStats.astro";
import { loadDynamicConfig } from "@/utils/dynamic-config";
import { getApiUrlList, processCoverImageSync } from "@/utils/image-utils";
import { getFileDirFromPath, getTagUrl } from "@/utils/url-utils";

interface Props {
	class?: string;
	entry: CollectionEntry<"posts">;
	title: string;
	url: string;
	published: Date;
	updated?: Date;
	tags: string[];
	category: string | null;
	image: string;
	description: string;
	draft: boolean;
	pinned?: boolean;
	password?: boolean;
	style: string;
	loading?: "lazy" | "eager";
}
const {
	entry,
	title,
	url,
	published,
	tags,
	category,
	image,
	description,
	pinned,
	password,
	style,
	loading = "lazy",
} = Astro.props;
const className = Astro.props.class;

// 处理随机图：如果image为"api"，则从配置的API获取随机图
const processedImage = processCoverImageSync(image, entry.id);
const apiUrls = getApiUrlList(image, entry.id);
const hasCover =
	processedImage !== undefined &&
	processedImage !== null &&
	processedImage !== "";

const coverWidth = "35%";

// 从后端动态加载配置
const config = await loadDynamicConfig();
const postListCfg = config.postListLayout;

const descriptionLines = Math.max(
	0,
	Math.trunc(postListCfg.descriptionLines ?? 2),
);

// PostMeta 配置（暂时用默认值，meta 和 stats 是扩展字段，后续可扩展到后端）
const showCategory = true;
const metaShowTags = true;
const metaTagCount = 1;
const metaShowWords = true;
const metaShowReadingTime = true;
const metaShowPublished = true;

// PostStats 配置
const statsShowPublished = true;
const statsShowWords = true;
const statsShowReadingTime = true;

// 标签显示位置
const tagsPosition = postListCfg.tagsPosition ?? "meta";
const showTagsInMeta = metaShowTags && tagsPosition === "meta";
const showTagsAtBottom = metaShowTags && tagsPosition === "bottom";
const descriptionClampLines = String(descriptionLines);
const shouldClampDescription = descriptionLines > 0;

const { remarkPluginFrontmatter } = await render(entry);
const descriptionText = description || remarkPluginFrontmatter.excerpt || "";
const words = remarkPluginFrontmatter.words;
const minutes = remarkPluginFrontmatter.minutes;
---

<div
  class:list={[
    "post-card-wrapper",
    hasCover ? "has-cover" : "no-cover",
    pinned ? "is-pinned" : "",
    "card-base flex flex-col-reverse w-full overflow-hidden relative",
    className,
  ]}
  style={style}
>
  <!-- pinned 置顶标识（右上角） -->
  {pinned && (
    <div class="pin-badge" aria-label="置顶文章">
      <Icon is:inline name="material-symbols:push-pin-rounded" class="pin-icon" />
      <span class="pin-text">置顶</span>
    </div>
  )}

  <div
    class:list={[
      "post-card-content",
      "pl-4 md:pl-5 pr-4 md:pr-2 pt-4 md:pt-5 pb-4 md:pb-5 relative flex flex-col h-full",
      {
        "w-full md:w-[calc(100%-52px-12px)]": !hasCover,
        "w-full md:w-[calc(100%-var(--coverWidth)-1.5rem)]": hasCover,
      },
    ]}
  >
    <a
      href={url}
      class="post-card-title transition-colors group w-full block mb-3"
    >
      {password && (
        <Icon
          is:inline
          name="material-symbols:lock-outline"
          class="lock-icon"
        />
      )}
      <span class="post-card-title__text">{title}</span>
    </a>

    <!-- metadata -->
    <PostMetadata
      published={published}
      tags={tags}
      showPublished={metaShowPublished}
      showCategory={showCategory}
      showTags={showTagsInMeta}
      maxTags={metaTagCount > 0 ? metaTagCount : undefined}
      showNoTags={true}
      hideUpdateDate={true}
      category={category || undefined}
      pinned={pinned}
      words={words}
      minutes={minutes}
      showWords={metaShowWords}
      showReadingTime={metaShowReadingTime}
      className="mb-4 post-meta card-header-meta"
    />

    <!-- description 带 fade-out 渐变截断 -->
    <div
      class:list={[
        "post-card-description",
        { "description-clamped": shouldClampDescription },
      ]}
      title={descriptionText}
    >
      {password ? (
        <span class="encrypted-hint">
          <Icon is:inline name="material-symbols:lock-outline" class="hint-icon" />
          该文章已加密，请输入密码查看
        </span>
      ) : (
        descriptionText
      )}
    </div>

    <!-- bottom tags（与 stats 二选一） -->
    {showTagsAtBottom && tags && tags.length > 0 && (
      <div class="post-card-bottom-tags flex flex-wrap items-center gap-2 mt-auto pt-3">
        {(metaTagCount > 0 ? tags.slice(0, metaTagCount) : tags).map((tag) => (
          <a
            href={getTagUrl(tag)}
            class="post-tag-chip"
          >
            #{tag.trim()}
          </a>
        ))}
      </div>
    )}

    <!-- stats（与底部标签二选一） -->
    {!showTagsAtBottom && (
      <PostStats
        published={published}
        words={words}
        minutes={minutes}
        showPublished={statsShowPublished}
        showWords={statsShowWords}
        showReadingTime={statsShowReadingTime}
        showIcons={postListCfg.showStatsIcons}
        className="stats mt-auto pt-3 gap-x-2"
      />
    )}
  </div>

  <!-- 封面图 -->
  {hasCover && (
    <a
      href={url}
      aria-label={title}
      class:list={[
        "post-card-image",
        "group",
        "w-full md:w-(--coverWidth)",
        "aspect-[2/1] md:aspect-auto",
        "relative md:absolute md:top-4 md:bottom-4 md:right-4",
        "rounded-[12px] overflow-hidden",
      ]}
    >
      <div class="cover-overlay pointer-events-none" />
      <div class="cover-arrow pointer-events-none">
        <Icon
          is:inline
          name="material-symbols:chevron-right-rounded"
          class="arrow-icon"
        />
      </div>
      <CoverImage
        src={processedImage}
        basePath={getFileDirFromPath(entry.filePath || "")}
        alt={`${title} 的封面图片`}
        class="cover-img"
        preview={true}
        loading={loading}
        apiUrls={apiUrls}
      />
    </a>
  )}

  <!-- 无封面：进入按钮 -->
  {!hasCover && (
    <a
      href={url}
      aria-label={`阅读文章：${title}`}
      class:list={[
        "post-card-enter-btn",
        "flex items-center justify-center",
        "absolute top-1/2 -translate-y-1/2 right-3",
      ]}
    >
      <Icon
        is:inline
        name="material-symbols:chevron-right-rounded"
        class="enter-btn-icon"
      />
    </a>
  )}
</div>

<style define:vars={{ coverWidth, descriptionClampLines }}>
  /* ==================== 基础变量 & 卡片整体 ==================== */
  :root {
    --pc-radius: 12px;
    --pc-ease: cubic-bezier(0.4, 0, 0.2, 1);
  }

  .post-card-wrapper {
    border-radius: var(--pc-radius);
    background: var(--card-bg, #ffffff);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    transition: box-shadow 0.2s var(--pc-ease),
                border-color 0.2s var(--pc-ease),
                transform 0.2s var(--pc-ease);
  }

  .post-card-wrapper:hover {
    transform: translateY(-1px);
  }

  /* pinned 轻微高亮（无左边条，仅背景混一点点品牌色） */
  .post-card-wrapper.is-pinned {
    background: color-mix(in srgb, var(--primary) 3%, var(--card-bg, #ffffff));
  }
  html.dark .post-card-wrapper.is-pinned {
    background: color-mix(in srgb, var(--primary) 4%, var(--card-bg, #1f1f1f));
  }

  /* ==================== 置顶标识 ==================== */
  .pin-badge {
    position: absolute;
    top: 10px;
    right: 12px;
    z-index: 5;
    display: inline-flex;
    align-items: center;
    gap: 3px;
    padding: 3px 9px;
    font-size: 12px;
    font-weight: 600;
    line-height: 1.4;
    border-radius: 999px;
    color: var(--antd-text-primary, #1f1f1f);
    background: color-mix(in srgb, var(--primary, #1677ff) 14%, #ffffff);
    border: 1px solid color-mix(in srgb, var(--primary, #1677ff) 22%, transparent);
    backdrop-filter: blur(6px);
    pointer-events: none;
  }
  html.dark .pin-badge {
    color: #e5e7eb;
    background: color-mix(in srgb, var(--primary, #1677ff) 18%, #1f1f1f);
    border-color: color-mix(in srgb, var(--primary, #1677ff) 30%, transparent);
  }
  .pin-icon {
    width: 14px;
    height: 14px;
    transform: rotate(20deg);
    color: var(--primary, #1677ff);
  }

  /* ==================== 标题 ==================== */
  .post-card-title {
    display: flex;
    align-items: flex-start;
    gap: 6px;
  }
  .post-card-title__text {
    font-size: clamp(18px, 1.6vw, 20px);
    font-weight: 600;
    line-height: 1.4;
    color: var(--antd-text-primary, rgba(0, 0, 0, 0.88));
    transition: color 0.2s var(--pc-ease);
  }
  html.dark .post-card-title__text {
    color: var(--antd-text-primary-dark, rgba(255, 255, 255, 0.88));
  }
  .post-card-title:hover .post-card-title__text {
    color: var(--primary, #1677ff);
  }
  .lock-icon {
    flex-shrink: 0;
    width: 18px;
    height: 18px;
    margin-top: 3px;
    color: var(--antd-text-secondary, rgba(0, 0, 0, 0.45));
  }
  html.dark .lock-icon {
    color: var(--antd-text-secondary-dark, rgba(255, 255, 255, 0.45));
  }

  /* ==================== 描述文本 ==================== */
  .post-card-description {
    position: relative;
    padding-right: 0.5rem;
    font-size: clamp(13px, 1.2vw, 14px);
    line-height: 1.65;
    color: var(--antd-text-secondary, rgba(0, 0, 0, 0.65));
  }
  html.dark .post-card-description {
    color: var(--antd-text-secondary-dark, rgba(255, 255, 255, 0.65));
  }
  .description-clamped {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    overflow: hidden;
    -webkit-line-clamp: var(--descriptionClampLines);
    line-clamp: var(--descriptionClampLines);
    max-height: calc(1.65 * 14px * var(--descriptionClampLines) + 2px);
    -webkit-mask-image: linear-gradient(180deg, #000 60%, rgba(0,0,0,0.6) 85%, transparent 100%);
            mask-image: linear-gradient(180deg, #000 60%, rgba(0,0,0,0.6) 85%, transparent 100%);
  }
  .encrypted-hint {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--antd-text-secondary, rgba(0, 0, 0, 0.45));
    font-style: italic;
  }
  html.dark .encrypted-hint {
    color: var(--antd-text-secondary-dark, rgba(255, 255, 255, 0.45));
  }
  .hint-icon {
    width: 16px;
    height: 16px;
  }

  /* ==================== 标签（bottom） ==================== */
  .post-tag-chip {
    display: inline-flex;
    align-items: center;
    padding: 3px 10px;
    font-size: 12px;
    font-weight: 500;
    line-height: 1.5;
    border-radius: 10px;
    background: rgba(0, 0, 0, 0.04);
    color: var(--antd-text-secondary, rgba(0, 0, 0, 0.65));
    text-decoration: none;
    transition: background-color 0.2s var(--pc-ease),
                color 0.2s var(--pc-ease),
                transform 0.15s var(--pc-ease);
  }
  .post-tag-chip:hover {
    background: color-mix(in srgb, var(--primary) 10%, rgba(0,0,0,0.04));
    color: var(--primary, #1677ff);
    transform: translateY(-1px);
  }
  html.dark .post-tag-chip {
    background: rgba(255, 255, 255, 0.08);
    color: var(--antd-text-secondary-dark, rgba(255,255,255,0.65));
  }
  html.dark .post-tag-chip:hover {
    background: color-mix(in srgb, var(--primary) 16%, rgba(255,255,255,0.08));
    color: var(--primary, #4096ff);
  }

  /* ==================== 封面图 ==================== */
  .cover-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s var(--pc-ease);
    aspect-ratio: 16 / 9;
  }
  .post-card-image:hover .cover-img {
    transform: scale(1.05);
  }
  .post-card-image:active .cover-img {
    transform: scale(1.08);
  }

  .cover-overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: transparent;
    transition: background-color 0.2s var(--pc-ease);
  }
  .post-card-image:hover .cover-overlay {
    background: rgba(0, 0, 0, 0.2);
  }

  .cover-arrow {
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translate(0, -50%) scale(0.6);
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.25);
    backdrop-filter: blur(6px);
    opacity: 0;
    transition: opacity 0.2s var(--pc-ease),
                transform 0.25s var(--pc-ease),
                background-color 0.2s var(--pc-ease);
  }
  .post-card-image:hover .cover-arrow {
    opacity: 1;
    transform: translate(0, -50%) scale(1);
  }
  .arrow-icon {
    width: 26px;
    height: 26px;
    color: #ffffff;
    filter: drop-shadow(0 1px 2px rgba(0,0,0,0.25));
  }

  /* ==================== 进入按钮（无封面） ==================== */
  .post-card-enter-btn {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: rgba(0, 0, 0, 0.04);
    transition: background-color 0.2s var(--pc-ease),
                color 0.2s var(--pc-ease),
                transform 0.15s var(--pc-ease);
  }
  .post-card-enter-btn:hover {
    background: rgba(0, 0, 0, 0.08);
  }
  .post-card-enter-btn:active {
    background: rgba(0, 0, 0, 0.12);
    transform: scale(0.95);
  }
  .enter-btn-icon {
    width: 24px;
    height: 24px;
    color: var(--antd-text-secondary, rgba(0, 0, 0, 0.45));
    transition: color 0.2s var(--pc-ease);
  }
  .post-card-enter-btn:hover .enter-btn-icon {
    color: var(--primary, #1677ff);
  }
  html.dark .post-card-enter-btn {
    background: rgba(255, 255, 255, 0.08);
  }
  html.dark .post-card-enter-btn:hover {
    background: rgba(255, 255, 255, 0.12);
  }
  html.dark .enter-btn-icon {
    color: var(--antd-text-secondary-dark, rgba(255,255,255,0.45));
  }

  /* ============ Grid 模式 & List 模式兼容 ============ */
  /* Grid 桌面端 */
  :global(.grid-mode) .post-card-wrapper {
    flex-direction: column-reverse !important;
    height: 100% !important;
    justify-content: flex-end !important;
  }
  :global(.grid-mode) .post-card-content {
    width: 100% !important;
    height: auto !important;
    flex-grow: 1 !important;
  }
  :global(.grid-mode) .post-card-image {
    position: relative !important;
    top: auto !important;
    bottom: auto !important;
    right: auto !important;
    width: 100% !important;
    margin: 0 !important;
    border-radius: var(--pc-radius) var(--pc-radius) 0 0 !important;
    aspect-ratio: 16 / 9 !important;
    max-height: none !important;
  }
  :global(.grid-mode) .has-cover .post-card-content {
    padding-top: 1rem !important;
  }
  :global(.grid-mode) .no-cover .post-card-content {
    width: calc(100% - 52px - 12px) !important;
  }
  :global(.grid-mode) .post-card-enter-btn {
    display: flex !important;
  }

  /* List 桌面端 */
  @media (min-width: 768px) {
    :global(.list-mode) .post-card-wrapper {
      flex-direction: row !important;
    }
    :global(.list-mode) .has-cover .post-card-content {
      width: calc(100% - var(--coverWidth) - 1.5rem) !important;
      padding: 1.5rem 0.5rem 1.5rem 2rem !important;
    }
    :global(.list-mode) .has-cover .post-card-image {
      top: 1rem !important;
      bottom: 1rem !important;
      right: 1rem !important;
      width: var(--coverWidth) !important;
      border-radius: 12px !important;
    }
    :global(.list-mode) .post-card-title__text {
      font-size: 20px !important;
      line-height: 1.4 !important;
      margin-bottom: 0 !important;
    }
    :global(.list-mode) .no-cover .post-card-content {
      width: calc(100% - 52px - 12px) !important;
    }
    :global(.list-mode) .post-card-enter-btn {
      display: flex !important;
    }
  }

  /* List 移动端 */
  :global(.list-mode) .post-card-wrapper {
    flex-direction: row !important;
  }
  :global(.list-mode) .has-cover .post-card-content {
    width: calc(100% - 9rem - 0.75rem) !important;
    padding: 0.75rem 0.5rem 0.75rem 0.75rem !important;
  }
  :global(.list-mode) .has-cover .post-card-image {
    position: absolute !important;
    top: 0.5rem !important;
    bottom: 0.5rem !important;
    right: 0.5rem !important;
    width: 9rem !important;
    border-radius: 12px !important;
  }
  :global(.list-mode) .post-card-title__text {
    font-size: 18px !important;
    line-height: 1.4 !important;
  }
</style>
