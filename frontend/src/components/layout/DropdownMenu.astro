---
import { Icon } from "astro-icon/components";
import DropdownItem from "@/components/common/DropdownItem.astro";
import DropdownPanel from "@/components/common/DropdownPanel.astro";
import type { NavBarLink } from "@/types/config";
import { url } from "@/utils/url-utils";

interface Props {
	link: NavBarLink;
	class?: string;
}

const { link, class: className } = Astro.props;

// 检查 link 是否存在
if (!link) {
	return null;
}

const processedLink = link;
const i18nTitlesStr = processedLink.i18n_titles
	? JSON.stringify(processedLink.i18n_titles)
	: undefined;

const hasChildren = processedLink.children && processedLink.children.length > 0;

// ============ 路由边界：前台 ↔ 后台 / 登录 / OOBE / 错误页
// 命中时不交给 Swup，强制整页刷新，避免外壳布局残留。
// 注意：站点可能被部署在子路径 (base path) 下，url() 返回形如 /rosetta/admin/ 。
// 因此不能只判断 startsWith("/admin")，要按路径段 (segment) 判断。
function shouldBypassSwup(
	hrefRaw: string | undefined,
	external: boolean | undefined,
): boolean {
	if (external || !hrefRaw) return false;
	try {
		const u = new URL(hrefRaw, "http://x");
		const p = u.pathname || "";
		const segments = p.split("/").filter((s) => s.length > 0);
		const first = segments[0] || "";
		const last = segments[segments.length - 1] || "";
		const hasAdmin = segments.some((s) => s === "admin");
		const hasLogin = segments.some((s) => s === "login");
		const hasOobe = segments.some((s) => s === "oobe");
		const isError =
			last === "404" ||
			last === "403" ||
			last === "500" ||
			first === "404" ||
			first === "403" ||
			first === "500";
		return hasAdmin || hasLogin || hasOobe || isError;
	} catch {
		return false;
	}
}
const rootHref = processedLink.external
	? processedLink.url
	: url(processedLink.url);
const rootBypassSwup = shouldBypassSwup(rootHref, processedLink.external);
---

<div class:list={["dropdown-container", className]} data-dropdown>
	{hasChildren ? (
		<>
			<button 
				class="btn-plain scale-animation rounded-lg h-10 font-bold px-4 pr-8 active:scale-95 dropdown-trigger relative"
				aria-expanded="false"
				aria-haspopup="true"
				data-dropdown-trigger
				type="button"
			>
				<div class="flex items-center gap-1.5">
					{processedLink.icon && <Icon is:inline name={processedLink.icon} class="text-[1.1rem] mr-1.5 navbar-icon" />}
					<span
						class="i18n-nav-title"
						data-i18n-titles={i18nTitlesStr}
						aria-label={processedLink.name}
					>{processedLink.name}</span>
				</div>
				<Icon is:inline name="material-symbols:keyboard-arrow-down-rounded" class="text-[1.2rem] transition-transform duration-200 dropdown-arrow absolute right-2.5 top-1/2 -translate-y-1/2" />
			</button>
			<div class="dropdown-menu" data-dropdown-menu>
				<DropdownPanel class="dropdown-content">
					{processedLink.children?.map((child, index) => {
						const childTitles = child.i18n_titles
							? JSON.stringify(child.i18n_titles)
							: undefined;
						const childHref = child.external ? child.url : url(child.url);
						const childBypass = shouldBypassSwup(childHref, child.external);
						return (
						<DropdownItem
							href={childHref}
							target={child.external ? "_blank" : undefined}
							isLast={index === (processedLink.children?.length || 0) - 1}
							class="dropdown-item h-10"
							rel={child.external ? "noopener noreferrer" : undefined}
						>
							{child.icon && <Icon is:inline name={child.icon} class="text-[1.25rem] mr-3 navbar-icon" />}
							<span
								class="i18n-nav-title"
								data-i18n-titles={childTitles}
								aria-label={child.name}
							>{child.name}</span>
							{child.external && (
								<Icon is:inline name="fa7-solid:arrow-up-right-from-square" class="text-[0.75rem] text-black/25 dark:text-white/25 ml-auto" />
							)}
						</DropdownItem>
					)})}
				</DropdownPanel>
			</div>
		</>
	) : (
		<a 
			aria-label={processedLink.name} 
			href={rootHref} 
			target={processedLink.external ? "_blank" : null}
			rel={processedLink.external ? "noopener noreferrer" : undefined}
			data-no-swup={rootBypassSwup || undefined}
			class="btn-plain scale-animation rounded-lg h-10 font-bold px-4 active:scale-95"
		>
			<div class="flex items-center gap-1.5">
				{processedLink.icon && <Icon is:inline name={processedLink.icon} class="text-[1.1rem] mr-1.5 navbar-icon" />}
				<span
					class="i18n-nav-title"
					data-i18n-titles={i18nTitlesStr}
				>{processedLink.name}</span>
				{processedLink.external && <Icon is:inline name="fa7-solid:arrow-up-right-from-square" class="text-[0.875rem] transition -translate-y-px ml-1 text-black/20 dark:text-white/20" />}
			</div>
		</a>
	)}
</div>

<style>
	@reference "../../styles/main.css";

	.dropdown-container {
		@apply relative;
	}

	.dropdown-menu {
		@apply absolute top-full left-0 pt-2 opacity-0 invisible pointer-events-none transition-all duration-200 ease-out transform translate-y-[-8px] z-50;
	}

	/* hover 展开：桌面端用户鼠标悬停即时显示 */
	.dropdown-container:hover .dropdown-menu,
	.dropdown-container:focus-within .dropdown-menu,
	/* click 展开：点击 trigger 时给 container 加 open 类保持显示 */
	.dropdown-container.dropdown-open .dropdown-menu {
		@apply opacity-100 visible pointer-events-auto translate-y-0;
	}

	.dropdown-container:hover .dropdown-arrow,
	.dropdown-container:focus-within .dropdown-arrow,
	.dropdown-container.dropdown-open .dropdown-arrow {
		@apply rotate-180;
	}

	.dropdown-content {
		@apply min-w-[12rem];
	}

	/* 移动端隐藏下拉菜单 */
	@media (max-width: 768px) {
		.dropdown-container {
			@apply hidden;
		}
	}
</style>

<script>
	// ============================================================
	// 主导航下拉：hover + click 双触发
	// - hover: 桌面端 CSS :hover 已兜底
	// - click: 点击 trigger 切换 open 状态（兼容触屏 / 喜欢点击的用户 / 无障碍键盘操作）
	// ============================================================
	document.addEventListener('DOMContentLoaded', function initDropdownMenus() {
		const dropdowns = document.querySelectorAll<HTMLElement>('[data-dropdown]');

		function isCurrentlyOpen(container: HTMLElement): boolean {
			const trigger = container.querySelector('[data-dropdown-trigger]') as HTMLElement | null;
			if (trigger) {
				if (trigger.getAttribute('aria-expanded') === 'true') return true;
			}
			return container.classList.contains('dropdown-open');
		}

		function setOpenState(container: HTMLElement, open: boolean) {
			const trigger = container.querySelector('[data-dropdown-trigger]') as HTMLElement | null;
			const menu = container.querySelector('[data-dropdown-menu]') as HTMLElement | null;
			if (open) {
				container.classList.add('dropdown-open');
				if (trigger) trigger.setAttribute('aria-expanded', 'true');
				if (menu) {
					menu.classList.remove('opacity-0', 'invisible', 'pointer-events-none', 'translate-y-[-8px]');
					menu.classList.add('opacity-100', 'visible', 'pointer-events-auto', 'translate-y-0');
				}
			} else {
				container.classList.remove('dropdown-open');
				if (trigger) trigger.setAttribute('aria-expanded', 'false');
				if (menu) {
					menu.classList.add('opacity-0', 'invisible', 'pointer-events-none', 'translate-y-[-8px]');
					menu.classList.remove('opacity-100', 'visible', 'pointer-events-auto', 'translate-y-0');
				}
			}
		}

		dropdowns.forEach((container) => {
			const trigger = container.querySelector('[data-dropdown-trigger]') as HTMLElement | null;
			const items = container.querySelectorAll<HTMLElement>('.dropdown-item');
			if (!trigger) return;

			// === 点击：切换 open 状态 ===
			trigger.addEventListener('click', function(e: Event) {
				e.preventDefault();
				e.stopPropagation();
				const willOpen = !isCurrentlyOpen(container);

				// 先关闭其它已打开的 sibling 菜单（避免同时开多个互相遮挡）
				dropdowns.forEach((other) => {
					if (other !== container) setOpenState(other, false);
				});

				setOpenState(container, willOpen);
			});

			// === 键盘操作：无障碍导航 ===
			trigger.addEventListener('keydown', function(e: KeyboardEvent) {
				if (e.key === 'Enter' || e.key === ' ') {
					e.preventDefault();
					trigger.click();
				} else if (e.key === 'ArrowDown') {
					e.preventDefault();
					setOpenState(container, true);
					if (items.length > 0) items[0].focus();
				} else if (e.key === 'Escape') {
					setOpenState(container, false);
				}
			});

			items.forEach((item, index) => {
				item.addEventListener('keydown', function(e: KeyboardEvent) {
					if (e.key === 'ArrowDown') {
						e.preventDefault();
						const nextIndex = (index + 1) % items.length;
						items[nextIndex].focus();
					} else if (e.key === 'ArrowUp') {
						e.preventDefault();
						const prevIndex = (index - 1 + items.length) % items.length;
						items[prevIndex].focus();
					} else if (e.key === 'Escape') {
						setOpenState(container, false);
						trigger.focus();
					}
				});
			});
		});

		// === 点击外部 / 按 ESC 全局关闭所有打开的菜单 ===
		document.addEventListener('click', function(e) {
			dropdowns.forEach((container) => {
				const target = e.target as Node;
				if (!container.contains(target)) {
					setOpenState(container, false);
				}
			});
		});

		document.addEventListener('keydown', function(e) {
			if (e.key === 'Escape') {
				dropdowns.forEach((container) => setOpenState(container, false));
			}
		});

		// === Swup 切页后重新初始化（因为 Navbar / 导航 DOM 会被替换） ===
		if (window.swup && window.swup.hooks) {
			window.swup.hooks.on('content:replace', initDropdownMenus as any);
		} else {
			document.addEventListener('swup:enable', function onceSwup() {
				if (window.swup && window.swup.hooks) {
					window.swup.hooks.on('content:replace', initDropdownMenus as any);
				}
				document.removeEventListener('swup:enable', onceSwup);
			});
		}
	});
</script>