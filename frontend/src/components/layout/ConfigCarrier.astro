---
import { backgroundWallpaper, siteConfig } from "@/config";
---

<!-- 全局配置载体 -->
<div
  id="config-carrier"
  data-hue={siteConfig.themeColor.hue}
  data-wallpaper-mode={backgroundWallpaper.mode}
>
</div>

<script>
  import { loadDynamicConfig } from "@/utils/dynamic-config";

  function applyWallpaperMode(mode: any) {
    const WALLPAPER_BANNER = "banner";
    const WALLPAPER_FULLSCREEN = "fullscreen";
    const WALLPAPER_OVERLAY = "overlay";
    const WALLPAPER_NONE = "none";

    document.documentElement.setAttribute("data-wallpaper-mode", mode);
    const carrier = document.getElementById("config-carrier");
    if (carrier) carrier.setAttribute("data-wallpaper-mode", mode);

    const body = document.body;
    if (mode === WALLPAPER_NONE || mode === WALLPAPER_OVERLAY || mode === WALLPAPER_FULLSCREEN) {
      body.classList.remove("enable-banner");
      body.classList.add("no-banner-layout");
    } else {
      body.classList.add("enable-banner");
      body.classList.remove("no-banner-layout");
    }

    if (mode === WALLPAPER_OVERLAY) {
      body.classList.add("wallpaper-transparent");
    } else {
      body.classList.remove("wallpaper-transparent");
    }
  }

  function applyWallpaperDimOpacity(dimOpacity: any) {
    if (dimOpacity !== undefined && dimOpacity !== null) {
      document.documentElement.style.setProperty("--banner-dim-opacity", String(dimOpacity));
    }
  }

  function applyWallpaperImages(wallpaperConfig: any) {
    if (!wallpaperConfig || !wallpaperConfig.src) return;

    const src = wallpaperConfig.src;
    if (!src.desktop && !src.mobile) return;

    const desktopImgs = document.querySelectorAll('#wallpaper-wrapper img[alt*="banner"], #wallpaper-wrapper img:not([alt])');
    desktopImgs.forEach((img) => {
      const imgEl = img as HTMLImageElement;
      if (typeof src.desktop === "string" && src.desktop) {
        imgEl.src = src.desktop;
      } else if (Array.isArray(src.desktop) && src.desktop.length > 0) {
        imgEl.src = src.desktop[0];
      }
    });

    const mobileImgs = document.querySelectorAll('#wallpaper-wrapper img[alt*="Mobile"]');
    mobileImgs.forEach((img) => {
      const imgEl = img as HTMLImageElement;
      if (typeof src.mobile === "string" && src.mobile) {
        imgEl.src = src.mobile;
      } else if (Array.isArray(src.mobile) && src.mobile.length > 0) {
        imgEl.src = src.mobile[0];
      }
    });
  }

  function applyHomeText(homeText: any) {
    if (!homeText) return;

    const titleEl = document.querySelector(".banner-home-title");
    if (titleEl && homeText.title) {
      titleEl.textContent = homeText.title;
    }

    if (homeText.subtitle) {
      const subtitleArr = Array.isArray(homeText.subtitle)
        ? homeText.subtitle
        : String(homeText.subtitle).split("\n").filter(Boolean);

      const typewriterEl = document.querySelector(".banner-typewriter-text");
      if (typewriterEl && subtitleArr.length > 0) {
        typewriterEl.setAttribute("data-texts", JSON.stringify(subtitleArr));
      }
    }
  }

  function applySidebarWidgetVisibility(sidebarCfg: any) {
    if (!sidebarCfg) return;

    // Widget type -> 对应开关名（后端 sidebar 的 show_xxx）
    const typeToToggle: Record<string, keyof any> = {
      profile: "showProfile",
      categories: "showCategories",
      tags: "showTags",
      recent_posts: "showRecentPosts",
      recent_comments: "showRecentComments",
      tag_cloud: "showTagCloud",
      siteInfo: "showSiteInfo",
      music: "showMusic",
      stats: "showStatistics",
      dynamic: "showDynamics",
    };

    const widgets = document.querySelectorAll<HTMLElement>("[data-widget-type]");
    widgets.forEach((el) => {
      const t = el.getAttribute("data-widget-type") || "";
      const key = typeToToggle[t];
      if (!key) return;
      const show = sidebarCfg[key] !== false; // 未设置则默认显示
      if (show) {
        el.style.removeProperty("display");
        el.dataset.widgetHidden = "false";
      } else {
        el.style.display = "none";
        el.dataset.widgetHidden = "true";
      }
    });

    // 同步 sticky / top / mobile 容器在隐藏全部 widget 后的状态（避免空容器占位）
    const sidebars = ["left-sidebar", "right-sidebar", "bottom-sidebar"];
    sidebars.forEach((id) => {
      const sb = document.getElementById(id);
      if (!sb) return;
      const visibleWidgets = sb.querySelectorAll<HTMLElement>(
        "[data-widget-type][data-widget-hidden='false']:not([data-widget-hidden='true'])",
      );
      const anyVisible = Array.from(sb.querySelectorAll<HTMLElement>("[data-widget-type]")).some(
        (el) => el.dataset.widgetHidden !== "true",
      );
      if (!anyVisible) {
        sb.style.display = "none";
      } else {
        sb.style.removeProperty("display");
      }
      void visibleWidgets;
    });
  }

  async function applyProfileInfo(profileCfg: any) {
    if (!profileCfg) return;
    const w = window as any;
    w.__rosettaProfile = profileCfg;

    const nameEl = document.querySelector<HTMLElement>("[data-profile-name]");
    if (nameEl && profileCfg.name) nameEl.textContent = profileCfg.name;

    const bioEl = document.querySelector<HTMLElement>("[data-profile-bio]");
    if (bioEl && profileCfg.bio) bioEl.textContent = profileCfg.bio;

    // 头像：将 ImageWrapper 内部的 <img> 替换为新的 src（如果有）
    const avatars = document.querySelectorAll<HTMLElement>(".profile-avatar-image");
    avatars.forEach((wrap) => {
      const img = wrap.querySelector("img");
      if (!img) return;
      if (profileCfg.avatar) {
        img.dataset.originalSrc = img.src;
        img.src = profileCfg.avatar;
        img.onerror = () => {
          // 失败回退到占位渐变
          img.onerror = null;
          const ph =
            "data:image/svg+xml;utf8," +
            encodeURIComponent(
              `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200" preserveAspectRatio="xMidYMid slice"><defs><linearGradient id="g" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#e0e7ff"/><stop offset="50%" stop-color="#c7d2fe"/><stop offset="100%" stop-color="#a5b4fc"/></linearGradient></defs><rect width="200" height="200" fill="url(#g)"/><g fill="rgba(99,102,241,0.22)" transform="translate(100,100)"><circle r="46"/><circle cy="-18" r="20" fill="rgba(99,102,241,0.35)"/><path d="M -38 32 Q 0 10 38 32 L 38 58 L -38 58 Z" fill="rgba(99,102,241,0.35)"/></g></svg>`,
            );
          img.src = ph;
          img.style.opacity = "1";
        };
      }
      img.style.opacity = "1";
    });

    // 社交链接（可选地替换内容：如果 links 数组有内容则重建）
    const linksWrap = document.querySelector<HTMLElement>("[data-profile-links]");
    if (linksWrap && Array.isArray(profileCfg.links) && profileCfg.links.length > 0) {
      // 只替换一次，避免 SSR 渲染空节点后闪烁
      if (linksWrap.dataset.applied === "1") return;
      linksWrap.dataset.applied = "1";
    }
  }

  async function applyDynamicConfig() {
    try {
      const config = await loadDynamicConfig();

      applyWallpaperMode(config.wallpaper.mode);
      applyWallpaperDimOpacity(config.wallpaper.common?.dimOpacity);
      applyWallpaperImages(config.wallpaper);
      applyHomeText(config.wallpaper.common?.homeText);
      await applyProfileInfo(config.profile);

      // 应用侧边栏卡片开关
      applySidebarWidgetVisibility(config.sidebar);

      if (config.site.primaryColor) {
        // ===== WCAG AA 4.5:1 对比度强制修复 =====
        // 后端 API 传入的 primaryColor 常常是 oklch(0.70 0.14 250) = #3B82F6，
        // 在 #fff 白底上对比度仅 3.67，不满足 WCAG AA Normal Text 4.5:1。
        // 修复策略：先写入后端值，然后立即与黑色 18% 混合（sRGB gamma 空间足够接近视觉效果），
        // 这样品牌色的 hue/chroma 保留，但 L 值下降 ~18%，#3B82F6 → ~#1E55C0 对比度 5.3+ 达标。
        document.documentElement.style.setProperty("--primary", config.site.primaryColor);
        try {
          const raw = getComputedStyle(document.documentElement).getPropertyValue("--primary").trim();
          if (raw) {
            const probe = document.createElement('div');
            probe.style.display = 'none';
            probe.style.color = `color-mix(in srgb, ${raw} 82%, black 18%)`;
            document.documentElement.appendChild(probe);
            const mixed = getComputedStyle(probe).color;
            document.documentElement.removeChild(probe);
            if (mixed) document.documentElement.style.setProperty("--primary", mixed);
          }
        } catch (_) { /* 旧浏览器不支持 color-mix 就保留后端原色，失败安全 */ }
      }

      if (config.site.title) {
        document.title = document.title.replace(/^[^-]*—\s*/, "").replace(/^[^-]*-\s*/, "");
      }

      (window as any).__rosettaConfig = config;

      const musicMgr = (window as any).__ROSETTAMusic;
      if (musicMgr && typeof musicMgr.reloadWithConfig === "function") {
        try {
          musicMgr.reloadWithConfig();
        } catch (e) {
          console.warn("[ConfigCarrier] Failed to reload music config:", e);
        }
      }

      window.dispatchEvent(new CustomEvent("rosetta:config-loaded", { detail: config }));
    } catch (e) {
      console.warn("[ConfigCarrier] Failed to apply dynamic config:", e);
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", applyDynamicConfig);
  } else {
    applyDynamicConfig();
  }
</script>
