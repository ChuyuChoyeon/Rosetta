---
import { Icon } from "astro-icon/components";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";

interface Props {
	id: string;
	name?: string;
	/** 如果提供，会在 widget-name 上写入 data-i18n-text-key，客户端切语言时同步刷新 */
	nameI18nKey?: I18nKey;
	showTitle?: boolean;
	isCollapsed?: boolean;
	collapsedHeight?: string;
	useExpandedButtonSpacing?: boolean;
	contentPadding?: boolean;
	moreUrl?: string;
	class?: string;
	style?: string;
}
const {
	id,
	name,
	nameI18nKey,
	showTitle = true,
	isCollapsed,
	collapsedHeight,
	useExpandedButtonSpacing = false,
	contentPadding = true,
	moreUrl,
	style,
} = Astro.props;
const className = Astro.props.class;
---
<widget-layout
    data-id={id}
    data-is-collapsed={String(isCollapsed)}
    data-use-expanded-button-spacing={String(useExpandedButtonSpacing)}
    class:list={["card-base", {"pb-4": contentPadding}, className]}
    style={style}
>
    {name && showTitle && (
        <div class="widget-title font-bold transition text-lg text-neutral-900 dark:text-neutral-100 mt-4 mb-2 flex items-center justify-between px-4">
            <span
                class="widget-name"
                data-i18n-text-key={nameI18nKey}
            >{name}</span>
            <slot name="title-icon" />
        </div>
    )}
    <div id={id} class:list={["collapse-wrapper overflow-hidden", {"px-4": contentPadding, "collapsed": isCollapsed, "pt-4": contentPadding && (!name || !showTitle)}]}>
        <slot></slot>
    </div>
    {isCollapsed && <div class="expand-btn px-4 -mb-2">
        {moreUrl ? (
            <a
                href={moreUrl}
                class="btn-plain rounded-lg w-full h-9 flex items-center justify-center"
                title={i18n(I18nKey.more)}
                data-i18n-title-key="more"
            >
                <div class="text-(--primary) flex items-center justify-center gap-2 -translate-x-2">
                    <Icon is:inline name="material-symbols:more-horiz" class="text-[1.75rem]" aria-hidden="true"></Icon>
                    <span data-i18n-text-key="more">{i18n(I18nKey.more)}</span>
                </div>
            </a>
        ) : (
            <button
                class="btn-plain rounded-lg w-full h-9"
                title={i18n(I18nKey.more)}
                aria-label={i18n(I18nKey.more)}
                data-show-more={i18n(I18nKey.more)}
                data-show-less={i18n(I18nKey.collapse)}
                data-expanded="false"
                data-i18n-title-key="more"
                data-i18n-aria-key="more"
                data-i18n-more-key="more"
                data-i18n-less-key="collapse"
            >
                <div class="text-(--primary) flex items-center justify-center gap-2 -translate-x-2">
                    <Icon is:inline name="material-symbols:more-horiz" class="toggle-icon-more text-[1.75rem]" aria-hidden="true"></Icon>
                    <Icon is:inline name="material-symbols:keyboard-arrow-up-rounded" class="toggle-icon-less hidden text-[1.75rem]" aria-hidden="true"></Icon>
                    <span class="toggle-text" data-i18n-text-key="more">{i18n(I18nKey.more)}</span>
                </div>
            </button>
        )}
    </div>}
</widget-layout>

<style define:vars={{ collapsedHeight }}>
    /*
     * 显式声明 widget-layout 的默认盒模型（自定义元素默认 display: inline，
     * 会导致 tailwind 的 block/flex 布局样式失效）。
     *
     * 注意：必须以 `:not(.hidden)` 为前置条件，否则选择器特异性会覆盖
     * Tailwind 的 `.hidden { display: none }` 工具类，导致首页 TOC / 公告等
     * 通过 `.hidden` 隐藏的侧边栏组件仍然可见（scoped 样式等价于带
     * `[data-astro-cid-*]` 属性选择器，特异性略高于 Tailwind utilities）。
     */
    widget-layout:not(.hidden) {
        display: block;
    }
    .collapsed {
        height: var(--collapsedHeight);
    }

    widget-layout[data-is-collapsed="true"][data-expanded="true"][data-use-expanded-button-spacing="true"] .expand-btn {
        padding-top: 0.5rem;
    }
</style>

<script>
    class WidgetLayout extends HTMLElement {
        constructor() {
            super();

            if (this.dataset.isCollapsed !== "true")
                return;

            this.dataset.expanded = 'false';

            const id = this.dataset.id;
            const btn = this.querySelector('.expand-btn button') as HTMLButtonElement | null;
            const wrapper = this.querySelector(`#${id}`)

            if (!btn || !wrapper)
                return;

            const text = btn.querySelector('.toggle-text');
            const moreIcon = btn.querySelector('.toggle-icon-more');
            const lessIcon = btn.querySelector('.toggle-icon-less');
            const updateButtonState = (expanded: boolean) => {
                const label = expanded
                    ? btn.dataset.showLess || ''
                    : btn.dataset.showMore || '';

                btn.dataset.expanded = String(expanded);
                this.dataset.expanded = String(expanded);
                btn.title = label;
                btn.setAttribute('aria-label', label);
                if (text)
                    text.textContent = label;
                moreIcon?.classList.toggle('hidden', expanded);
                lessIcon?.classList.toggle('hidden', !expanded);
            };

            btn.addEventListener('click', () => {
                const expanded = btn.dataset.expanded === 'true';
                wrapper.classList.toggle('collapsed', expanded);
                updateButtonState(!expanded);
            });
        }
    }

    if (!customElements.get("widget-layout")) {
        customElements.define("widget-layout", WidgetLayout);
    }
</script>
