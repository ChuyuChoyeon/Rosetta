---
interface Props {
	size?: string;
	dot?: boolean;
	href?: string;
	label?: string;
	color?: string;
}
const { dot, href, label, color }: Props = Astro.props;

function buildTagStyle(color?: string): string | undefined {
	if (!color) return undefined;
	// Accept named tokens like "primary"/"success" or a hex/rgb value
	// 统一使用「低饱和淡背景 + 原色文字（深浅自动适配）」的极简风格
	const named = new Map<
		string,
		{ bg: string; fg: string; hoverBg: string; hoverFg: string }
	>([
		[
			"primary",
			{
				bg: "oklch(97% 0.02 var(--hue))",
				fg: "oklch(52% 0.14 var(--hue))",
				hoverBg: "oklch(94% 0.032 var(--hue))",
				hoverFg: "oklch(46% 0.15 var(--hue))",
			},
		],
		[
			"success",
			{
				bg: "oklch(96.5% 0.025 155)",
				fg: "oklch(48% 0.14 155)",
				hoverBg: "oklch(93% 0.035 155)",
				hoverFg: "oklch(42% 0.15 155)",
			},
		],
		[
			"warning",
			{
				bg: "oklch(96% 0.035 75)",
				fg: "oklch(52% 0.15 55)",
				hoverBg: "oklch(93% 0.05 70)",
				hoverFg: "oklch(46% 0.16 50)",
			},
		],
		[
			"danger",
			{
				bg: "oklch(96% 0.03 25)",
				fg: "oklch(52% 0.17 25)",
				hoverBg: "oklch(93% 0.04 25)",
				hoverFg: "oklch(46% 0.18 25)",
			},
		],
		[
			"info",
			{
				bg: "oklch(96.5% 0.025 255)",
				fg: "oklch(52% 0.15 255)",
				hoverBg: "oklch(93% 0.035 255)",
				hoverFg: "oklch(46% 0.16 255)",
			},
		],
	]);
	if (named.has(color)) {
		const v = named.get(color)!;
		return `--tag-bg: ${v.bg}; --tag-fg: ${v.fg}; --tag-hover-bg: ${v.hoverBg}; --tag-hover-fg: ${v.hoverFg};`;
	}
	// 自定义颜色 - 极简风格：
	// 背景：极淡（90% 白 + 10% 原色），避免饱和色块
	// 文字：原色（在亮背景上对比度自然足够）
	// hover：背景稍加深，文字微微加深（不做 font-weight 抖动、不位移、不加阴影）
	return `--tag-bg: color-mix(in srgb, ${color} 10%, white 90%); --tag-fg: ${color}; --tag-hover-bg: color-mix(in srgb, ${color} 16%, white 84%); --tag-hover-fg: color-mix(in srgb, ${color} 88%, black 12%); --tag-base-color: ${color};`;
}
const tagStyle = buildTagStyle(color);
---
<a href={href} aria-label={label}
	class:list={[
		"tag-chip",
		{ "tag-chip--custom": !!color, "tag-chip--dot": !!dot }
	]}
	style={tagStyle}
>
	{dot && <span class="tag-chip__dot"></span>}
	<slot></slot>
</a>

<style is:global>
	.tag-chip {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		padding: 0.35rem 0.85rem;
		border-radius: 9999px;
		/* 字号、字重：克制不夸张 */
		font-size: 0.85rem;
		font-weight: 500;
		line-height: 1.3;
		/* 只过渡颜色，不过渡 transform / font-weight，避免抖动 */
		transition: background-color 0.18s ease, color 0.18s ease;
		/* 淡背景 + 原色文字 */
		background-color: var(--tag-bg, oklch(97% 0.012 var(--hue)));
		color: var(--tag-fg, oklch(52% 0.12 var(--hue)));
		text-decoration: none;
		/* 无边框（彻底去掉描边感）；若要极淡分隔用 0.5px 但透明度要低 */
		border: none;
	}
	.tag-chip:hover {
		background-color: var(--tag-hover-bg, oklch(94% 0.024 var(--hue)));
		color: var(--tag-hover-fg, oklch(45% 0.13 var(--hue)));
		/* hover 不位移、不加粗、不加阴影 */
	}
	.tag-chip:active {
		/* active 只做轻微背景加深，不回弹 transform */
		background-color: var(--tag-bg, oklch(97% 0.012 var(--hue)));
		filter: brightness(0.96);
	}

	/* 暗色模式：对应调整淡底 + 亮色文字，保持极简不刺眼 */
	:root.dark .tag-chip {
		background-color: color-mix(in oklch,
			var(--tag-bg, oklch(28% 0.02 var(--hue))) 100%,
			oklch(22% 0.01 250) 0%);
		/* 暗色模式：默认的 --tag-fg 在自定义时传的是原色（亮度过低），这里覆盖提升亮度 */
		color: var(--tag-fg, oklch(80% 0.07 var(--hue)));
	}
	:root.dark .tag-chip:hover {
		background-color: var(--tag-hover-bg, oklch(33% 0.03 var(--hue)));
		color: var(--tag-hover-fg, oklch(88% 0.08 var(--hue)));
	}

	/* 自定义颜色在暗色模式下：把传进来的原始色提高明度再用 */
	:root.dark .tag-chip.tag-chip--custom {
		background-color: color-mix(in oklch,
			var(--tag-base-color, oklch(60% 0.15 250)) 22%,
			oklch(22% 0.01 250) 78%);
		color: color-mix(in oklch,
			var(--tag-base-color, oklch(60% 0.15 250)) 72%,
			white 28%);
	}
	:root.dark .tag-chip.tag-chip--custom:hover {
		background-color: color-mix(in oklch,
			var(--tag-base-color, oklch(60% 0.15 250)) 32%,
			oklch(18% 0.01 250) 68%);
		color: color-mix(in oklch,
			var(--tag-base-color, oklch(60% 0.15 250)) 85%,
			white 15%);
	}

	/* tag 前的小圆点（可选）：用当前色，保持和谐不突兀 */
	.tag-chip__dot {
		width: 0.32rem;
		height: 0.32rem;
		border-radius: 9999px;
		background-color: currentColor;
		opacity: 0.78;
	}
</style>
