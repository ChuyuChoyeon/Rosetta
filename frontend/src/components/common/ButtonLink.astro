---
import { Icon } from "astro-icon/components";

interface Props {
	badge?: string;
	url?: string;
	label?: string;
	color?: string;
	icon?: string;
}
const { badge, url, label, color, icon } = Astro.props;

function badgeStyle(color?: string): string | undefined {
	if (!color) return undefined;
	// 极简风格：淡底 + 原色文字，彻底去掉描边与厚重感
	const named = new Map<string, string>([
		[
			"primary",
			"--badge-bg: oklch(97% 0.02 var(--hue)); --badge-fg: oklch(52% 0.14 var(--hue));",
		],
		[
			"success",
			"--badge-bg: oklch(96.5% 0.025 155); --badge-fg: oklch(48% 0.14 155);",
		],
		[
			"warning",
			"--badge-bg: oklch(96% 0.035 75); --badge-fg: oklch(52% 0.15 55);",
		],
		[
			"danger",
			"--badge-bg: oklch(96% 0.03 25); --badge-fg: oklch(52% 0.17 25);",
		],
		[
			"info",
			"--badge-bg: oklch(96.5% 0.025 255); --badge-fg: oklch(52% 0.15 255);",
		],
	]);
	if (named.has(color)) return named.get(color)!;
	// 自定义颜色：极低饱和背景 + 原色文字
	return `--badge-bg: color-mix(in srgb, ${color} 10%, white 90%); --badge-fg: ${color}; --badge-base-color: ${color};`;
}
const computedBadgeStyle = badgeStyle(color);

function rowStyle(color?: string): string | undefined {
	if (!color) return undefined;
	const named = new Map<string, string>([
		["primary", "--row-accent: var(--primary);"],
		["success", "--row-accent: rgb(5 150 105);"],
		["warning", "--row-accent: rgb(202 138 4);"],
		["danger", "--row-accent: rgb(220 38 38);"],
		["info", "--row-accent: rgb(37 99 235);"],
	]);
	if (named.has(color)) return named.get(color)!;
	return `--row-accent: ${color};`;
}
const computedRowStyle = rowStyle(color);
---
<a href={url} aria-label={label} class="btn-link-row" style={computedRowStyle}>
    <button
        class:list={`
            w-full
            h-10
            rounded-lg
            bg-none
            hover:bg-(--btn-plain-bg-hover)
            active:bg-(--btn-plain-bg-active)
            transition-all
            pl-2
            hover:pl-3

            text-neutral-700
            dark:text-neutral-300
        `}
        style={computedRowStyle}
    >
        <div class="flex items-center justify-between relative mr-2">
            <div class="overflow-hidden text-left whitespace-nowrap text-ellipsis inline-flex items-center gap-2">
                {icon && <Icon is:inline name={icon} class="text-[1rem] text-[color:var(--row-accent,var(--primary))]" aria-hidden="true"></Icon>}
                <span>{icon ? null : null}</span>
                <slot></slot>
            </div>
            { badge !== undefined && badge !== null && badge !== '' &&
                <div
                    class="btn-link-badge"
                    style={computedBadgeStyle}
                >
                    { badge }
                </div>
            }
        </div>
    </button>
</a>

<style>
    .btn-link-row button:hover,
    .btn-link-row button:active {
        color: var(--row-accent, var(--primary));
    }
    .btn-link-row button {
        position: relative;
    }
    .btn-link-row button::before {
        content: "";
        position: absolute;
        left: 0.65rem;
        top: 50%;
        width: 0.15rem;
        height: 0;
        border-radius: 9999px;
        transform: translateY(-50%);
        background: var(--row-accent, var(--primary));
        opacity: 0.8;
        transition: height 0.2s ease, opacity 0.2s ease;
    }
    .btn-link-row:hover button::before {
        height: 1.25rem;
    }
    .btn-link-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0 0.5rem;
        min-width: 1.75rem;
        height: 1.5rem;
        margin-left: 0.5rem;
        border-radius: 9999px;
        font-size: 0.78rem;
        font-weight: 500;
        line-height: 1;
        /* 只过渡颜色，不移位、不加粗、不描边 */
        transition: background-color 0.18s ease, color 0.18s ease;
        background: var(--badge-bg, oklch(97% 0.012 var(--hue)));
        color: var(--badge-fg, var(--btn-content));
        border: none;
    }
    :root.dark .btn-link-badge {
        background: color-mix(in oklch,
            var(--badge-base-color, var(--primary)) 20%,
            oklch(22% 0.01 250) 80%);
        color: color-mix(in oklch,
            var(--badge-base-color, var(--primary)) 72%,
            white 28%);
    }
    .btn-link-row:hover .btn-link-badge {
        /* 仅加深背景，无 transform 位移 */
        filter: brightness(0.97);
    }
</style>
