---
import { Image, Picture } from "astro:assets";
import * as path from "node:path";
import type { ImageMetadata } from "astro";
import type { ImageFormat, ResponsiveImageLayout } from "@/types/config";
import {
	getFallbackFormat,
	getImageFormats,
	getImageQuality,
	shouldAddNoReferrer,
} from "@/utils/image-utils";
import { getLqipProps } from "@/utils/lqip-utils";
import { url } from "@/utils/url-utils";

interface Props {
	id?: string;
	src: string;
	class?: string;
	alt?: string;
	position?: string;
	basePath?: string;
	loading?: "lazy" | "eager";
	fetchpriority?: "high" | "low" | "auto";
	// 响应式图像属性
	layout?: ResponsiveImageLayout;
	usePicture?: boolean;
	formats?: ImageFormat[];
	width?: number;
	height?: number;
	widths?: number[];
	sizes?: string;
	quality?: number;
	fadeIn?: boolean;
	dataCoverImg?: boolean;
	showLqip?: boolean;
	showOverlay?: boolean;
	/** 当 src 为空或加载失败时，显示渐变占位图（一般用于头像/封面等后台可上传的图片） */
	fallbackPlaceholder?: boolean;
}

const {
	id,
	src,
	alt,
	position = "center",
	basePath = "/",
	loading = "lazy",
	fetchpriority = "auto",
	layout = "constrained",
	usePicture = true,
	formats = getImageFormats(),
	width,
	height,
	widths,
	sizes,
	quality = getImageQuality(),
	fadeIn = true,
	dataCoverImg = false,
	showLqip = true,
	showOverlay = true,
	fallbackPlaceholder = false,
} = Astro.props;

const fallbackFormat = getFallbackFormat();
const className = Astro.props.class;

const hasSrc = typeof src === "string" && src.length > 0;
const isLocal =
	hasSrc &&
	!(
		src.startsWith("/") ||
		src.startsWith("http") ||
		src.startsWith("https") ||
		src.startsWith("data:")
	);
const isPublic = hasSrc && src.startsWith("/");

// 空 src 占位 SVG（Notion 风格：极简线条人物 + 柔和几何背景）
// 设计参考：Notion Avatar Maker (CC0) — 简洁线条、淡雅渐变、几何装饰点缀
const placeholderSvg =
	"data:image/svg+xml;utf8," +
	encodeURIComponent(`
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200" preserveAspectRatio="xMidYMid slice">
  <defs>
    <!-- 柔和多色渐变背景（灵感自 Notion / Boring Avatars 的 Bauhaus 几何风） -->
    <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#f6f7fb"/>
      <stop offset="55%" stop-color="#f0e7db"/>
      <stop offset="100%" stop-color="#e6dace"/>
    </linearGradient>
    <!-- 人物轮廓用的暖肤色渐变 -->
    <radialGradient id="skin" cx="50%" cy="38%" r="58%">
      <stop offset="0%" stop-color="#fff8f2"/>
      <stop offset="100%" stop-color="#f1d6bd"/>
    </radialGradient>
    <!-- 头发与衣领的配色 -->
    <linearGradient id="hair" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#7a5c49"/>
      <stop offset="100%" stop-color="#5d4434"/>
    </linearGradient>
    <linearGradient id="shirt" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#a8c7e6"/>
      <stop offset="100%" stop-color="#7fa8cf"/>
    </linearGradient>
    <!-- 柔和投影 -->
    <filter id="soft" x="-40%" y="-40%" width="180%" height="180%">
      <feDropShadow dx="0" dy="2" stdDeviation="2.2" flood-color="#6b4b2a" flood-opacity=".14"/>
    </filter>
  </defs>

  <!-- 背景填充 -->
  <rect width="200" height="200" fill="url(#bg)"/>

  <!-- 背景几何装饰（Notion / Bauhaus 风格：淡色圆形、方块、线条） -->
  <circle cx="26" cy="32" r="18" fill="#c7b8ff" opacity=".28"/>
  <rect x="156" y="22" width="24" height="24" rx="6" fill="#ffb4a2" opacity=".32"/>
  <circle cx="176" cy="174" r="22" fill="#a0e7c9" opacity=".28"/>
  <rect x="14" y="154" width="20" height="20" rx="5" fill="#ffd59e" opacity=".36"/>
  <path d="M0 110 Q50 98 100 112 T200 108" stroke="#d9c7a9" stroke-width="1.5" fill="none" opacity=".35"/>
  <path d="M70 0 Q90 40 130 60 T200 150" stroke="#cfbfdc" stroke-width="1.4" fill="none" opacity=".28"/>

  <!-- 人物主体：Notion 极简线条风（居中 + 柔和投影） -->
  <g filter="url(#soft)">
    <!-- 衣领（简洁 V 领衬衫） -->
    <path d="M54 168 L78 138 Q100 148 122 138 L146 168 Z" fill="url(#shirt)"/>
    <path d="M100 146 L100 158" stroke="#5e87ad" stroke-width="1.6" stroke-linecap="round" opacity=".7"/>
    <path d="M78 138 L88 146" stroke="#5e87ad" stroke-width="1.4" stroke-linecap="round" opacity=".55"/>
    <path d="M122 138 L112 146" stroke="#5e87ad" stroke-width="1.4" stroke-linecap="round" opacity=".55"/>

    <!-- 脖子 -->
    <rect x="92" y="120" width="16" height="22" rx="5" fill="url(#skin)"/>

    <!-- 头部（椭圆脸） -->
    <ellipse cx="100" cy="94" rx="34" ry="38" fill="url(#skin)"/>

    <!-- 头发：短碎发造型（Notion 头像感） -->
    <path d="M66 88 Q62 56 88 46 Q110 36 132 50 Q142 62 138 88 Q130 72 112 70 Q100 70 88 78 Q76 84 66 88 Z" fill="url(#hair)"/>
    <path d="M74 76 Q82 66 96 68" stroke="#4a3527" stroke-width="1.2" fill="none" opacity=".4"/>

    <!-- 眉毛（简洁两道弧线） -->
    <path d="M82 86 Q87 82 92 86" stroke="#5a402e" stroke-width="1.8" stroke-linecap="round" fill="none"/>
    <path d="M108 86 Q113 82 118 86" stroke="#5a402e" stroke-width="1.8" stroke-linecap="round" fill="none"/>

    <!-- 眼睛（简洁小圆 + 高光） -->
    <circle cx="87" cy="96" r="2.8" fill="#3a2a1c"/>
    <circle cx="113" cy="96" r="2.8" fill="#3a2a1c"/>
    <circle cx="86.2" cy="95.2" r=".9" fill="#fff" opacity=".85"/>
    <circle cx="112.2" cy="95.2" r=".9" fill="#fff" opacity=".85"/>

    <!-- 鼻子（简约线条） -->
    <path d="M100 100 Q99 108 102 112" stroke="#a67960" stroke-width="1.5" stroke-linecap="round" fill="none" opacity=".75"/>

    <!-- 嘴巴（淡微笑线） -->
    <path d="M92 118 Q100 124 108 118" stroke="#c4726b" stroke-width="2" stroke-linecap="round" fill="none"/>
    <!-- 嘴内阴影，增加立体感 -->
    <path d="M94 119 Q100 123 106 119" stroke="#e89a90" stroke-width="1.2" stroke-linecap="round" fill="none" opacity=".6"/>

    <!-- 腮红（淡淡两团） -->
    <circle cx="78" cy="108" r="4.5" fill="#f5b5a8" opacity=".38"/>
    <circle cx="122" cy="108" r="4.5" fill="#f5b5a8" opacity=".38"/>
  </g>

  <!-- 前景轻微噪点/柔光（让 SVG 更细腻不生硬） -->
  <rect width="200" height="200" fill="url(#bg)" opacity=".04"/>
</svg>`);

// TODO temporary workaround for images dynamic import
// https://github.com/withastro/astro/issues/3373
let img: ImageMetadata | null = null;
if (isLocal) {
	const files = import.meta.glob<ImageMetadata>(
		"../../**/*.{png,jpg,jpeg,webp,avif}",
		{
			import: "default",
		},
	);
	let normalizedPath = path
		.normalize(path.join("../../", basePath, src))
		.replace(/\\/g, "/");
	const file = files[normalizedPath];
	if (!file) {
		console.error(
			`\n[ERROR] Image file not found: ${normalizedPath.replace("../../", "src/")}`,
		);
	} else {
		img = await file();
	}
}

const imageClass = fadeIn
	? "w-full h-full object-cover opacity-0 transition-opacity duration-500 ease-out"
	: "w-full h-full object-cover";
const imageStyle = `object-position: ${position}`;

// 检查是否需要添加 referrerpolicy（仅对非本地图片）
const fullSrc = hasSrc
	? isPublic
		? url(src)
		: src
	: fallbackPlaceholder
		? placeholderSvg
		: "";
const referrerPolicy =
	hasSrc && !isLocal && shouldAddNoReferrer(fullSrc)
		? "no-referrer"
		: undefined;

// 构建响应式图像属性
const responsiveProps = {
	...(layout && { layout }),
	...(width && { width }),
	...(height && { height }),
	...(widths && { widths }),
	...(sizes && { sizes }),
	...(quality && { quality }),
};

// LQIP 渐变占位
const lqipProps =
	hasSrc && isLocal
		? getLqipProps(src, basePath)
		: hasSrc && isPublic
			? getLqipProps(src, basePath, true)
			: fallbackPlaceholder
				? {
						style:
							"background: linear-gradient(135deg,#e0e7ff 0%,#a5b4fc 100%);",
					}
				: getLqipProps("");
---
<div id={id} class:list={[className, 'overflow-hidden relative']} data-fallback-placeholder={fallbackPlaceholder || undefined}>
    {fadeIn && showLqip && <div class="lqip-placeholder absolute inset-0 pointer-events-none" style={lqipProps.style} aria-hidden="true"></div>}
    {showOverlay && <div class="transition absolute inset-0 dark:bg-black/10 pointer-events-none"></div>}
    {!hasSrc && fallbackPlaceholder && (
        <img
            src={placeholderSvg}
            alt={alt || ""}
            class={imageClass}
            style={imageStyle}
            loading={loading}
            fetchpriority={fetchpriority}
            data-cover-img={dataCoverImg ? true : undefined}
            onerror="(function(e){var t=(e&&e.currentTarget)||this;t.style.opacity='1';t.onerror=null;})(event)"
            onload="(function(e){var t=(e&&e.currentTarget)||this;t.style.opacity='1';})(event)"
        />
    )}
    {hasSrc && isLocal && img && usePicture && (
        <Picture
            src={img}
            alt={alt || ""}
            class={imageClass}
            style={imageStyle}
            loading={loading}
            fetchpriority={fetchpriority}
            data-cover-img={dataCoverImg ? true : undefined}
            formats={formats}
            fallbackFormat={fallbackFormat}
            {...responsiveProps}
        />
    )}
    {hasSrc && isLocal && img && !usePicture && (
        <Image
            src={img}
            alt={alt || ""}
            class={imageClass}
            style={imageStyle}
            loading={loading}
            fetchpriority={fetchpriority}
            data-cover-img={dataCoverImg ? true : undefined}
            {...responsiveProps}
        />
    )}
    {hasSrc && !isLocal && (
        <img
            src={fullSrc}
            alt={alt || ""}
            class={imageClass}
            style={imageStyle}
            loading={loading}
            fetchpriority={fetchpriority}
            data-cover-img={dataCoverImg ? true : undefined}
            referrerpolicy={referrerPolicy}
            onerror={fallbackPlaceholder ? `((e)=>{const t=e.currentTarget||this;t.onerror=null;t.src='${placeholderSvg}';setTimeout(()=>{t.style.opacity='1';},0);})(event)` : undefined}
        />
    )}
</div>
