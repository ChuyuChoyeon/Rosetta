	"fontFamily": {
		"sans": {
			"$value": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif",
			"$type": "fontFamily",
			"$description": "Ant Design 标准无衬线字体栈"
		},
		"mono": {
			"$value": "'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, Courier, monospace",
			"$type": "fontFamily"
		}
	},
	"fontSize": {
		"h1": { "$value": "38px", "$type": "dimension" },
		"h2": { "$value": "30px", "$type": "dimension" },
		"h3": { "$value": "24px", "$type": "dimension" },
		"h4": { "$value": "20px", "$type": "dimension" },
		"lg": { "$value": "16px", "$type": "dimension" },
		"md": {
			"$value": "14px",
			"$type": "dimension",
			"$description": "默认字号"
		},
		"sm": { "$value": "12px", "$type": "dimension" }
	},
	"lineHeight": {
		"md": { "$value": 1.5714, "$type": "number", "$description": "14/22 行高" },
		"lg": { "$value": 1.5, "$type": "number" }
	},
	"spacing": {
		"xxs": { "$value": "4px", "$type": "dimension" },
		"xs": { "$value": "8px", "$type": "dimension" },
		"sm": { "$value": "12px", "$type": "dimension" },
		"md": {
			"$value": "16px",
			"$type": "dimension",
			"$description": "基准间距"
		},
		"lg": { "$value": "20px", "$type": "dimension" },
		"xl": { "$value": "24px", "$type": "dimension" },
		"2xl": { "$value": "32px", "$type": "dimension" },
		"3xl": { "$value": "48px", "$type": "dimension" }
	},
	"borderRadius": {
		"xs": { "$value": "2px", "$type": "dimension" },
		"sm": {
			"$value": "4px",
			"$type": "dimension",
			"$description": "Ant Design 默认圆角"
		},
		"md": { "$value": "6px", "$type": "dimension" },
		"lg": { "$value": "8px", "$type": "dimension" },
		"xl": { "$value": "16px", "$type": "dimension" },
		"full": { "$value": "9999px", "$type": "dimension" }
	},
	"boxShadow": {
		"xs": {
			"$value": "0 1px 2px 0 rgba(0, 0, 0, 0.03)",
			"$type": "shadow"
		},
		"sm": {
			"$value": "0 1px 2px 0 rgba(0, 0, 0, 0.03), 0 1px 6px -1px rgba(0, 0, 0, 0.02), 0 2px 4px 0 rgba(0, 0, 0, 0.02)",
			"$type": "shadow"
		},
		"md": {
			"$value": "0 4px 16px 0 rgba(0, 0, 0, 0.08), 0 2px 4px -2px rgba(0, 0, 0, 0.06)",
			"$type": "shadow",
			"$description": "默认卡片/浮层阴影"
		},
		"lg": {
			"$value": "0 6px 24px 0 rgba(0, 0, 0, 0.12), 0 3px 6px -4px rgba(0, 0, 0, 0.06)",
			"$type": "shadow",
			"$description": "下拉/抽屉阴影"
		},
		"xl": {
			"$value": "0 12px 40px 0 rgba(0, 0, 0, 0.16), 0 6px 12px -8px rgba(0, 0, 0, 0.08)",
			"$type": "shadow"
		}
	},
	"motion": {
		"easeOut": {
			"$value": "cubic-bezier(0.215, 0.61, 0.355, 1)",
			"$type": "other"
		},
		"easeInOut": {
			"$value": "cubic-bezier(0.645, 0.045, 0.355, 1)",
			"$type": "other"
		},
		"durationFast": { "$value": "100ms", "$type": "duration" },
		"durationMid": {
			"$value": "200ms",
			"$type": "duration",
			"$description": "默认过渡时长"
		},
		"durationSlow": { "$value": "300ms", "$type": "duration" }
	}
}
