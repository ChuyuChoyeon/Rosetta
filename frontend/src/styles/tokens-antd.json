{
	"color": {
		"primary": {
			"50": {
				"$value": "#e6f4ff",
				"$type": "color",
				"$description": "主色最浅（悬浮背景）"
			},
			"100": {
				"$value": "#bae0ff",
				"$type": "color",
				"$description": "主色浅"
			},
			"200": { "$value": "#91caff", "$type": "color" },
			"300": { "$value": "#69b1ff", "$type": "color" },
