				"$value": "#4096ff",
				"$type": "color",
				"$description": "主色悬浮"
			},
			"500": {
				"$value": "#1677ff",
				"$type": "color",
				"$description": "品牌主色（Ant Design Blue）"
			},
			"600": {
				"$value": "#0958d9",
				"$type": "color",
				"$description": "主色按下"
			},
			"700": { "$value": "#003eb3", "$type": "color" },
			"800": { "$value": "#002c8c", "$type": "color" },
			"900": { "$value": "#001d66", "$type": "color" }
		},
		"success": {
			"500": {
				"$value": "#52c41a",
				"$type": "color",
				"$description": "成功色"
			},
			"600": { "$value": "#389e0d", "$type": "color" },
			"100": { "$value": "#d9f7be", "$type": "color" },
			"50": { "$value": "#f6ffed", "$type": "color" }
		},
		"warning": {
			"500": {
				"$value": "#faad14",
				"$type": "color",
				"$description": "警告色"
			},
			"600": { "$value": "#d48806", "$type": "color" },
			"100": { "$value": "#ffe7ba", "$type": "color" },
			"50": { "$value": "#fffbe6", "$type": "color" }
		},
		"error": {
			"500": {
				"$value": "#ff4d4f",
				"$type": "color",
				"$description": "错误/危险色"
			},
			"600": { "$value": "#cf1322", "$type": "color" },
			"100": { "$value": "#ffa39e", "$type": "color" },
			"50": { "$value": "#fff2f0", "$type": "color" }
		},
		"info": {
			"500": {
				"$value": "#1677ff",
				"$type": "color",
				"$description": "信息色（同主色）"
			},
			"50": { "$value": "#e6f4ff", "$type": "color" }
		},
		"neutral": {
			"text": {
				"primary": { "$value": "rgba(0, 0, 0, 0.88)", "$type": "color" },
				"secondary": { "$value": "rgba(0, 0, 0, 0.65)", "$type": "color" },
				"tertiary": { "$value": "rgba(0, 0, 0, 0.45)", "$type": "color" },
				"quaternary": { "$value": "rgba(0, 0, 0, 0.25)", "$type": "color" }
			},
			"fill": {
				"default": { "$value": "rgba(0, 0, 0, 0.15)", "$type": "color" },
				"hover": { "$value": "rgba(0, 0, 0, 0.06)", "$type": "color" },
				"active": { "$value": "rgba(0, 0, 0, 0.09)", "$type": "color" },
				"quaternary": { "$value": "rgba(0, 0, 0, 0.04)", "$type": "color" }
			},
			"border": {
				"default": { "$value": "#d9d9d9", "$type": "color" },
				"secondary": { "$value": "#f0f0f0", "$type": "color" }
			},
			"bg": {
				"container": { "$value": "#ffffff", "$type": "color" },
				"elevated": { "$value": "#ffffff", "$type": "color" },
				"layout": { "$value": "#f5f5f5", "$type": "color" },
				"spot": { "$value": "#fafafa", "$type": "color" },
				"mask": { "$value": "rgba(0, 0, 0, 0.45)", "$type": "color" }
			}
		}
