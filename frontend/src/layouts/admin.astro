const colorMap: Record<
	string,
	{ text: string; bgSoft: string; border: string }
> = {
	primary: {
		text: "var(--ochre-600)",
		bgSoft: "color-mix(in srgb, var(--ochre-500) 12%, transparent)",
		border: "var(--ochre-300)",
	},
	secondary: {
		text: "var(--indigo-600)",
		bgSoft: "color-mix(in srgb, var(--indigo-500) 12%, transparent)",
		border: "var(--indigo-300)",
	},
	success: {
		text: "var(--sage-600)",
		bgSoft: "color-mix(in srgb, var(--sage-500) 14%, transparent)",
		border: "var(--sage-300)",
	},
	warn: {
		text: "var(--walnut-600)",
		bgSoft: "color-mix(in srgb, var(--walnut-500) 16%, transparent)",
		border: "var(--walnut-300)",
	},
	accent: {
		text: "var(--walnut-600)",
		bgSoft: "color-mix(in srgb, var(--walnut-500) 14%, transparent)",
		border: "var(--walnut-300)",
	},
	accent2: {
		text: "var(--ochre-500)",
		bgSoft: "color-mix(in srgb, var(--ochre-400) 14%, transparent)",
		border: "var(--ochre-200)",
	},
	danger: {
		text: "var(--ochre-700)",
		bgSoft: "color-mix(in srgb, var(--ochre-600) 14%, transparent)",
		border: "var(--ochre-400)",
	},
	muted: {
		text: "var(--walnut-500)",
		bgSoft: "color-mix(in srgb, var(--walnut-400) 12%, transparent)",
		border: "var(--walnut-200)",
	},
	indigo: {
		text: "var(--indigo-600)",
		bgSoft: "color-mix(in srgb, var(--indigo-500) 14%, transparent)",
		border: "var(--indigo-300)",
