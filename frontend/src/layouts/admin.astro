---
import Layout from "@layouts/Layout.astro";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";

const { title = i18n(I18nKey.adminDashboard) } = Astro.props;
const pathname = Astro.url.pathname;

const isActive = (path: string) => {
	if (path === "/admin/") return pathname === "/admin/";
	return pathname.startsWith(path);
};

interface NavItem {
	path: string;
	labelKey: I18nKey;
	icon: string;
	badge?: string | number;
	color?: string;
}

interface NavGroup {
	titleKey: I18nKey;
	items: NavItem[];
}

const navGroups: NavGroup[] = [
	{
		titleKey: I18nKey.adminNavOverview,
		items: [
			{
				path: "/admin/",
				labelKey: I18nKey.adminDashboard,
				icon: "dashboard",
				color: "primary",
			},
		],
	},
	{
		titleKey: I18nKey.adminNavContent,
		items: [
			{
				path: "/admin/posts/",
				labelKey: I18nKey.adminPosts,
				icon: "file-text",
				color: "primary",
			},
			{
				path: "/admin/posts/new/",
				labelKey: I18nKey.adminNewPost,
				icon: "edit",
				color: "success",
			},
			{
				path: "/admin/categories/",
				labelKey: I18nKey.adminCategories,
				icon: "folder",
				color: "accent",
			},
			{
				path: "/admin/tags/",
				labelKey: I18nKey.adminTags,
				icon: "tag",
				color: "accent2",
			},
			{
				path: "/admin/pages/",
				labelKey: I18nKey.adminPages,
				icon: "layers",
				color: "secondary",
			},
		],
	},
	{
		titleKey: I18nKey.adminNavInteraction,
		items: [
			{
				path: "/admin/comments/",
				labelKey: I18nKey.adminComments,
				icon: "message-circle",
				color: "warn",
				badge: "0",
			},
			{
				path: "/admin/guestbook/",
				labelKey: I18nKey.adminGuestbook,
				icon: "message-circle",
				color: "success",
				badge: "0",
			},
			{
				path: "/admin/dynamics/",
				labelKey: I18nKey.adminDynamics,
				icon: "megaphone",
				color: "danger",
			},
		],
	},
	{
		titleKey: I18nKey.adminNavMedia,
		items: [
			{
				path: "/admin/gallery/",
				labelKey: I18nKey.adminGallery,
				icon: "images",
				color: "secondary",
			},
			{
				path: "/admin/albums/",
				labelKey: I18nKey.adminAlbums,
				icon: "image",
				color: "indigo",
			},
		],
	},
	{
		titleKey: I18nKey.adminNavAppearance,
		items: [
			{
				path: "/admin/banners/",
				labelKey: I18nKey.adminBanners,
				icon: "slideshow",
				color: "warn",
			},
			{
				path: "/admin/nav/",
				labelKey: I18nKey.adminNavMenu,
				icon: "menu",
				color: "success",
			},
			{
				path: "/admin/announcements/",
				labelKey: I18nKey.adminAnnouncements,
				icon: "bell",
				color: "warn",
			},
		],
	},
	{
		titleKey: I18nKey.adminNavUsers,
		items: [
			{
				path: "/admin/users/",
				labelKey: I18nKey.adminUsers,
				icon: "users",
				color: "secondary",
			},
			{
				path: "/admin/profile/",
				labelKey: I18nKey.adminProfile,
				icon: "user",
				color: "primary",
			},
		],
	},
	{
		titleKey: I18nKey.adminNavTools,
		items: [
			{
				path: "/admin/friends/",
				labelKey: I18nKey.adminFriends,
				icon: "link",
				color: "success",
			},
		],
	},
	{
		titleKey: I18nKey.adminNavSettings,
		items: [
			{
				path: "/admin/settings/",
				labelKey: I18nKey.adminSiteSettings,
				icon: "settings",
				color: "muted",
			},
			{
				path: "/admin/logs/",
				labelKey: I18nKey.adminOperationLogs,
				icon: "logs",
				color: "warn",
			},
			{
				path: "/admin/monitor/",
				labelKey: I18nKey.adminMonitor,
				icon: "activity",
				color: "danger",
			},
		],
	},
];

const icons: Record<string, string> = {
	dashboard: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="16" width="7" height="5" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/></svg>`,
	"file-text": `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14,2 14,8 20,8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><line x1="10" y1="9" x2="8" y2="9"/></svg>`,
	layers: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12,2 2,7 12,12 22,7 12,2"/><polygon points="2,17 12,22 22,17"/><polygon points="2,12 12,17 22,12"/></svg>`,
	folder: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>`,
	tag: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>`,
	"message-circle": `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>`,
	megaphone: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="3,11 3,13 7,13 13,18 13,6 7,11"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07"/></svg>`,
	link: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>`,
	image: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21,15 16,10 5,21"/></svg>`,
	images: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21,15 16,10 5,21"/></svg>`,
	slideshow: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>`,
	users: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
	menu: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>`,
	settings: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>`,
