    (function injectBingMetaClient() {
        function tryInject() {
            var bingCopyright =
                typeof window.__bingWallpaperCopyright === "string"
                    ? window.__bingWallpaperCopyright.trim()
                    : "";
            var bingTitle =
                typeof window.__bingWallpaperTitle === "string"
                    ? window.__bingWallpaperTitle.trim()
                    : "";
            if (!bingCopyright && !bingTitle) return false;
            var existing = document.getElementById("bing-wallpaper-meta");
            if (existing) return true;
            var wrapper = document.getElementById("wallpaper-wrapper");
            if (!wrapper) return false;
            var container = document.createElement("div");
            container.id = "bing-wallpaper-meta";
            container.className =
                "absolute bottom-24 right-3 md:bottom-32 md:right-5 z-50 pointer-events-none transition-opacity duration-500 max-w-[60vw] md:max-w-[30vw]";
            var innerHtml = "";
            if (bingTitle)
                innerHtml +=
                    '<div class="bing-wallpaper-title font-medium truncate">' +
                    bingTitle +
                    "</div>";
            if (bingCopyright)
                innerHtml +=
                    '<div class="bing-wallpaper-copyright text-white/70 truncate text-[10px] md:text-xs">' +
                    bingCopyright +
                    "</div>";
            if (innerHtml) {
                container.innerHTML =
                    '<div class="bing-wallpaper-meta-inner bg-black/40 dark:bg-black/60 backdrop-blur-md px-3 py-1.5 rounded-md text-white/85 text-xs md:text-sm shadow-lg leading-snug">' +
                    innerHtml +
                    "</div>";
                wrapper.appendChild(container);
            }
            return true;
        }
        // 首次尝试立即执行；失败则重试（Bing 数据可能异步写入全局）
        if (!tryInject()) {
            var attempts = 0;
            var timer = setInterval(function () {
                attempts++;
                if (tryInject() || attempts >= 20) clearInterval(timer);
            }, 100);
        }
        // Astro 页面每次 Swup 加载后也重新尝试注入（切到新页面 wrapper 可能重建）
        if (typeof document !== "undefined") {
            document.addEventListener("astro:page-load", function () {
                tryInject();
            }, false);
        }
    })();
    </script>

    <!-- Banner 副标题（图片标题位置）世界名言 API 注入脚本：名言放这里，不再写 Bing 描述 -->
    <script is:inline data-swup-ignore-script>
    (function injectWorldQuotesToSubtitle() {
        // 名言 API 列表：免费、REST JSON，首个可用者胜（quotable + zenquotes + 内置兜底三重）
        var QUOTE_ENDPOINTS = [
            {
                name: "quotable",
                url: "https://api.quotable.io/random?maxLength=140",
                parse: function (json) {
                    if (!json) return null;
                    if (Array.isArray(json)) json = json[0];
                    if (!json) return null;
                    var content = (json.content || json.quote || json.text || json.q || "").toString().trim();
                    var author = (json.author || json.a || json.writer || "").toString().trim();
                    if (!content) return null;
                    return { content: content, author: author || "Unknown" };
                }
            },
            {
                name: "zenquotes",
                url: "https://zenquotes.io/api/random",
                parse: function (json) {
                    if (!json) return null;
                    if (Array.isArray(json)) json = json[0];
                    if (!json) return null;
                    var content = (json.q || json.quote || json.content || "").toString().trim();
                    var author = (json.a || json.author || "").toString().trim();
                    if (!content) return null;
                    return { content: content, author: author || "Unknown" };
                }
            }
        ];
        // 内置兜底世界名言（离线/API 全挂时使用）
        var FALLBACK_QUOTES = [
            { content: "The unexamined life is not worth living.", author: "Socrates" },
            { content: "In the middle of difficulty lies opportunity.", author: "Albert Einstein" },
            { content: "That which does not kill us makes us stronger.", author: "Friedrich Nietzsche" },
            { content: "The only true wisdom is in knowing you know nothing.", author: "Socrates" },
            { content: "We are what we repeatedly do. Excellence, then, is not an act, but a habit.", author: "Aristotle" },
            { content: "Imagination is more important than knowledge.", author: "Albert Einstein" },
            { content: "Hell is other people.", author: "Jean-Paul Sartre" },
            { content: "Man is condemned to be free.", author: "Jean-Paul Sartre" },
            { content: "The journey of a thousand miles begins with a single step.", author: "Lao Tzu" },
            { content: "Whereof one cannot speak, thereof one must be silent.", author: "Ludwig Wittgenstein" },
            { content: "God is dead. God remains dead. And we have killed him.", author: "Friedrich Nietzsche" },
            { content: "I think, therefore I am.", author: "René Descartes" },
            { content: "To be is to be perceived.", author: "George Berkeley" },
            { content: "Liberty consists in doing what one desires.", author: "John Stuart Mill" },
            { content: "There is but one truly serious philosophical problem, and that is suicide.", author: "Albert Camus" }
        ];

        // localStorage 键：12h 缓存，保证名言稳定不频繁跳动
        var CACHE_KEY = "rosetta_world_quote_cache";
        var CACHE_MS = 12 * 60 * 60 * 1000;

        function rand(n) { return Math.floor(Math.random() * Math.max(1, n)); }
        function pickFallback() { return FALLBACK_QUOTES[rand(FALLBACK_QUOTES.length)]; }
        function readCache() {
            try {
                var raw = localStorage.getItem(CACHE_KEY);
                if (!raw) return null;
                var obj = JSON.parse(raw);
                if (!obj || !obj.ts || !obj.content) return null;
                if (Date.now() - obj.ts > CACHE_MS) return null;
                return { content: obj.content, author: obj.author || "Unknown" };
            } catch (_) { return null; }
        }
        function writeCache(content, author) {
            try { localStorage.setItem(CACHE_KEY, JSON.stringify({ ts: Date.now(), content: content, author: author })); } catch (_) {}
        }
        function formatFull(content, author) {
            if (!content) return "";
            var a = author ? (" — " + author) : "";
            return "\u201C" + content + "\u201D" + a;
        }

        // 把名言写入 Banner 副标题（不再用 Bing 描述填充这里）
        function applyQuote(content, author) {
            if (!content) return;
            var subtitleEl = document.getElementById("banner-subtitle");
            if (!subtitleEl) return;
            var full = formatFull(content, author);
            // 移除打字机元素（用户明确名言优先级最高，不要打字机效果）
            var tw = subtitleEl.querySelector('.typewriter') || subtitleEl.querySelector('[data-typewriter]');
            if (tw) { while (subtitleEl.firstChild) subtitleEl.removeChild(subtitleEl.firstChild); }
            if (subtitleEl.textContent !== full) subtitleEl.textContent = full;
            // 清掉默认字幕数组，避免 setRandomSubtitle 再把默认诗句写回来
            try { subtitleEl.removeAttribute('data-subtitles'); } catch (_) {}
            // 写入全局缓存（供切页复用；不再使用 ROSETTACachedSubtitle，避免与旧 Bing 逻辑冲突）
            try {
                window.__rosettaQuote = { content: content, author: author || "Unknown" };
            } catch (_) {}
        }

        // 全局已有值立即应用
        var cached = readCache();
        if (cached && cached.content) applyQuote(cached.content, cached.author);
        else if (typeof window !== "undefined" && window.__rosettaQuote && window.__rosettaQuote.content)
            applyQuote(window.__rosettaQuote.content, window.__rosettaQuote.author);

        function tryFetchEndpoints(idx) {
            if (!idx) idx = 0;
            if (idx >= QUOTE_ENDPOINTS.length) {
                var fb = pickFallback();
                applyQuote(fb.content, fb.author);
                writeCache(fb.content, fb.author);
                return;
            }
            var ep = QUOTE_ENDPOINTS[idx];
            try {
                var xhr = new XMLHttpRequest();
                xhr.open("GET", ep.url, true);
                xhr.timeout = 5000;
                xhr.onreadystatechange = function () {
                    if (xhr.readyState !== 4) return;
                    var done = false;
                    try {
                        if (xhr.status >= 200 && xhr.status < 300) {
                            var text = xhr.responseText || "";
                            if (text) {
                                var json = null;
                                try { json = JSON.parse(text); } catch (_) { json = null; }
                                var quote = ep.parse(json);
                                if (quote && quote.content) {
                                    applyQuote(quote.content, quote.author);
                                    writeCache(quote.content, quote.author);
                                    done = true;
                                }
                            }
                        }
                    } catch (_) { done = false; }
                    if (!done) setTimeout(function () { tryFetchEndpoints(idx + 1); }, 80);
                };
                xhr.ontimeout = function () { setTimeout(function () { tryFetchEndpoints(idx + 1); }, 0); };
                xhr.onerror = function () { setTimeout(function () { tryFetchEndpoints(idx + 1); }, 0); };
                xhr.send(null);
            } catch (_) { setTimeout(function () { tryFetchEndpoints(idx + 1); }, 0); }
        }

        function runOnce() {
            var c = readCache();
            if (c && c.content) { applyQuote(c.content, c.author); return; }
            tryFetchEndpoints(0);
        }

        if (typeof document !== "undefined") {
            if (document.readyState === "loading")
                document.addEventListener("DOMContentLoaded", runOnce, false);
            else
                runOnce();
            // Swup 切页后：直接复用现有值（若没值再请求）
            document.addEventListener("astro:page-load", function () {
                try {
                    if (window.__rosettaQuote && window.__rosettaQuote.content) {
                        applyQuote(window.__rosettaQuote.content, window.__rosettaQuote.author);
                    } else {
                        var cc = readCache();
                        if (cc && cc.content) applyQuote(cc.content, cc.author);
                        else runOnce();
                    }
                } catch (_) {}
            }, false);
        }
    })();
    </script>

    <!-- 每次 Astro 页面加载（首次 + Swup 切页）重置 banner 状态（防止筛选标题/副标题在切页后残留重叠） -->
    <script is:inline data-swup-ignore-script>
    (function bannerStateGuard() {
        // 简单判断当前页面是否是首页（pathname === '/' 或根路径，不考虑 query 和 hash）
        function isHomePageNow() {
            var p = (location.pathname || '/').replace(/\/+$/, '');
            if (p === '') return true;
            // i18n 兼容：/zh /en 等 2 字母顶级段视为首页
            if (/^\/[a-z]{2}$/i.test(p)) return true;
            return false;
        }
        // 是否归档页（含筛选：/archive?category=xxx /archive?tag=xxx）
        function isArchivePageNow() {
            return /^\/archive\/?$/i.test(location.pathname);
        }
        // 是否文章详情页
        function isPostPageNow() {
            return /^\/posts\//i.test(location.pathname);
        }

        function readRawI18n(key, fallback) {
            try {
                if (typeof window.__rosettaRawI18n === 'function') {
                    var v = window.__rosettaRawI18n(key);
                    if (v) return v;
                }
            } catch (_e) { /* ignore */ }
            return fallback;
        }
        function resolveBannerDefaultText(spanEl) {
            if (!spanEl) return '';
            var keyAttr = spanEl.getAttribute('data-i18n-text-key');
            var def = spanEl.getAttribute('data-default-title') || '';
            if (keyAttr) {
                var translated = readRawI18n(keyAttr, '');
                if (translated) return translated;
            }
            return def;
        }
        function resetBannerState() {
            // 1) 还原 .banner-page-title-text 到 SSR 默认值
            //    例外：当前是带筛选参数的归档页（/archive?category=xxx 或 /archive?tag=xxx）
            //    → 不还原，因为 ArchivePanel 会在 constructor 内调用 updateBannerTitle 设为筛选名
            //    （我们稍后用 setTimeout 兜底，若它没设再回退到默认值，避免漏网）
            var bannerTitleSpan = document.querySelector('.banner-page-title-text');
            var isFilteredArchive = isArchivePageNow();
            if (bannerTitleSpan && !isFilteredArchive) {
                var def = resolveBannerDefaultText(bannerTitleSpan);
                bannerTitleSpan.textContent = def;
            } else if (bannerTitleSpan && isFilteredArchive) {
