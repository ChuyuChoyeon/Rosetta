                            if (raw) {
                                var obj = JSON.parse(raw);
                                if (obj && obj.ts && obj.content && (Date.now() - obj.ts) < 12*60*60*1000) {
                                    quoteContent = String(obj.content).trim();
                                    quoteAuthor = String(obj.author || '').trim();
                                }
                            }
                        } catch (_) { /* ignore */ }
                    }
                    var subtitleEl = document.getElementById('banner-subtitle');
                    if (!subtitleEl) return;
                    if (quoteContent) {
                        // 移除打字机子元素（名言最高优先级，不要打字机）
                        var tw = subtitleEl.querySelector('.typewriter') || subtitleEl.querySelector('[data-typewriter]');
                        if (tw) { while (subtitleEl.firstChild) subtitleEl.removeChild(subtitleEl.firstChild); }
                        var full = '\u201C' + quoteContent + '\u201D' + (quoteAuthor ? (' \u2014 ' + quoteAuthor) : '');
                        if (subtitleEl.textContent !== full) subtitleEl.textContent = full;
                        // 清除默认诗句源，避免 setRandomSubtitle 覆盖
                        try { subtitleEl.removeAttribute('data-subtitles'); } catch (_) {}
                    } else if (retries && retries > 0) {
                        // 名言脚本异步请求中，再等一下
                        setTimeout(function () { applyQuote(retries - 1); }, 150);
                    }
                })(25);
            } catch (_e) { /* ignore */ }
        }

        // Astro 的页面生命周期（首载+Swup切页都触发）
        document.addEventListener('astro:page-load', resetBannerState, false);

        // 兜底：某些环境 astro:page-load 延迟执行，DOMContentLoaded 先执行一次以防止首屏重叠
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', resetBannerState, { once: true });
        } else {
            resetBannerState();
        }
    })();
    </script>
</div>
)}

{/* 当壁纸未渲染时，添加空的 Swup 占位容器，避免 Swup 找不到容器而回退为整页加载 */}
{!(isWallpaperSwitchable || isBannerMode || isFullscreenMode || isOverlayMode) && (
<>
    <div id="banner-overlay-container" class="hidden"></div>
    <div id="banner-dim-container" class="hidden"></div>
</>
)}

<!-- Main content -->
<div class={`absolute w-full z-30 pointer-events-none ${mobileNonHomeBannerClass ? 'mobile-main-no-banner' : ''} ${!(isBannerMode && isBackgroundEnabled) ? 'no-banner-layout' : ''}`} style={isFullscreenMode ? 'top: 0;' : `top: ${finalMainPanelTop}`}>
    <!-- The pointer-events-none here prevent blocking the click event of the TOC -->
    <div class="relative w-full xl:w-[92vw] max-w-(--page-width) mx-auto pointer-events-auto">
        <div id="main-grid"
          class={`transition duration-700 w-full left-0 right-0 grid ${gridCols} grid-rows-[auto_1fr_auto] lg:grid-rows-[auto] mx-auto gap-4 px-2 md:px-4 ${!sidebarConfig.mobileShowSidebar ? 'mobile-no-sidebar' : ''}`}
          data-sidebar-enable={sidebarLayoutConfig.enable ? "true" : "false"}
          data-grid-hide-sidebar-on-post={hideSidebarOnPostPage ? "true" : "false"}
          data-sidebar-position={sidebarLayoutConfig.position}
          data-tablet-sidebar={sidebarLayoutConfig.tabletSidebar ?? "left"}
          data-show-both-sidebars-on-post={sidebarLayoutConfig.showBothSidebarsOnPostPage ? "true" : "false"}
        >

            {/* 渲染左侧边栏 - 根据position和tabletSidebar配置显示 */}
            {/*
                如果全局配置为双侧栏(position: both)或仅左侧栏(position: left)，则使用静态容器(不被swup替换)，避免闪烁。
                如果全局配置为仅右侧栏(position: right)，则使用动态容器(被swup替换)，以便在文章页显示左侧栏。
                注意：为了满足swup要求所有containers必须存在，我们在所有模式下都必须渲染 #left-sidebar-dynamic。
            */}
            {sidebarLayoutConfig.position !== "right" ? (
                <>
                    {sidebarLayoutConfig.enable ? (
                        <div id="left-sidebar-wrapper" class="contents" data-hide-sidebar-on-post={hideSidebarOnPostPage ? "true" : "false"} style="contain: layout style paint;">
                            {effectiveHasLeftComponents && (
                                <SideBar
                                    side={effectiveIsBothSidebars ? "left" : undefined}
                                    class={sidebarClass}
                                    headings={headings}
                                    encrypted={encrypted}
                                />
                            )}
                        </div>
                    ) : (
                        <div id="left-sidebar-wrapper" class="hidden"></div>
                    )}
                    <div id="left-sidebar-dynamic" class="hidden transition-swup-fade"></div>
                </>
            ) : (
                <div id="left-sidebar-dynamic" class="contents transition-swup-fade">
                    {effectiveIsBothSidebars && effectiveHasLeftComponents && (
						<SideBar side="left" class={sidebarClass} headings={headings} encrypted={encrypted}></SideBar>
                    )}
                </div>
            )}
                    
            {/* 主内容区包装器 - 包含静态栏位和swup容器，作为单个grid item */}
            <div class={staticBarClass}>
                {/* 分类导航栏 - 全站渲染并显示 */}
                {shouldRenderCategoryBar && <div id="category-bar-wrapper"><CategoryBar currentPostCategory={postCategory} /></div>}
                {/* 主内容区 - 始终渲染，确保 Swup 容器存在 */}
                <main
                    id="swup-container"
                    class="transition-main transition-swup-fade"
                    data-current-post-category={postCategory || ""}
                >
                {/* 携带网格布局类名，用于JS更新父容器 */}
                <div id="grid-class-carrier" data-grid-class={gridCols} class="hidden"></div>
                {/* 为每个页面提供一个隐藏的h1标题，用于SEO和可访问性
                    —— 同时挂 data-i18n-text-key，让 translation.ts / resetBannerState 能
                    在切语言 / Swup content:replace 时同步刷新文本，避免 SSR 默认语言
                    (zh_CN) 输出之后，客户端跳其他语言时 sr-only 文本滞后导致快照/爬虫读错。 */}
                <h1
                    class="sr-only"
                    data-default-title={title ?? ""}
                    data-i18n-text-key={titleI18nKey}
                >{title}</h1>
                <div id="content-wrapper" class="onload-animation transition-leaving">
                    <slot></slot>
                </div>
            </main>
            </div>

            {/* 右侧边栏 - 双侧边栏模式或仅右侧栏模式 */}
            {/*
                如果全局配置为双侧栏(position: both)或仅右侧栏(position: right)，则使用静态容器(不被swup替换)，避免闪烁。
                如果全局配置为单侧栏(position: left)，则使用动态容器(被swup替换)，以便在文章页显示右侧栏。
                注意：为了满足swup要求所有containers必须存在，我们在所有模式下都必须渲染 #right-sidebar-dynamic。
                右侧边栏的显示由CSS类控制。
            */}
            {(sidebarLayoutConfig.position === "both" || sidebarLayoutConfig.position === "right") ? (
                <>
                    {sidebarLayoutConfig.enable ? (
                        <div id="right-sidebar-static" class="contents" data-hide-sidebar-on-post={hideSidebarOnPostPage ? "true" : "false"}>
                            {(effectiveIsBothSidebars || sidebarLayoutConfig.position === "right") && effectiveHasRightComponents && (
								<SideBar side="right" class={rightSidebarClass} headings={headings} encrypted={encrypted}></SideBar>
                            )}
                        </div>
                    ) : (
                        <div id="right-sidebar-static" class="hidden"></div>
                    )}
                    <div id="right-sidebar-dynamic" class="hidden transition-swup-fade"></div>
                </>
            ) : (
                <div id="right-sidebar-dynamic" class="contents transition-swup-fade">
                    {effectiveIsBothSidebars && effectiveHasRightComponents && (
						<SideBar side="right" class={rightSidebarClass} headings={headings} encrypted={encrypted}></SideBar>
                    )}
                </div>
            )}

            {/* 移动端底部组件 - 768px及以下显示 */}
            {sidebarLayoutConfig.mobileBottomComponents && sidebarLayoutConfig.mobileBottomComponents.length > 0 && (
                <div id="mobile-bottom-sidebar" class="col-span-1 block md:hidden mt-4">
					<SideBar side="bottom" headings={headings} encrypted={encrypted}></SideBar>
                </div>
            )}

            <div class={footerClassName}>
                <Footer></Footer>
            </div>
        </div>

        <SpineModel></SpineModel>
        {live2dWidgetConfig.enable && <Live2DWidget config={live2dWidgetConfig} />}
    </div>
</div>

<FloatingControls headings={headings} encrypted={encrypted} />

<!--
    触屏设备上让代码块的复制按钮默认隐藏，点一下代码块才显形。
    expressive-code 没给 <pre> 加 tabindex，点击代码区不会产生焦点，
    所以纯 CSS 的 :focus-within 拿不到这个状态，只能在这里补一个类。
    显隐规则见 src/styles/expressive-code.css 的 @media (hover: none) 段。
-->
<script is:inline data-swup-ignore-script>
    (function initTouchCodeCopyReveal() {
        var CLASS = 'ff-copy-revealed';

        // 委托到 document，swup 换页后无需重新绑定
        document.addEventListener('click', function (event) {
            // 有 hover 能力的设备走 CSS 的悬停显形逻辑，不需要打标记。
            // 放在处理函数里判断，混合输入设备切换输入方式后也能跟上
            if (window.matchMedia('(hover: hover)').matches) return;

            var target = event.target;
            if (!target || !target.closest) return;

            var frame = target.closest('.expressive-code .frame');

            // 点到别处就收起之前展开的按钮
            document.querySelectorAll('.' + CLASS).forEach(function (revealed) {
                if (revealed !== frame) revealed.classList.remove(CLASS);
            });

            // 点在复制按钮上时说明它已经显形，交给原生逻辑处理即可
            if (frame && !target.closest('.copy')) frame.classList.add(CLASS);
        });
    })();
</script>

<script is:inline data-swup-ignore-script>
    (function initDynamicHeroBackground() {
        var FALLBACK_GRADIENT = 'linear-gradient(135deg, #1e3a8a 0%, #7e22ce 100%)';
        var CACHE_KEY = 'rosetta_hero_bg_cache_v1';
        var CACHE_TTL_MS = 12 * 60 * 60 * 1000;

        function getContainer() {
            return document.getElementById('banner-images-container');
        }

        function applyBackground(bgUrl) {
            var container = getContainer();
            if (!container) return;

            var slides = container.querySelectorAll('.slide-item');
            if (slides.length > 0) {
                var slide;
                for (var i = 0; i < slides.length; i++) {
                    if (!slides[i].querySelector('img')) {
                        slide = slides[i];
                        break;
                    }
                }
                if (!slide) {
                    slide = document.createElement('div');
                    slide.className = 'slide-item absolute inset-0 w-full h-full hidden lg:block';
                    container.insertBefore(slide, container.firstChild);
                }
                applyToSlide(slide, bgUrl);
                return;
            }

            var wrapper = document.createElement('div');
            wrapper.className = 'absolute inset-0 w-full h-full overflow-hidden';
            var slide = document.createElement('div');
            slide.className = 'slide-item absolute inset-0 w-full h-full';
            wrapper.appendChild(slide);
            container.appendChild(wrapper);
            applyToSlide(slide, bgUrl);
        }

        function applyToSlide(slide, bgUrl) {
            slide.style.background = FALLBACK_GRADIENT;
            slide.style.backgroundSize = 'cover';
            slide.style.backgroundPosition = 'center';
            slide.classList.add('active');
            if (!bgUrl) return;

            var img = new Image();
            img.onload = function () {
                slide.style.transition = 'opacity 1.5s ease-in-out, background-image 1.5s ease-in-out';
                slide.style.backgroundImage = "url('" + bgUrl + "')";
            };
            img.onerror = function () {
                console.warn('[Hero Background] 加载背景图失败：', bgUrl);
            };
            img.src = bgUrl;
        }

        function readCache() {
            try {
                var raw = localStorage.getItem(CACHE_KEY);
                if (!raw) return null;
                var data = JSON.parse(raw);
                if (!data || !data.timestamp || !data.url) return null;
                if (Date.now() - data.timestamp > CACHE_TTL_MS) return null;
                return data;
            } catch (e) { return null; }
        }

        function writeCache(url, meta) {
            try {
                localStorage.setItem(CACHE_KEY, JSON.stringify({
                    url: url,
                    meta: meta || null,
                    timestamp: Date.now()
                }));
            } catch (e) {}
        }

        function init() {
            var container = getContainer();
            if (!container) return;

            var existingImages = container.querySelectorAll('.slide-item img, .slide-item [style*="background"]');
            var hasStaticImage = false;
            for (var i = 0; i < existingImages.length; i++) {
                var el = existingImages[i];
                if (el && el.tagName === 'IMG' && el.getAttribute('src')) { hasStaticImage = true; break; }
                if (el && el.style && el.style.backgroundImage && el.style.backgroundImage !== 'none') { hasStaticImage = true; break; }
            }
            if (hasStaticImage) return;

            applyBackground(null);

            var cache = readCache();
            if (cache && cache.url) {
                applyBackground(cache.url);
            }

            Promise.resolve()
                .then(function () {
                    return fetch('/api/config', { credentials: 'same-origin' })
                        .then(function (r) { return r.ok ? r.json() : null; })
                        .catch(function () { return null; });
                })
                .then(function (cfg) {
                    var userBg = null;
                    if (cfg && cfg.hero && cfg.hero.bg_image && typeof cfg.hero.bg_image === 'string' && cfg.hero.bg_image.trim()) {
                        userBg = cfg.hero.bg_image.trim();
                    }
                    if (userBg) {
                        applyBackground(userBg);
                        writeCache(userBg, { source: 'settings' });
                        return null;
                    }
                    return fetch('/api/media/bing-wallpaper?idx=0&n=1&mkt=zh-CN')
                        .then(function (r) { return r.ok ? r.json() : null; })
                        .catch(function () { return null; });
                })
                .then(function (bingData) {
                    if (!bingData || !Array.isArray(bingData.images) || bingData.images.length === 0) return;
                    var img = bingData.images[0];
                    if (!img || !img.full_url) return;
                    applyBackground(img.full_url);
                    writeCache(img.full_url, {
                        source: 'bing',
                        title: img.title || null,
                        copyright: img.copyright || null
                    });
                })
                .catch(function (e) {
                    console.warn('[Hero Background] 动态背景加载失败，使用渐变 fallback：', e);
                });
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', init);
        } else {
            init();
        }

        if (window.__rosettaHeroBgInited) return;
        window.__rosettaHeroBgInited = true;
        document.addEventListener('swup:contentReplaced', init);
    })();
</script>

</Layout>

