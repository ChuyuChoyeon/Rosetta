                    var def0 = resolveBannerDefaultText(bannerTitleSpan0);
                    setTimeout(function(){
                        var params = new URLSearchParams(location.search);
                        var hasFilter = params.has('tag') || params.has('category') || params.has('uncategorized');
                        // 有筛选参数但仍是默认文字 → ArchivePanel 可能被 destroy 了，还原默认
