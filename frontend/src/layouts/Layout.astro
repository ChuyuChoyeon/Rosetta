          const usedHashes = new Set<string>();
          document.querySelectorAll<HTMLElement>('*').forEach((el) => {
            const cls = (el.getAttribute('class') || '') + ' ' + (el.getAttribute('astro-scope') || '');
            if (typeof cls !== 'string') return;
            const astro = cls.match(/astro-[a-z0-9]{7,}/gi) || [];
            const svelte = cls.match(/svelte-[a-z0-9]+/gi) || [];
            astro.forEach((h) => usedHashes.add(h.toLowerCase()));
            svelte.forEach((h) => usedHashes.add(h.toLowerCase()));
