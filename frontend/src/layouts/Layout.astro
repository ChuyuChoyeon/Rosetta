    <!--
      Swup container 占位兜底（必须在任何布局都有 swup 配置的 containers 全部存在于 DOM）
      MainGridLayout / OOBE / admin 等不同布局会根据需要覆盖同名的真实容器；
      这里以 display:none 且不含 transition-swup-fade 占位，保证 swup 替换时不会因容器 missing 抛 Container mismatch abort 错误

      【关键1】占位节点 ID 加 `-ph` 后缀，避免 SSR 产物中出现重复 ID：
        Swup 解析新页面 HTML 字符串时（DOMParser），不会执行浏览器端脚本，
        如果同一个 ID 在 SSR 产物里出现两次（wrap 占位 + MainGridLayout 真实容器），
        Swup.querySelector 会拿到第一个空占位，用空节点替换当前页面的真实容器，
        表现就是「URL 更新了但页面内容没换，刷新才正常」。

      【关键2】占位 wrap 和 ensureSwupContainers 脚本必须放在 <slot /> 之后、</body> 之前：
        由于 Astro 组件是同步按顺序输出 HTML 的，如果脚本放在 <slot /> 之前，
        浏览器执行脚本时 MainGridLayout 还没被 HTML 解析器解析进 DOM，
        document.getElementById 就找不到真实容器，错误地把占位 promote 成正式 id
        设为 display:none 插到 body，结果解析完 MainGridLayout 后出现重复 ID，
        并且 getElementById / Swup 可能选到空的占位节点。
    -->
    <div id="swup-placeholder-wrap" aria-hidden="true" style="display:none!important">
      <div id="banner-overlay-container-ph"></div>
      <div id="banner-dim-container-ph"></div>
      <div id="swup-container-ph"></div>
      <div id="left-sidebar-dynamic-ph"></div>
      <div id="right-sidebar-dynamic-ph"></div>
      <div id="floating-toc-wrapper-ph"></div>
    </div>
    <script is:inline>
      // 在 swup 实例化前：对每个 swup container ID 做存在性检查。
      // - 如果页面布局（MainGridLayout / admin / OOBE 等）已经提供了真实容器（document.getElementById 能找到），
      //   则直接把 wrap 中对应的占位（带 -ph 后缀）删除，避免节点堆积。
      // - 如果页面布局没有提供该真实容器，则把 wrap 中对应占位的 ID 改为正式 ID，移到 body 末尾，
      //   作为 swup 的注入兜底，避免 Container mismatch abort。
      (function ensureSwupContainers() {
        try {
          var ids = [
            'banner-overlay-container',
            'banner-dim-container',
            'swup-container',
            'left-sidebar-dynamic',
            'right-sidebar-dynamic',
            'floating-toc-wrapper'
          ];
          var wrap = document.getElementById('swup-placeholder-wrap');
          if (!wrap) return;
          ids.forEach(function (id) {
            var real = document.getElementById(id);
            if (real) {
              // 页面已有真实容器 → 删除对应的占位（-ph 后缀），避免冗余
              var ph = wrap.querySelector('#' + CSS.escape(id + '-ph'));
              if (ph) wrap.removeChild(ph);
            } else {
              // 页面缺失真实容器 → 把占位升级为正式容器（重命名 ID + 移出 wrap）
              var phNode = wrap.querySelector('#' + CSS.escape(id + '-ph'));
              if (phNode) {
                var promoted = wrap.removeChild(phNode);
                promoted.id = id;
                promoted.setAttribute('data-swup-placeholder', '1');
                promoted.style.display = 'none';
                document.body.appendChild(promoted);
              }
            }
          });
          // 最后移除空的 wrap（不移除也 OK，display:none 不影响）
          if (wrap.parentNode && wrap.children.length === 0) {
            wrap.parentNode.removeChild(wrap);
          }
        } catch (_e) { /* 静默失败，最坏情况回到原行为 */ }
      })();
    </script>

