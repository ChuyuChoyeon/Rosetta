---
/**
 * 分类详情页 → 重定向到归档页并带上 category 筛选参数
 *  - /categories/生活/        → /archive/?category=生活 (URL encode)
 *  - /categories/technology/  → /archive/?category=technology
 *  - /categories/a/b/         → 多段 slug 视为非法，重定向到 /categories/
 *
 * 策略：保持兼容（旧链接、搜索引擎已收录路径），通过 302 重定向统一到
 * 归档筛选页，避免重复维护一套筛选 UI / 分页 / 排序逻辑。
 */
export const prerender = false;

import { url } from "@/utils/url-utils";

// REST 参数 [...slug]：在 Astro 某些版本下会以 string 或 string[] 返回
const raw: unknown = (Astro.params as any)?.slug;
let slugArr: string[];
if (typeof raw === "string") slugArr = [raw];
else if (Array.isArray(raw)) slugArr = raw as string[];
else slugArr = [];

let redirectTarget: string;
if (slugArr.length === 1 && slugArr[0]) {
	const encoded = encodeURIComponent(slugArr[0]);
	redirectTarget = url(`/archive/?category=${encoded}`);
} else if (slugArr.length === 0) {
	// /categories/ (无 slug) → 由 categories/index.astro 处理
	redirectTarget = url("/categories/");
} else {
	// 多段或空的非法路径 → 回到分类列表首页
	redirectTarget = url("/categories/");
}

return Astro.redirect(redirectTarget, 302);
---
