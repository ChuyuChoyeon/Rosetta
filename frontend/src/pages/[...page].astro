---
import type { Page } from "astro";
import Pagination from "@/components/common/Pagination.astro";
import PostPage from "@/components/layout/PostPage.astro";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { getSortedPosts } from "@/utils/content-utils";
import { loadDynamicConfig } from "@/utils/dynamic-config";
import { url } from "@/utils/url-utils";

/**
 * 分页路由（REST 参数 [...page]）
 *  - /        → 由 src/pages/index.astro 处理（显式路由优先级更高）
 *  - /2/      → params.page = ['2']
 *  - /3/      → params.page = ['3']
 *
 * 防御性策略：
 *  - prerender = false：强制 SSR
 *  - 不使用 Astro paginate()：它与 REST 参数 [...page] 在 SSR prerender=false 下
 *    有兼容性问题（getStaticPaths 即使在 SSR dev 阶段仍会被调用来热身，paginate()
 *    对 rest 参数格式要求严格，易抛异常 → 导致整页500而不是404）
 *  - 非法分页 / 超范围分页：设置 Astro.response.status = 404 并渲染 404 内容
 */
export const prerender = false;

// ===== SSR 模式：完全在组件体内构建，不依赖 getStaticPaths =====
const dynamicCfg = await loadDynamicConfig();

const pageSize =
	typeof dynamicCfg?.pagination?.postsPerPage === "number"
		? Math.max(1, dynamicCfg.pagination.postsPerPage)
		: 10;

// 预加载一次文章列表（分页对象构建和调试计数复用，避免重复请求）
const _allPosts = await getSortedPosts();
const _total = _allPosts.length;
const _lastPage = Math.max(1, Math.ceil(_total / pageSize));

// 从 Astro.params.page 解析页码并重建分页对象
// 返回 null 表示 page param 非法，调用方应渲染 404
async function buildPageFromParams(): Promise<Page<any> | null> {
	const allBlogPosts = _allPosts;
	const total = _total;
	const lastPage = _lastPage;

	const rawParam: unknown = (Astro.params as any)?.page;

	// Astro 的 REST 参数 [...page] 在单段路径下有时返回 string（例如 /2/ → "2"），
	// 多段路径下返回 string[]（/a/b/ → ['a','b']）。为保证健壮性统一规范化为 string[]。
	let rawPageArr: string[];
	if (typeof rawParam === "string") rawPageArr = [rawParam];
	else if (Array.isArray(rawParam)) rawPageArr = rawParam as string[];
	else return null;

	// 1) 必须是 [单元素数组]，形如 ['2']。空数组或多段（/a/b/）都不是合法分页
	if (rawPageArr.length !== 1) return null;
	const rawPage = rawPageArr[0];
	if (typeof rawPage !== "string") return null;

	// 2) 必须是纯数字字符串（不允许 /+2/、/02/ 等非规范形式）
	if (!/^\d+$/.test(rawPage)) return null;

	const parsed = Number.parseInt(rawPage, 10);
	if (Number.isNaN(parsed) || parsed < 1) return null;

	// 3) 超范围判定：> lastPage 直接视为 404
	if (parsed > lastPage) return null;

	const currentPage = parsed;
	const start = (currentPage - 1) * pageSize;
	const end = Math.min(start + pageSize, total);
	const data = allBlogPosts.slice(start, end);

	const makePageUrl = (n: number) => (n === 1 ? url("/") : url(`/${n}/`));

	return {
		data,
		start,
		end: Math.max(0, end - 1),
		size: pageSize,
		total,
		currentPage,
		lastPage,
		url: {
			prev: currentPage > 1 ? makePageUrl(currentPage - 1) : undefined,
			next: currentPage < lastPage ? makePageUrl(currentPage + 1) : undefined,
			current: makePageUrl(currentPage),
			first: makePageUrl(1),
			last: makePageUrl(lastPage),
		},
	};
}

const page: Page<any> | null = await buildPageFromParams();
const isNotFound = page == null;

if (isNotFound) {
	// 不使用 throw error()：它在部分 Astro SSR 场景下会导致 500 而不是 404
	// 改为设置响应状态码，模板阶段按 isNotFound 渲染404内容
	Astro.response.status = 404;
}

const len = isNotFound ? 0 : page?.data.length;
---

{
  isNotFound ? (
    <MainGridLayout title={"404"} description={"Page not found"}>
      <div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-96">
        <div class="card-base z-10 px-9 py-12 relative w-full flex flex-col items-center justify-center text-center">
          <div class="text-8xl md:text-9xl font-bold text-(--primary) opacity-20 mb-4">404</div>
          <div class="text-3xl md:text-4xl font-bold mb-4 text-90">页面未找到</div>
          <p class="text-lg text-75 mb-8 max-w-md">您访问的页面不存在，或已被移除。</p>
          <a
            href={url("/")}
            class="inline-flex items-center gap-2 px-6 py-3 bg-(--primary) text-white rounded-(--radius-large) hover:bg-(--btn-content) transition-colors duration-200 font-medium"
          >
            返回首页
          </a>
        </div>
      </div>
    </MainGridLayout>
  ) : (
    <MainGridLayout>
      <PostPage page={page!} />
      {
        page!.total > page!.size && (
          <Pagination
            class="mx-auto onload-animation"
            page={page!}
            style={`animation-delay: calc(var(--content-delay) + ${len * 50}ms)`}
          />
        )
      }
    </MainGridLayout>
  )
}

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const responsiveEnabled = true;
    if (responsiveEnabled) {
      const deviceType = getDeviceType();
      document.body.classList.add(`device-${deviceType}`);

      let resizeTimeout: any;
      window.addEventListener("resize", function () {
        clearTimeout(resizeTimeout);
        resizeTimeout = setTimeout(function () {
          const newDeviceType = getDeviceType();
          const currentDeviceType = document.body.className.match(
            /device-(mobile|tablet|desktop)/
          )?.[1];

          if (currentDeviceType !== newDeviceType) {
            document.body.classList.remove(`device-${currentDeviceType}`);
            document.body.classList.add(`device-${newDeviceType}`);
          }
        }, 250);
      });
    }
  });

  function getDeviceType() {
    if (typeof window === "undefined") return "desktop";
    const width = window.innerWidth;
    if (width < 768) return "mobile";
    if (width < 1024) return "tablet";
    return "desktop";
  }
</script>
