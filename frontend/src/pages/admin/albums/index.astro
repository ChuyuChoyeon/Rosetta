---
export const prerender = false;
import AdminLayout from "@layouts/admin.astro";
---
<AdminLayout title="相册管理">
	<fragment slot="actions">
		<div class="table-actions">
			<button class="btn btn-primary btn-sm" onclick="showAddModal()">
				<svg style="width:15px;height:15px" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
				新建相册
			</button>
		</div>
	</fragment>

	<div class="table-wrapper">
		<div class="table-header">
			<div style="display:flex;align-items:center;gap:14px;">
				<h3 class="table-title">所有相册</h3>
				<span class="badge badge-ghost" id="albums-count">0 个</span>
			</div>
		</div>
		<div class="table-scroll">
			<table class="table">
				<thead>
					<tr>
						<th style="padding-left:24px;">封面</th>
						<th>名称</th>
						<th>描述</th>
						<th>照片数</th>
						<th>创建时间</th>
						<th style="width:110px;padding-right:24px;">操作</th>
					</tr>
				</thead>
				<tbody id="list-body">
					<tr>
						<td colspan="6" style="text-align:center;padding:48px 24px;color:hsl(var(--bc)/0.5);">
							<div style="display:flex;flex-direction:column;align-items:center;gap:10px;">
								<svg style="width:36px;height:36px;opacity:0.4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
								<span>加载中...</span>
							</div>
						</td>
					</tr>
				</tbody>
			</table>
		</div>
	</div>
</AdminLayout>

<div class="admin-modal-overlay" id="album-modal">
	<div class="admin-modal">
		<div class="admin-modal-header">
			<h3 class="admin-modal-title" id="modal-title">新建相册</h3>
			<button class="admin-modal-close" onclick="closeModal()" type="button">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
			</button>
		</div>
		<div class="admin-modal-body">
			<div class="admin-form-group">
				<label class="admin-form-label" for="al-name">名称</label>
				<input type="text" id="al-name" class="admin-input" placeholder="相册名称">
			</div>
			<div class="admin-form-group">
				<label class="admin-form-label" for="al-desc">描述 <span style="color:hsl(var(--bc)/0.4);font-weight:400;">（可选）</span></label>
				<input type="text" id="al-desc" class="admin-input" placeholder="相册描述">
			</div>
			<div class="admin-form-group">
				<label class="admin-form-label" for="al-cover">封面URL <span style="color:hsl(var(--bc)/0.4);font-weight:400;">（可选）</span></label>
				<input type="text" id="al-cover" class="admin-input" placeholder="https://example.com/cover.jpg">
			</div>
		</div>
		<div class="admin-modal-footer">
			<button class="btn btn-ghost btn-sm" onclick="closeModal()" type="button">取消</button>
			<button class="btn btn-primary btn-sm" onclick="saveAlbum()" type="button">保存</button>
		</div>
	</div>
</div>

<script>
	// @ts-nocheck
	import { getAlbums, createAlbum, deleteAlbum } from "@api/admin";

	function formatDate(dateStr: string): string {
		if (!dateStr) return "-";
		return new Date(dateStr).toLocaleDateString('zh-CN');
	}

	async function loadList() {
		const tbody = document.getElementById("list-body") as HTMLElement;
		try {
			const items = await getAlbums();
			const count = items?.length || 0;
			const countEl = document.getElementById("albums-count");
			if (countEl) countEl.textContent = `${count} 个`;

			if (!items || items.length === 0) {
				tbody.innerHTML = `
					<tr>
						<td colspan="6" style="text-align:center;padding:56px 24px;">
							<div class="empty-state">
								<div class="empty-title">暂无相册</div>
								<div class="empty-desc">点击右上角创建第一个相册</div>
								<button class="btn btn-primary btn-sm" style="margin-top:8px;" onclick="showAddModal()">
									<svg style="width:15px;height:15px" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
									新建相册
								</button>
							</div>
						</td>
					</tr>
				`;
				return;
			}

			tbody.innerHTML = items.map((a: any) => `
				<tr>
					<td style="padding-left:24px;">
						${a.cover ? `<img src="${a.cover}" style="width:56px;height:42px;border-radius:10px;object-fit:cover;">` : '<div style="width:56px;height:42px;background:hsl(var(--b2));border-radius:10px;display:flex;align-items:center;justify-content:center;color:hsl(var(--bc)/0.3);"><svg style="width:20px;height:20px" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21,15 16,10 5,21"/></svg></div>'}
					</td>
					<td><span style="font-weight:600;">${a.name}</span></td>
					<td style="font-size:13px;color:hsl(var(--bc)/0.65);max-width:240px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${a.description || '-'}</td>
					<td><span class="badge badge-ghost">${a.photos_count || 0}</span></td>
					<td style="font-size:12.5px;color:hsl(var(--bc)/0.6);">${formatDate(a.created_at)}</td>
					<td style="padding-right:24px;">
						<div class="action-buttons">
							<button class="btn btn-ghost btn-icon btn-sm" style="color:hsl(var(--er));" onclick="del(${a.id})" title="删除">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3,6 5,6 21,6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
							</button>
						</div>
					</td>
				</tr>
			`).join("");
		} catch (e) {
			console.error(e);
			tbody.innerHTML = `
				<tr>
					<td colspan="6" style="text-align:center;padding:48px 24px;color:hsl(var(--er));">
						<div style="display:flex;flex-direction:column;align-items:center;gap:10px;">
							<svg style="width:36px;height:36px;opacity:0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
							<span>加载失败，请刷新重试</span>
						</div>
					</td>
				</tr>
			`;
		}
	}

	window.showAddModal = () => {
		(document.getElementById("modal-title") as HTMLElement).textContent = "新建相册";
		["al-name","al-desc","al-cover"].forEach(id => (document.getElementById(id) as HTMLInputElement).value = "");
		(document.getElementById("album-modal") as HTMLElement).classList.add("open");
	};

	window.closeModal = () => {
		(document.getElementById("album-modal") as HTMLElement).classList.remove("open");
	};

	window.saveAlbum = async () => {
		const name = (document.getElementById("al-name") as HTMLInputElement).value;
		if (!name) { alert("请输入名称"); return; }
		try {
			await createAlbum({
				name,
				description: (document.getElementById("al-desc") as HTMLInputElement).value,
				cover: (document.getElementById("al-cover") as HTMLInputElement).value
			});
			closeModal();
			loadList();
		} catch (e) {
			alert("保存失败");
		}
	};

	window.del = async (id: number) => {
		if (!confirm("确定要删除这个相册吗？此操作无法撤销。")) return;
		try {
			await deleteAlbum(id);
			loadList();
		} catch (e) {
			alert("删除失败");
		}
	};

	loadList();
</script>
