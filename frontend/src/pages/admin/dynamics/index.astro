---
export const prerender = false;
import AdminLayout from "@layouts/admin.astro";
---
<AdminLayout title="动态管理">
	<fragment slot="actions">
		<div class="table-actions">
			<button class="btn btn-primary btn-sm" onclick="showAddModal()">
				<svg style="width:15px;height:15px" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
				发布动态
			</button>
		</div>
	</fragment>

	<div class="table-wrapper">
		<div class="table-header">
			<div style="display:flex;align-items:center;gap:14px;">
				<h3 class="table-title">所有动态</h3>
				<span class="badge badge-ghost" id="dynamics-count">0 条</span>
			</div>
		</div>
		<div class="table-scroll">
			<table class="table">
				<thead>
					<tr>
						<th style="padding-left:24px;">内容</th>
						<th>图片</th>
						<th>点赞</th>
						<th>评论</th>
						<th>发布时间</th>
						<th style="width:100px;padding-right:24px;">操作</th>
					</tr>
				</thead>
				<tbody id="list-body">
					<tr>
						<td colspan="6" style="text-align:center;padding:48px 24px;color:hsl(var(--bc)/0.5);">
							<div style="display:flex;flex-direction:column;align-items:center;gap:10px;">
								<svg style="width:36px;height:36px;opacity:0.4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
								<span>加载中...</span>
							</div>
						</td>
					</tr>
				</tbody>
			</table>
		</div>
	</div>
</AdminLayout>

<!-- Modal -->
<div class="admin-modal-overlay" id="dynamic-modal">
	<div class="admin-modal">
		<div class="admin-modal-header">
			<h3 class="admin-modal-title">发布动态</h3>
			<button class="admin-modal-close" onclick="closeModal()" type="button">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
			</button>
		</div>
		<div class="admin-modal-body">
			<div class="admin-form-group">
				<label class="admin-form-label" for="d-content">内容</label>
				<textarea id="d-content" class="admin-textarea" rows="4" placeholder="说点什么..."></textarea>
			</div>
			<div class="admin-form-group">
				<label class="admin-form-label" for="d-images">图片URL <span style="color:hsl(var(--bc)/0.4);font-weight:400;">（用逗号分隔，可选）</span></label>
				<input type="text" id="d-images" class="admin-input" placeholder="例如: https://example.com/1.jpg, https://example.com/2.jpg">
			</div>
		</div>
		<div class="admin-modal-footer">
			<button class="btn btn-ghost btn-sm" onclick="closeModal()" type="button">取消</button>
			<button class="btn btn-primary btn-sm" onclick="saveDynamic()" type="button">发布</button>
		</div>
	</div>
</div>

<script>
	// @ts-nocheck
	import { getDynamics, createDynamic, deleteDynamic } from "@api/admin";
	function formatDate(s: string) { return new Date(s).toLocaleString(); }
	async function loadList() {
		const tbody = document.getElementById("list-body") as HTMLElement;
		try {
			const res = await getDynamics({ page_size: 30 });
			const items = res.items || [];
			const count = items.length || 0;
			const countEl = document.getElementById("dynamics-count");
			if (countEl) countEl.textContent = `${count} 条`;

			if (items.length === 0) {
				tbody.innerHTML = `
					<tr>
						<td colspan="6" style="text-align:center;padding:56px 24px;">
							<div class="empty-state">
								<div class="empty-title">暂无动态</div>
								<div class="empty-desc">点击右上角发布第一条动态</div>
								<button class="btn btn-primary btn-sm" style="margin-top:8px;" onclick="showAddModal()">
									<svg style="width:15px;height:15px" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
									发布动态
								</button>
							</div>
						</td>
					</tr>
				`;
				return;
			}
			tbody.innerHTML = items.map((d: any) => `
				<tr>
					<td style="padding-left:24px;">
						<div style="font-size:13.5px;max-width:360px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${d.content || ''}</div>
					</td>
					<td>${d.images_count ? `<span class="badge badge-ghost">${d.images_count}张</span>` : '<span style="color:hsl(var(--bc)/0.35);">-</span>'}</td>
					<td><span class="badge badge-ghost">${d.likes_count || 0}</span></td>
					<td><span class="badge badge-ghost">${d.comments_count || 0}</span></td>
					<td style="font-size:12.5px;color:hsl(var(--bc)/0.6);">${formatDate(d.created_at)}</td>
					<td style="padding-right:24px;">
						<div class="action-buttons">
							<button class="btn btn-ghost btn-icon btn-sm" style="color:hsl(var(--er));" onclick="del(${d.id})" title="删除">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3,6 5,6 21,6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
							</button>
						</div>
					</td>
				</tr>
			`).join("");
		} catch (e) {
			tbody.innerHTML = `
				<tr>
					<td colspan="6" style="text-align:center;padding:48px 24px;color:hsl(var(--er));">
						<div style="display:flex;flex-direction:column;align-items:center;gap:10px;">
							<svg style="width:36px;height:36px;opacity:0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
							<span>加载失败，请刷新重试</span>
						</div>
					</td>
				</tr>
			`;
		}
	}
	window.showAddModal = () => {
		(document.getElementById("d-content") as HTMLTextAreaElement).value = "";
		(document.getElementById("d-images") as HTMLInputElement).value = "";
		(document.getElementById("dynamic-modal") as HTMLElement).classList.add("open");
	};
	window.closeModal = () => {
		(document.getElementById("dynamic-modal") as HTMLElement).classList.remove("open");
	};
	window.saveDynamic = async () => {
		const content = (document.getElementById("d-content") as HTMLTextAreaElement).value;
		if (!content) { alert("请输入内容"); return; }
		const images = (document.getElementById("d-images") as HTMLInputElement).value.split(',').map(s=>s.trim()).filter(Boolean);
		await createDynamic({ content, images }); closeModal(); loadList();
	};
	window.del = async (id: number) => { if (confirm("确定删除？")) { await deleteDynamic(id); loadList(); } };
	loadList();
</script>
