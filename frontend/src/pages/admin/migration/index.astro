---
export const prerender = false;
import SkeletonPage from "@components/admin/SkeletonPage.svelte";
import { i18n } from "@i18n";
import AdminLayout from "@layouts/admin.astro";
import DataMigrationPanel from "@components/admin/DataMigrationPanel.svelte";
---

<AdminLayout title="数据一键迁移">
	<div id="migration-wrap" class="admin-page">
		<div id="migration-skeleton" class="dashboard-skeleton-wrap">
			<SkeletonPage cards={2} tableRows={6} tableCols={4} />
		</div>
		<div id="migration-body" hidden>
			<DataMigrationPanel client:load />
		</div>
	</div>
</AdminLayout>

<style is:global>
	#migration-wrap {
		--antd-color-primary: #1677ff;
		--antd-border-default: #d9d9d9;
		--antd-bg-layout: #f5f7fa;
		--antd-bg-container: #ffffff;
		padding: 16px clamp(12px, 2vw, 24px) 32px;
	}
	#migration-body:global(.antd-migration-card) {
		background: var(--antd-bg-container);
		border: 1px solid var(--antd-border-default);
		border-radius: 12px;
		padding: 20px;
	}
</style>
