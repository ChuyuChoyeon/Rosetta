---
import AdminLayout from "@layouts/admin.astro";
---
<AdminLayout title="个人资料">
	<div class="content-actions" slot="actions">
		<button id="save-profile" class="btn btn-primary btn-sm">保存修改</button>
	</div>

	<div style="max-width:700px;">
		<div class="card" style="margin-bottom:1.5rem;">
			<div class="card-header">
				<h3 class="card-title">基本信息</h3>
			</div>
			<div class="card-body">
				<div style="display:flex;gap:1.5rem;align-items:center;margin-bottom:1.5rem;">
					<div style="position:relative;">
						<img id="avatar-preview" src="https://www.gravatar.com/avatar/?d=mp&s=96" alt="Avatar" style="width:96px;height:96px;border-radius:50%;object-fit:cover;border:3px solid hsl(var(--b2));">
					</div>
					<div>
						<div style="font-weight:600;font-size:1.125rem;margin-bottom:0.25rem;" id="display-nickname">用户</div>
						<div style="color:hsl(var(--bc)/0.5);font-size:0.875rem;" id="display-email">邮箱</div>
					</div>
				</div>
				<div class="admin-form-group">
					<label class="admin-form-label">头像URL</label>
					<input type="text" id="profile-avatar" class="admin-input" placeholder="https://...">
				</div>
				<div class="admin-form-group">
					<label class="admin-form-label">昵称</label>
					<input type="text" id="profile-nickname" class="admin-input" placeholder="显示名称">
				</div>
				<div class="admin-form-group">
					<label class="admin-form-label">个人简介</label>
					<textarea id="profile-bio" class="admin-textarea" rows="3" placeholder="介绍一下自己..."></textarea>
				</div>
				<div class="admin-form-group">
					<label class="admin-form-label">个人网站</label>
					<input type="text" id="profile-website" class="admin-input" placeholder="https://">
				</div>
				<div class="admin-form-group">
					<label class="admin-form-label">GitHub</label>
					<input type="text" id="profile-github" class="admin-input" placeholder="用户名">
				</div>
			</div>
		</div>

		<div class="card">
			<div class="card-header">
				<h3 class="card-title">修改密码</h3>
			</div>
			<div class="card-body">
				<div class="admin-form-group">
					<label class="admin-form-label">当前密码</label>
					<input type="password" id="profile-old-password" class="admin-input" placeholder="当前密码">
				</div>
				<div class="admin-form-group">
					<label class="admin-form-label">新密码</label>
					<input type="password" id="profile-new-password" class="admin-input" placeholder="新密码 (至少6位)">
				</div>
				<div class="admin-form-group">
					<label class="admin-form-label">确认新密码</label>
					<input type="password" id="profile-confirm-password" class="admin-input" placeholder="再次输入新密码">
				</div>
			</div>
		</div>
	</div>
</AdminLayout>

<script>
	// @ts-nocheck
	import { getCurrentUser, updateProfile, changePassword } from "@api/auth";

	async function loadProfile() {
		try {
			const user = await getCurrentUser() as any;
			(document.getElementById("profile-nickname") as HTMLInputElement).value = user.nickname || user.username || '';
			(document.getElementById("profile-email") as any)?.setAttribute('value', user.email || '');
			(document.getElementById("profile-bio") as HTMLTextAreaElement).value = user.bio || '';
			(document.getElementById("profile-website") as HTMLInputElement).value = user.website || '';
			(document.getElementById("profile-github") as HTMLInputElement).value = user.github || '';
			(document.getElementById("profile-avatar") as HTMLInputElement).value = user.avatar || '';
			(document.getElementById("display-nickname") as HTMLElement).textContent = user.nickname || user.username;
			(document.getElementById("display-email") as HTMLElement).textContent = user.email;
			if (user.avatar) {
				(document.getElementById("avatar-preview") as HTMLImageElement).src = user.avatar;
			}
		} catch (e) {
			console.error("Failed to load profile:", e);
		}
	}

	document.getElementById("profile-avatar")?.addEventListener("input", (e) => {
		const url = (e.target as HTMLInputElement).value;
		if (url) (document.getElementById("avatar-preview") as HTMLImageElement).src = url;
	});

	document.getElementById("save-profile")?.addEventListener("click", async () => {
		const btn = document.getElementById("save-profile") as HTMLButtonElement;
		const origText = btn.textContent;
		btn.textContent = "保存中...";
		btn.disabled = true;
		try {
			const data = {
				nickname: (document.getElementById("profile-nickname") as HTMLInputElement).value,
				bio: (document.getElementById("profile-bio") as HTMLTextAreaElement).value,
				website: (document.getElementById("profile-website") as HTMLInputElement).value,
				github: (document.getElementById("profile-github") as HTMLInputElement).value,
				avatar: (document.getElementById("profile-avatar") as HTMLInputElement).value,
			};
			await updateProfile(data);
			
			// Change password if fields are filled
			const oldPwd = (document.getElementById("profile-old-password") as HTMLInputElement).value;
			const newPwd = (document.getElementById("profile-new-password") as HTMLInputElement).value;
			const confirmPwd = (document.getElementById("profile-confirm-password") as HTMLInputElement).value;
			if (oldPwd && newPwd) {
				if (newPwd !== confirmPwd) { alert("两次密码输入不一致"); return; }
				if (newPwd.length < 6) { alert("新密码至少6位"); return; }
				await changePassword({ old_password: oldPwd, new_password: newPwd });
			}

			btn.textContent = "已保存!";
			btn.className = "btn btn-success btn-sm";
			setTimeout(() => { btn.textContent = origText; btn.className = "btn btn-primary btn-sm"; }, 2000);
			
			// Clear password fields
			["profile-old-password","profile-new-password","profile-confirm-password"].forEach(id => {
				(document.getElementById(id) as HTMLInputElement).value = "";
			});
		} catch (e: any) {
			alert(e.message || "保存失败");
			btn.textContent = "保存失败";
			btn.className = "btn btn-error btn-sm";
			setTimeout(() => { btn.textContent = origText; btn.className = "btn btn-primary btn-sm"; }, 2000);
		} finally {
			btn.disabled = false;
		}
	});

	loadProfile();
</script>
