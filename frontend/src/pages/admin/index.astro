---
export const prerender = false;
import DashboardPanel from "@components/admin/DashboardPanel.svelte";
import SkeletonPage from "@components/admin/SkeletonPage.svelte";
import { i18n } from "@i18n";
import I18nKey from "@i18n/i18nKey";
import AdminLayout from "@layouts/admin.astro";
---

<AdminLayout title={i18n(I18nKey.adminDashboard)}>
	<fragment slot="actions">
		<button class="btn btn-ghost btn-sm" id="refresh-stats" type="button">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23,4 23,10 17,10"/><polyline points="1,20 1,14 7,14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
			{i18n(I18nKey.adminStatsRefresh)}
		</button>
		<a href="/admin/posts/new/" class="btn btn-primary btn-sm">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
			{i18n(I18nKey.adminCreate)}
		</a>
	</fragment>

	<div id="dashboard-wrapper" class="admin-page">
		<div id="dashboard-skeleton" class="dashboard-skeleton-wrap">
			<SkeletonPage cards={8} tableRows={6} />
		</div>

		<div id="dashboard-content" hidden>
			<!-- Welcome Banner — 赭石 + 靛青 双斜切渐变 -->
			<div class="welcome-banner">
				<div class="welcome-bg-decor">
					<div class="decor-circle c1"></div>
					<div class="decor-circle c2"></div>
					<div class="decor-circle c3"></div>
				</div>
				<div class="welcome-content">
					<div class="welcome-icon">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
					</div>
					<div>
						<h2 class="welcome-title">{i18n(I18nKey.adminWelcomeBack)}<span id="welcome-username">Admin</span></h2>
						<p class="welcome-desc" id="welcome-date"></p>
					</div>
				</div>
				<div class="welcome-actions">
					<a href="/admin/posts/new/" class="welcome-btn primary">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
						{i18n(I18nKey.adminCreate)}
					</a>
					<a href="/" class="welcome-btn" target="_blank">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
						{i18n(I18nKey.adminViewSite)}
					</a>
				</div>
			</div>

			<!-- Dashboard Panel: all charts + tables + health cards -->
			<DashboardPanel client:load id="dashboard-panel" />
		</div>
	</div>
</AdminLayout>

<style is:global>
	.admin-page { opacity: 0; transform: translateY(8px); transition: opacity 200ms ease, transform 200ms ease; }
	.admin-page.mounted { opacity: 1; transform: translateY(0); }

	.dashboard-skeleton-wrap { padding: 0; }

	/* Welcome banner — Ant Design Blue Gradient */
	.welcome-banner {
		background: linear-gradient(135deg, #1677ff 0%, #4096ff 100%);
		border-radius: 8px;
		padding: 24px 32px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		margin-bottom: 24px;
		position: relative;
		overflow: hidden;
		box-shadow: 0 6px 16px 0 rgba(22, 119, 255, 0.24), 0 3px 6px -4px rgba(22, 119, 255, 0.12);
		border: 1px solid rgba(145, 202, 255, 0.4);
	}
	.welcome-bg-decor { display: none; }
	.welcome-content { display: flex; align-items: center; gap: 18px; position: relative; z-index: 1; }
	.welcome-icon {
		width: 52px; height: 52px; border-radius: 8px;
		background: rgba(255, 255, 255, 0.18);
		border: 1px solid rgba(255, 255, 255, 0.25);
		display: flex; align-items: center; justify-content: center;
		color: #fff; flex-shrink: 0;
	}
	.welcome-icon svg { width: 24px; height: 24px; }
	.welcome-title {
		font-size: 20px; font-weight: 600; color: #fff;
		margin: 0 0 4px 0; letter-spacing: 0;
	}
	.welcome-title span { margin-left: 4px; opacity: 0.92; font-weight: 500; }
	.welcome-desc {
		font-size: 14px; color: rgba(255, 255, 255, 0.85);
		margin: 0; font-weight: 400; line-height: 1.5714;
	}
	.welcome-actions { display: flex; gap: 8px; position: relative; z-index: 1; flex-shrink: 0; }
	.welcome-btn {
		display: inline-flex; align-items: center; gap: 6px;
		padding: 6px 15px; height: 32px; border-radius: 4px;
		font-size: 14px; font-weight: 400;
		text-decoration: none; transition: all 0.2s cubic-bezier(0.645, 0.045, 0.355, 1);
		cursor: pointer; border: 1px solid rgba(255, 255, 255, 0.3);
		background: rgba(255, 255, 255, 0.15); color: #fff;
	}
	.welcome-btn:hover {
		background: rgba(255, 255, 255, 0.28);
		border-color: rgba(255, 255, 255, 0.55);
	}
	.welcome-btn.primary {
		background: #fff; color: #1677ff;
		box-shadow: 0 2px 0 rgba(0, 0, 0, 0.02);
		border-color: #fff;
		font-weight: 500;
	}
	.welcome-btn.primary:hover { background: #e6f4ff; color: #4096ff; border-color: #91caff; }
	.welcome-btn svg { width: 14px; height: 14px; }

	@media (max-width: 768px) {
		.welcome-banner {
			flex-direction: column; align-items: flex-start; padding: 20px;
		}
		.welcome-actions { width: 100%; }
		.welcome-btn { flex: 1; justify-content: center; }
	}
</style>

<script>
	import { getCurrentUser } from "@api/auth";

	export type {}; // ensure module

	// ========== Page mount transition ==========
	window.requestAnimationFrame(() => {
		window.requestAnimationFrame(() => {
			document.getElementById("dashboard-wrapper")?.classList.add("mounted");
		});
	});

	// ========== Welcome: username + date ==========
	(async () => {
		try {
			const user = await getCurrentUser();
			const el = document.getElementById("welcome-username");
			if (el && user) el.textContent = "，" + (user.nickname || user.username || "");
		} catch { /* empty */ }
	})();
	(() => {
		const el = document.getElementById("welcome-date");
		if (!el) return;
		const now = new Date();
		el.textContent = now.toLocaleDateString(undefined, {
			year: "numeric", month: "long", day: "numeric", weekday: "long",
		});
	})();

	// ========== Hide skeleton once DashboardPanel is mounted ==========
	// DashboardPanel has loading=false once data is ready; we use a simple polling approach
	// to detect hydration + first render, then swap out skeleton.
	const skel = document.getElementById("dashboard-skeleton");
	const content = document.getElementById("dashboard-content");
	let tries = 0;
	const tm = setInterval(() => {
		tries++;
		const panel = document.getElementById("dashboard-panel");
		// Svelte 5 renders a comment marker first; we look for first real child
		const hasRendered = panel && (panel.children.length > 0 || panel.shadowRoot?.children.length);
		if (hasRendered || tries >= 80) { // 4s safety net
			clearInterval(tm);
			if (skel) skel.hidden = true;
			if (content) content.hidden = false;
		}
	}, 50);

	// Refresh button — delegate to DashboardPanel's exported refresh() if possible,
	// otherwise re-trigger via visibility trick.
	document.getElementById("refresh-stats")?.addEventListener("click", () => {
		const panel: any = document.getElementById("dashboard-panel");
		if (panel && typeof panel.refresh === "function") {
			try { panel.refresh(); } catch { /* ignore */ }
		} else {
			// Fallback: force Svelte island to reload via re-attribution
			const parent = panel?.parentElement;
			if (panel && parent) {
				const clone = panel.cloneNode(true);
				parent.replaceChild(clone, panel);
			}
		}
		(window as any).showToast?.("数据已刷新", "success");
	});
</script>
