	}

	function tokenizeAndHighlight(code: string, colors: Record<string, string>) {
		const KEYWORDS = new Set(["async","function","const","let","var","await","if","else","throw","new","return","try","catch","for","while","of","in","true","false","null","undefined","import","export","from","class","extends","static","this","super","typeof","instanceof","void","delete","switch","case","break","continue","default","do","yield","debugger"]);
		const lines = code.split("\n");
		let html = "";
		for (let i = 0; i < lines.length; i++) {
			const line = lines[i];
			let lineHtml = "";
			let lastIndex = 0;
			TOKEN_REGEX.lastIndex = 0;
			let m: RegExpExecArray | null;
			while ((m = TOKEN_REGEX.exec(line)) !== null) {
				if (m.index > lastIndex) lineHtml += escapeHtml(line.slice(lastIndex, m.index));
				const raw = m[0];
				let cls = "fg";
				if (raw.startsWith("//") || raw.startsWith("/*")) cls = "comment";
				else if ((raw.startsWith('"') || raw.startsWith("'") || raw.startsWith("`")) && raw.length > 1) cls = "str";
				else if (/^\d/.test(raw)) cls = "num";
				else if (/^[A-Z]/.test(raw)) cls = "type";
				else if (KEYWORDS.has(raw)) cls = "keyword";
				else if (raw === "=>") cls = "op";
				else if (/^[=+\-*/%<>!&|?:^~]+$/.test(raw)) cls = "op";
				else if (/^[(){}\[\];,.]+$/.test(raw)) cls = "punct";
				else if (/^[a-zA-Z_$]/.test(raw)) {
					const nextIdx = m.index + raw.length;
					const rest = line.slice(nextIdx);
					const afterMatch = rest.match(/^\s*\(/);
					if (afterMatch) cls = "fn";
				}
				lineHtml += `<span class="tok-${cls}" style="color:${colors[cls]}">${escapeHtml(raw)}</span>`;
				lastIndex = m.index + raw.length;
			}
			if (lastIndex < line.length) lineHtml += escapeHtml(line.slice(lastIndex));
			const lineNum = String(i + 1).padStart(2, " ");
			html += `<span style="display:inline-flex;gap:12px;min-width:100%;"><span style="color:${colors.comment};user-select:none;min-width:28px;text-align:right;opacity:0.7;">${lineNum}</span><span style="flex:1;">${lineHtml || "&nbsp;"}</span></span>`;
			if (i < lines.length - 1) html += "\n";
		}
		return html;
	}
	function escapeHtml(s: string) {
		return s.replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"} as any)[c]);
	}
	function getCurrentPreviewMode(): "light" | "dark" {
		const w = document.getElementById("code-preview-wrapper");
		return w?.classList.contains("code-preview-dark") ? "dark" : "light";
	}
	function refreshCodePreview() {
		const mode = getCurrentPreviewMode();
		const lightSel = document.getElementById("code-theme-light-select") as HTMLSelectElement | null;
		const darkSel = document.getElementById("code-theme-dark-select") as HTMLSelectElement | null;
		const themeName = mode === "light" ? (lightSel?.value || "one-light") : (darkSel?.value || "one-dark-pro");
		const colors = buildPreviewColors(mode, themeName);
		const pre = document.getElementById("code-preview-pre");
		const code = document.getElementById("code-preview-code");
		const wrapper = document.getElementById("code-preview-wrapper");
		const header = wrapper?.querySelector(".code-preview-header") as HTMLElement | null;
		if (pre) {
			pre.style.backgroundColor = colors.bg;
		}
		if (header) {
			header.style.backgroundColor = mode === "dark"
				? buildPreviewColors("dark", "one-dark-pro").bg
				: buildPreviewColors("light", "one-light").bg;
			header.style.backgroundColor = colors.bg;
		}
		if (code) {
			code.style.color = colors.fg;
			code.innerHTML = tokenizeAndHighlight(PREVIEW_CODE_SAMPLE, colors);
		}
	}
	function wireCodePreview() {
		const lightBtn = document.getElementById("code-preview-light-btn");
		const darkBtn = document.getElementById("code-preview-dark-btn");
		const wrapper = document.getElementById("code-preview-wrapper");
		const lightSel = document.getElementById("code-theme-light-select") as HTMLSelectElement | null;
		const darkSel = document.getElementById("code-theme-dark-select") as HTMLSelectElement | null;

		function setMode(mode: "light" | "dark") {
			wrapper?.classList.remove("code-preview-light", "code-preview-dark");
			wrapper?.classList.add(mode === "dark" ? "code-preview-dark" : "code-preview-light");
			lightBtn?.classList.toggle("code-preview-mode-active", mode === "light");
			darkBtn?.classList.toggle("code-preview-mode-active", mode === "dark");
			refreshCodePreview();
		}
		lightBtn?.addEventListener("click", () => setMode("light"));
		darkBtn?.addEventListener("click", () => setMode("dark"));
		lightSel?.addEventListener("change", () => { if (getCurrentPreviewMode() === "light") refreshCodePreview(); });
		darkSel?.addEventListener("change", () => { if (getCurrentPreviewMode() === "dark") refreshCodePreview(); });

		refreshCodePreview();
	}

	// ========== 绑定事件 ==========
	function wireEvents() {
		const btnSave = document.getElementById("btn-save") as HTMLButtonElement;
		const btnReset = document.getElementById("btn-reset") as HTMLButtonElement;
		const txtSave = document.getElementById("btn-save-text")!;

		// Input / Textarea / Select
		document.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(
			"input[data-group][data-field], select[data-group][data-field], textarea[data-group][data-field]"
		).forEach((el) => {
			const onChange = () => {
				const g = el.dataset.group as SettingGroup;
				const k = el.dataset.field!;
				if (!data[g]) data[g] = {};
				if ((el as HTMLInputElement).type === "checkbox") {
					data[g][k] = (el as HTMLInputElement).checked;
				} else if ((el as HTMLInputElement).type === "number") {
					const v = (el as HTMLInputElement).value;
					data[g][k] = v === "" ? "" : Number(v);
				} else {
					data[g][k] = el.value;
				}
				dirty[g] = true;
				btnSave.disabled = false;
				btnSave.classList.remove("antd-btn-success", "antd-btn-error");
				txtSave.textContent = "保存设置";
			};
			el.addEventListener("input", onChange);
			el.addEventListener("change", onChange);
		});

		// Switch buttons
		document.querySelectorAll<HTMLButtonElement>("button.antd-switch[data-group][data-field]").forEach((btn) => {
			btn.addEventListener("click", () => {
				const g = btn.dataset.group as SettingGroup;
				const k = btn.dataset.field!;
				const checked = !btn.classList.contains("antd-switch-checked");
				btn.classList.toggle("antd-switch-checked", checked);
				if (!data[g]) data[g] = {};
				data[g][k] = checked;
				dirty[g] = true;
				btnSave.disabled = false;
				btnSave.classList.remove("antd-btn-success", "antd-btn-error");
				txtSave.textContent = "保存设置";
			});
		});

		// Reset
		btnReset.addEventListener("click", () => {
			if (confirm("确认重置为加载时的原始值？未保存的更改将丢失。")) {
				// clone initial data back
				GROUP_ORDER.forEach((g) => {
					data[g] = initialData[g] ? JSON.parse(JSON.stringify(initialData[g])) : {};
					dirty[g] = false;
				});
				renderGrid();
				btnSave.disabled = false;
				btnSave.classList.remove("antd-btn-success", "antd-btn-error");
				txtSave.textContent = "保存设置";
				(window as any).showToast?.("已重置为上次加载的值", "info");
			}
		});

		// Save All - 遍历所有 dirty groups，逐一调用 updateSettingsGroup
		btnSave.addEventListener("click", async () => {
			const origText = "保存设置";
			btnSave.disabled = true;
			btnSave.classList.remove("antd-btn-success", "antd-btn-error");
			txtSave.textContent = "保存中...";

			const dirtyGroups = GROUP_ORDER.filter((g) => dirty[g] === true);
			let failed = 0;
			let ok = 0;

			try {
				for (const g of dirtyGroups) {
					const payload = data[g] || {};
					try {
						await updateSettingsGroup(g, payload);
						dirty[g] = false;
						ok++;
					} catch (e: any) {
						console.error(`save group ${g} failed:`, e);
						failed++;
					}
				}

				// update initial data after successful save
				if (ok > 0) {
					GROUP_ORDER.forEach((g) => {
						if (dirty[g] === false) {
							initialData[g] = data[g] ? JSON.parse(JSON.stringify(data[g])) : {};
						}
					});
				}

				if (failed === 0) {
					btnSave.classList.add("antd-btn-success");
					txtSave.textContent = ok > 0 ? "保存成功" : "没有需要保存的更改";
					(window as any).showToast?.(ok > 0 ? "所有设置已保存成功" : "没有需要保存的更改", "success");
				} else {
					btnSave.classList.add("antd-btn-error");
					txtSave.textContent = `部分失败 (${ok}成功 / ${failed}失败)`;
					(window as any).showToast?.(`${ok} 组保存成功，${failed} 组失败，请查看控制台`, "error");
				}
			} catch (e: any) {
				console.error("save settings failed:", e);
				btnSave.classList.add("antd-btn-error");
				txtSave.textContent = "保存失败";
				const msg = e?.message || e?.detail || "未知错误";
				(window as any).showToast?.(`保存失败：${msg}`, "error");
			} finally {
				setTimeout(() => {
					btnSave.classList.remove("antd-btn-success", "antd-btn-error");
					txtSave.textContent = origText;
					btnSave.disabled = false;
				}, 2000);
			}
		});
	}

	// ========== 初始加载 ==========
	async function loadAll() {
		try {
			const res = await getAllSettings();
			const groups = (res?.groups as DataMap | undefined) || ({} as DataMap);
			GROUP_ORDER.forEach((g) => {
				const src = typeof groups[g] === "object" && groups[g] != null ? groups[g] : {};
				data[g] = JSON.parse(JSON.stringify(src));
				initialData[g] = JSON.parse(JSON.stringify(src));
				dirty[g] = false;
			});
		} catch (e) {
			console.warn("getAllSettings failed, falling back to empty:", e);
			GROUP_ORDER.forEach((g) => {
				data[g] = {};
				initialData[g] = {};
				dirty[g] = false;
			});
		} finally {
			document.getElementById("settings-skeleton")!.hidden = true;
			const body = document.getElementById("settings-body")!;
			body.hidden = false;
			renderGrid();
		}
	}

	loadAll();
</script>
