	// ========== 代码高亮实时预览 ==========
	const PREVIEW_CODE_SAMPLE = `// JavaScript 异步示例代码
async function fetchUserPosts(userId) {
  const baseUrl = 'https://api.example.com';
  const timeout = 5000;

  // 并行请求：用户信息 + 文章列表
  const [userRes, postsRes] = await Promise.all([
    fetch(\`\${baseUrl}/users/\${userId}\`, {
      method: 'GET',
      headers: { 'Accept': 'application/json' },
    }),
    fetch(\`\${baseUrl}/posts?userId=\${userId}&limit=10\`),
  ]);

  if (!userRes.ok || !postsRes.ok) {
    const status = Math.max(userRes.status, postsRes.status);
    throw new Error(\`Request failed with status \${status}\`);
  }

  const [user, posts] = await Promise.all([
    userRes.json(),
    postsRes.json(),
  ]);

  // 组合数据并过滤草稿
  const result = {
    user: {
      id: user.id,
      name: user.name,
      email: user.email,
    },
    posts: posts
      .filter(p => p.published === true && !p.isDraft)
      .map(p => ({
        id: p.id,
        title: p.title,
        summary: p.summary?.slice(0, 120) ?? '',
        date: new Date(p.createdAt).toISOString().slice(0, 10),
      })),
  };

  console.debug('[fetchUserPosts] loaded:', {
    user: result.user.name,
    postCount: result.posts.length,
  });
  return result;
}

// 使用示例
(async () => {
  try {
    const data = await fetchUserPosts(42);
    console.log('文章数量:', data.posts.length);
  } catch (err) {
    console.error('加载失败:', err instanceof Error ? err.message : err);
  }
})();`;

	const TOKEN_REGEX = /(\/\/[^\n]*|\/\*[\s\S]*?\*\/|"(?:\\.|[^"\\])*"|'(?:\\.|[^'\\])*'|`(?:\\.|[^`\\])*`|\b(?:async|function|const|let|var|await|if|else|throw|new|return|try|catch|for|while|of|in|true|false|null|undefined|import|export|from|class|extends|static|this|super|typeof|instanceof|void|delete|switch|case|break|continue|default|do|yield|debugger)\b|\b\d+(?:\.\d+)?\b|\b[A-Z][A-Za-z0-9_]*\b|=>|[=+\-*/%<>!&|?:^~]+|[(){}\[\];,.])/g;

