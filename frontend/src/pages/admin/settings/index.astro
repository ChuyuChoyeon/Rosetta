				light: { bg: "#fbfbfb", fg: "#403f53", keyword: "#994cc3", str: "#318288", num: "#aa0982", comment: "#989fb1", fn: "#4876d6", type: "#c96765", op: "#403f53", punct: "#403f53" },
				dark: { bg: "#011627", fg: "#d6deeb", keyword: "#c792ea", str: "#ecc48d", num: "#f78c6c", comment: "#637777", fn: "#82aaff", type: "#addb67", op: "#d6deeb", punct: "#d6deeb" },
