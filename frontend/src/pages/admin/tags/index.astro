---
export const prerender = false;
import AdminLayout from "@layouts/admin.astro";
---
<AdminLayout title="标签管理">
	<fragment slot="actions">
		<div class="table-actions">
			<button class="btn btn-primary btn-sm" onclick="showAddModal()">
				<svg style="width:15px;height:15px" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
				新建标签
			</button>
		</div>
	</fragment>

	<div class="table-wrapper">
		<div class="table-header">
			<div style="display:flex;align-items:center;gap:14px;">
				<h3 class="table-title">所有标签</h3>
				<span class="badge badge-ghost" id="tags-count">0 个</span>
			</div>
		</div>
		<div class="table-scroll">
			<table class="table">
				<thead>
					<tr>
						<th style="padding-left:24px;">名称</th>
						<th>Slug</th>
						<th>颜色</th>
						<th>文章数</th>
						<th>状态</th>
						<th>创建时间</th>
						<th style="width:130px;padding-right:24px;">操作</th>
					</tr>
				</thead>
				<tbody id="tags-table-body">
					<tr>
						<td colspan="7" style="text-align:center;padding:48px 24px;color:hsl(var(--bc)/0.5);">
							<div style="display:flex;flex-direction:column;align-items:center;gap:10px;">
								<svg style="width:36px;height:36px;opacity:0.4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
								<span>加载中...</span>
							</div>
						</td>
					</tr>
				</tbody>
			</table>
		</div>
	</div>
</AdminLayout>

<div class="admin-modal-overlay" id="tag-modal">
	<div class="admin-modal">
		<div class="admin-modal-header">
			<h3 class="admin-modal-title" id="modal-title">新建标签</h3>
			<button class="admin-modal-close" onclick="closeModal()" type="button">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
			</button>
		</div>
		<div class="admin-modal-body">
			<div class="admin-form-group">
				<label class="admin-form-label" for="tag-name">名称</label>
				<input type="text" id="tag-name" class="admin-input" placeholder="标签名称">
			</div>
			<div class="admin-form-group">
				<label class="admin-form-label" for="tag-slug">Slug <span style="color:hsl(var(--bc)/0.4);font-weight:400;">（可选，留空自动生成）</span></label>
				<input type="text" id="tag-slug" class="admin-input" placeholder="例如: javascript">
			</div>
			<div class="admin-form-group">
				<label class="admin-form-label" for="tag-color">颜色 <span style="color:hsl(var(--bc)/0.4);font-weight:400;">（可选）</span></label>
				<input type="color" id="tag-color" class="admin-input admin-input-color" value="#06b6d4">
			</div>
		</div>
		<div class="admin-modal-footer">
			<button class="btn btn-ghost btn-sm" onclick="closeModal()" type="button">取消</button>
			<button class="btn btn-primary btn-sm" onclick="saveTag()" type="button">保存</button>
		</div>
	</div>
</div>

<script>
	// @ts-nocheck
	import { getTags, createTag, updateTag, deleteTag, type Tag } from "@api/blog";

	let editingId: number | null = null;

	function formatDate(dateStr: string): string {
		if (!dateStr) return "-";
		return new Date(dateStr).toLocaleDateString('zh-CN');
	}

	async function loadTags() {
		const tbody = document.getElementById("tags-table-body") as HTMLElement;
		try {
			const tags = await getTags();
			const count = tags.length || 0;
			const countEl = document.getElementById("tags-count");
			if (countEl) countEl.textContent = `${count} 个`;

			if (tags.length === 0) {
				tbody.innerHTML = `
					<tr>
						<td colspan="7" style="text-align:center;padding:56px 24px;">
							<div class="empty-state">
								<div class="empty-title">暂无标签</div>
								<div class="empty-desc">点击右上角创建第一个标签</div>
								<button class="btn btn-primary btn-sm" style="margin-top:8px;" onclick="showAddModal()">
									<svg style="width:15px;height:15px" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
									新建标签
								</button>
							</div>
						</td>
					</tr>
				`;
				return;
			}

			tbody.innerHTML = tags.map((t: Tag) => `
				<tr>
					<td style="padding-left:24px;">
						<div style="display:flex;align-items:center;gap:12px;">
							<div style="width:36px;height:36px;border-radius:10px;display:flex;align-items:center;justify-content:center;background:${t.color || 'hsl(var(--b2))'};color:white;font-weight:700;font-size:13px;">
								${t.name.charAt(0).toUpperCase()}
							</div>
							<span style="font-weight:600;">${t.name}</span>
						</div>
					</td>
					<td style="font-family:ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;font-size:12.5px;color:hsl(var(--bc)/0.55);">${t.slug}</td>
					<td>
						<div style="display:flex;align-items:center;gap:10px;">
							<div style="width:24px;height:24px;border-radius:6px;background:${t.color || 'hsl(var(--b3))'};box-shadow:0 0 0 1px hsl(var(--bc)/0.08);"></div>
							<span style="font-size:12px;color:hsl(var(--bc)/0.5);font-family:ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;">${t.color || '-'}</span>
						</div>
					</td>
					<td><span class="badge badge-ghost">${t.post_count || 0}</span></td>
					<td>${t.is_active ? '<span class="badge badge-success">启用</span>' : '<span class="badge badge-warning">禁用</span>'}</td>
					<td style="font-size:12.5px;color:hsl(var(--bc)/0.6);">${formatDate(t.created_at)}</td>
					<td style="padding-right:24px;">
						<div class="action-buttons">
							<button class="btn btn-ghost btn-icon btn-sm" onclick="editTag(${t.id}, ${JSON.stringify(t.name).replace(/"/g, '&quot;')}, ${JSON.stringify(t.slug).replace(/"/g, '&quot;')}, ${JSON.stringify(t.color || '#06b6d4').replace(/"/g, '&quot;')})" title="编辑">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
							</button>
							<button class="btn btn-ghost btn-icon btn-sm" style="color:hsl(var(--er));" onclick="deleteTagRow(${t.id})" title="删除">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3,6 5,6 21,6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
							</button>
						</div>
					</td>
				</tr>
			`).join("");
		} catch (e) {
			console.error(e);
			tbody.innerHTML = `
				<tr>
					<td colspan="7" style="text-align:center;padding:48px 24px;color:hsl(var(--er));">
						<div style="display:flex;flex-direction:column;align-items:center;gap:10px;">
							<svg style="width:36px;height:36px;opacity:0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
							<span>加载失败，请刷新重试</span>
						</div>
					</td>
				</tr>
			`;
		}
	}

	window.showAddModal = () => {
		editingId = null;
		(document.getElementById("modal-title") as HTMLElement).textContent = "新建标签";
		(document.getElementById("tag-name") as HTMLInputElement).value = "";
		(document.getElementById("tag-slug") as HTMLInputElement).value = "";
		(document.getElementById("tag-color") as HTMLInputElement).value = "#06b6d4";
		(document.getElementById("tag-modal") as HTMLElement).classList.add("open");
	};

	window.editTag = (id: number, name: string, slug: string, color: string) => {
		editingId = id;
		(document.getElementById("modal-title") as HTMLElement).textContent = "编辑标签";
		(document.getElementById("tag-name") as HTMLInputElement).value = name;
		(document.getElementById("tag-slug") as HTMLInputElement).value = slug;
		(document.getElementById("tag-color") as HTMLInputElement).value = color;
		(document.getElementById("tag-modal") as HTMLElement).classList.add("open");
	};

	window.closeModal = () => {
		(document.getElementById("tag-modal") as HTMLElement).classList.remove("open");
	};

	window.saveTag = async () => {
		const name = (document.getElementById("tag-name") as HTMLInputElement).value;
		if (!name) { alert("请输入标签名称"); return; }
		const data = {
			name,
			slug: (document.getElementById("tag-slug") as HTMLInputElement).value || undefined,
			color: (document.getElementById("tag-color") as HTMLInputElement).value,
		};
		try {
			if (editingId) {
				await updateTag(editingId, data);
			} else {
				await createTag(data);
			}
			closeModal();
			loadTags();
		} catch (e) {
			alert("保存失败");
		}
	};

	window.deleteTagRow = async (id: number) => {
		if (!confirm("确定要删除这个标签吗？此操作无法撤销。")) return;
		try {
			await deleteTag(id);
			loadTags();
		} catch (e) {
			alert("删除失败");
		}
	};

	loadTags();
</script>
