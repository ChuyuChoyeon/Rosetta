---
import PostEditorForm from "@components/admin/PostEditorForm.svelte";
import AdminLayout from "@layouts/admin.astro";
---
<AdminLayout title="新建文章">
	<!--
		SSR 注入初始数据占位：
		- 不直接在 frontmatter 调用 getCategories/getTags：因为 Admin API 需要鉴权 token
		  （localStorage 里 SSR 读不到），SSR 环境直连会 401。
		- 所有数据交给 PostEditorForm.svelte 客户端 onMount 时自行懒加载。
	-->
	<script
		type="application/json"
		id="rosetta-editor-initial"
		is:inline
	>{"isNew":true}</script>

	<main class="pef-astro-shell">
		<PostEditorForm client:only="svelte" />
	</main>
</AdminLayout>

<style>
	.pef-astro-shell {
		min-height: calc(100vh - var(--admin-header-h, 64px));
	}
</style>
