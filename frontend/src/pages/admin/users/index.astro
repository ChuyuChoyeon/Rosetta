---
import AdminUserList from "@components/admin/users/AdminUserList.svelte";
import AdminLayout from "@layouts/admin.astro";
---
<AdminLayout title="用户管理">
	<fragment slot="actions">
		<div class="table-actions">
			<button class="btn btn-ghost btn-sm" type="button" onclick="void 0" title="批量导出（占位功能）">
				<svg style="width:15px;height:15px" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
					<polyline points="7 10 12 15 17 10"/>
					<line x1="12" y1="15" x2="12" y2="3"/>
				</svg>
				批量导出
			</button>
		</div>
	</fragment>
	<main slot="content">
		<AdminUserList client:only="svelte" />
	</main>
</AdminLayout>
