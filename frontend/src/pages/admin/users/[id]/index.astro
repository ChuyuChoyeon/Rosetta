---
export const prerender = false;
import AdminUserDetailDrawer from "@components/admin/users/AdminUserDetailDrawer.svelte";
import AdminLayout from "@layouts/admin.astro";

const userId = Number(Astro.params.id);
---
<AdminLayout title="用户详情" breadcrumbs={[{ label: "后台", href: "/admin/" }, { label: "用户管理", href: "/admin/users/" }, { label: "详情" }]}>
	<script
		type="application/json"
		id="rosetta-user-detail-initial"
		is:inline
	>{JSON.stringify({ userId })}</script>
	<main slot="content">
		<AdminUserDetailDrawer client:only="svelte" userId={userId} open={true} />
	</main>
</AdminLayout>
