---
import Comment from "@components/comment/index.astro";
import Markdown from "@components/common/Markdown.astro";
import EncryptedPost from "@components/features/EncryptedPost.astro";
import KatexManager from "@components/features/KatexManager.astro";
import License from "@components/misc/License.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getRelatedPosts, getSortedPosts } from "@utils/content-utils";
import {
	getFileDirFromPath,
	getPostUrlBySlug,
	removeFileExtension,
} from "@utils/url-utils";
import { Icon } from "astro-icon/components";
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import {
	type Post as ApiPost,
	getPostById,
	getPostBySlug,
	getPosts,
} from "@/api/blog";
import CoverImage from "@/components/common/CoverImage.astro";
import PostMetadata from "@/components/layout/PostMeta.astro";
import RecommendedPost from "@/components/misc/RecommendedPost.astro";
import SharePoster from "@/components/misc/SharePoster.svelte";
import { loadDynamicConfig } from "@/utils/dynamic-config";

const dynamicCfg = await loadDynamicConfig();
const coverImageConfig = dynamicCfg.coverImage;
const licenseConfig = dynamicCfg.license;
const profileConfig = dynamicCfg.profile;
const siteConfig = {
	title: dynamicCfg.site.title,
	site_url: dynamicCfg.site.siteUrl,
	siteStartDate: dynamicCfg.site.siteStartDate,
	description: dynamicCfg.site.description,
	themeColor: { hue: 165, defaultMode: "system" as const },
	pageWidth: 100,
	card: { border: false, followTheme: false },
	lang:
		typeof localStorage !== "undefined"
			? localStorage.getItem("lang") || "zh_CN"
			: "zh_CN",
	post: {
		rehypeCallouts: {
			theme: "github" as const,
			enablePythonMarkdownAdmonitions: false,
		},
		showLastModified: dynamicCfg.postDetail.showLastModified,
		outdatedThreshold: dynamicCfg.postDetail.outdatedThreshold,
		sharePoster: dynamicCfg.postDetail.enableSharePoster,
		generateOgImages: dynamicCfg.postDetail.generateOgImages,
	},
	postListLayout: dynamicCfg.postListLayout,
	imageOptimization: dynamicCfg.imageOpt,
	pagination: dynamicCfg.pagination,
	categoryBar: dynamicCfg.categoryBarEnabled,
	foldArticle: dynamicCfg.archiveFoldOldArticles,
	pages: dynamicCfg.pages,
	bangumi: dynamicCfg.bangumi,
	anime: dynamicCfg.anime,
	navbar: {
		logo: { type: "image" as const, value: "", alt: "" },
		title: dynamicCfg.site.title,
		widthFull: false,
		menuAlign: "center" as const,
		followTheme: false,
		stickyNavbar: true,
	},
	favicon: [],
	subtitle: "",
	timezone: "Asia/Shanghai",
	keywords: dynamicCfg.site.keywords,
	siteStartDate_backup: dynamicCfg.site.siteStartDate,
};
const sponsorConfig = dynamicCfg.sponsorPage;

import { formatDateToYYYYMMDD } from "@/utils/date-utils";
import { getApiUrlList, processCoverImageSync } from "@/utils/image-utils";
import { renderMarkdown } from "@/utils/markdown-renderer";
import { url } from "@/utils/url-utils";

// ============================================================
// 关键修复：强制文章详情页走动态 SSR（prerender=false），
// 避免 getStaticPaths 仅枚举有限条目（或 SSR 出错返回空数组）导致
// 其它 slug/id 直接被 Astro 判定为 404，路由落到顶层 [...page] catch-all
// 或通用 404 页面，出现 "URL 正确但内容是404页面" 的 Bug。
//
// 同时在 hybrid/server 模式下保留 prerender=false，避免构建期未登录访问
// 后端 API 失败（如密码保护文章等）时构建产物遗漏内容页。
// ============================================================
export const prerender = false;

export async function getStaticPaths() {
	// prerender=false 时 getStaticPaths 仅保留作为 build/dev 期的缓存热身 +
	// 旧版兼容；真正的路由匹配由 SSR 兜底处理（fallback=always 的效果）。
	// 注：prerender=false 页面不强制返回 paths，返回空数组节省构建时间。
	return [];
}

// 从 props 或 URL 参数（SSR fallback）获取文章
const urlSlug = Array.isArray((Astro.params as any).slug)
	? (Astro.params as any).slug.join("/")
	: ((Astro.params as any).slug as string) || "";

let { apiPost } = Astro.props as { apiPost?: ApiPost };

// 静态路径未命中时（比如 DEV 模式下未枚举到的 slug、数字 ID），按 URL 参数回查
if (!apiPost && urlSlug) {
	// 尝试 1：直接按 slug 取
	try {
		const t = await getPostBySlug(urlSlug);
		apiPost = t;
	} catch (e: any) {
		console.warn(`[posts] Fetch by slug failed (slug=${urlSlug}):`, e);
	}
	// 尝试 2：若 URL 是纯数字（兼容 /posts/<id>/ 的旧格式），按 id 回查
	if (!apiPost && /^\d+$/.test(urlSlug)) {
		try {
			const t = await getPostById(Number(urlSlug));
			apiPost = t;
		} catch (e: any) {
			console.warn(`[posts] Fetch by id failed (id=${urlSlug}):`, e);
		}
	}
}

// 找不到文章 → 直接渲染 404 内容（Astro.redirect 的 302 在 dev+Swup 下会触发错误的 404 标题，内容对不上）
const notFound = !apiPost;
// 404 时：设置真实 HTTP 404 状态，并提供空的占位数据让 template 不崩溃
if (notFound) {
	Astro.response.status = 404;
	Astro.response.headers.set("X-Rosetta-Post-Not-Found", "1");
}

const resolvedPost = apiPost;

// 从API获取完整文章数据（包含content）—— 仅在找到文章时执行
let fullPost: any = apiPost;
const _slugForFetch = apiPost?.slug;
if (!notFound && fullPost && !fullPost.content && _slugForFetch) {
	try {
		fullPost = await getPostBySlug(_slugForFetch);
	} catch (e) {
		console.warn(`[posts] Failed to fetch full post for ${_slugForFetch}:`, e);
	}
}

// 渲染Markdown内容 —— 仅在找到文章时执行
const rendered = notFound
	? { html: "", headings: [] as any[] }
	: await renderMarkdown(fullPost?.content || "");
const renderedContentHtml = rendered.html;
const headings = rendered.headings;

// 日期工具：保证任何 Date 都是有效的（无效时 fallback 到当前时间）
function safeDate(input: unknown): Date {
	if (input instanceof Date && !Number.isNaN(input.getTime())) return input;
	if (typeof input === "string" && input.trim().length > 0) {
		let s = input.trim();
		// 兼容 SQLite 格式 "YYYY-MM-DD HH:mm:ss" -> "YYYY-MM-DDTHH:mm:ss"
		if (/^\d{4}-\d{2}-\d{2} \d{2}:\d{2}(:\d{2})?$/.test(s)) {
			s = s.replace(" ", "T");
		}
		const d = new Date(s);
		if (!Number.isNaN(d.getTime())) return d;
	}
	if (typeof input === "number" && Number.isFinite(input)) {
		const d = new Date(input);
		if (!Number.isNaN(d.getTime())) return d;
	}
	return new Date();
}
function safeDateOrUndef(input: unknown): Date | undefined {
	if (!input) return undefined;
	const d = safeDate(input);
	// 当 input 是坏值时，safeDate 会返回 Date.now()。这里用更严格的判断：
	// 如果转换后的 Date 对应的字符串与 input 完全不相关，则返回 undefined
	if (typeof input === "string" && input.trim().length > 0) {
		let s = input.trim();
		if (/^\d{4}-\d{2}-\d{2} \d{2}:\d{2}(:\d{2})?$/.test(s))
			s = s.replace(" ", "T");
		const d2 = new Date(s);
		if (Number.isNaN(d2.getTime())) return undefined;
		return d2;
	}
	return d;
}

// 转换API数据为页面所需格式（处理字段名差异）—— 未找到文章时提供占位值
const excerpt = notFound
	? ""
	: (fullPost as any).excerpt || fullPost.summary || "";
const isPublished = notFound
	? true
	: (fullPost.is_published ?? fullPost.status === "published");
const wordCount = notFound
	? 0
	: (fullPost as any).word_count || (fullPost.content || "").length;

const entry = {
	id: notFound ? "__not_found__" : fullPost.slug,
	slug: notFound ? "" : fullPost.slug,
	body: notFound ? "" : fullPost.content || "",
	collection: "posts" as const,
	filePath: "",
	data: {
		title: notFound ? "404 - 页面未找到" : fullPost.title,
		description: notFound ? "页面未找到" : excerpt || fullPost.title,
		summary: notFound ? "" : excerpt,
		subtitle: notFound ? null : fullPost.subtitle,
		published: notFound
			? new Date()
			: safeDate(fullPost.published_at || fullPost.created_at || Date.now()),
		updated: notFound ? undefined : safeDateOrUndef(fullPost.updated_at),
		tags: notFound
			? []
			: (fullPost.tags || []).map((t: any) =>
					typeof t === "string" ? t : t.name,
				),
		category: notFound ? null : fullPost.category?.name || null,
		categorySlug: notFound ? undefined : fullPost.category?.slug,
		cover: notFound
			? undefined
			: fullPost.cover_image
				? { src: fullPost.cover_image, alt: fullPost.title }
				: undefined,
		image: notFound ? undefined : fullPost.cover_image,
		author: notFound
			? ""
			: fullPost.author?.nickname || fullPost.author?.username,
		sourceLink: notFound ? undefined : fullPost.source_url,
		source: notFound ? undefined : fullPost.source,
		pinned: notFound ? false : fullPost.is_pinned,
		draft: notFound ? false : !isPublished,
		featured: notFound ? false : ((fullPost as any).is_featured ?? false),
		password: notFound ? null : fullPost.password,
		passwordHint: notFound ? "" : (fullPost as any).password_hint || "",
		nextSlug: undefined as string | undefined,
		nextTitle: undefined as string | undefined,
		prevSlug: undefined as string | undefined,
		prevTitle: undefined as string | undefined,
		readingTime: notFound
			? 0
			: fullPost.reading_time || Math.ceil(wordCount / 300),
		words: wordCount,
		views: notFound ? 0 : fullPost.views,
		likes: notFound
			? 0
			: ((fullPost as any).likes ?? fullPost.likes_count ?? 0),
		commentsCount: notFound ? 0 : fullPost.comments_count,
		comment: notFound ? false : fullPost.allow_comments,
		lang: siteConfig.lang,
		licenseName: notFound
			? undefined
			: (fullPost as any).license_name || undefined,
		licenseUrl: notFound
			? undefined
			: (fullPost as any).license_url || undefined,
	},
};

// 获取前后文章
try {
	const sorted = await getSortedPosts();
	const idx = sorted.findIndex((p: any) => p.slug === entry.slug);
	if (idx >= 0) {
		if (idx > 0) {
			entry.data.prevSlug = sorted[idx - 1].slug;
			entry.data.prevTitle = sorted[idx - 1].data.title;
		}
		if (idx < sorted.length - 1) {
			entry.data.nextSlug = sorted[idx + 1].slug;
			entry.data.nextTitle = sorted[idx + 1].data.title;
		}
	}
} catch (e) {
	console.warn("[posts] Failed to get prev/next posts:", e);
}

// 处理remarkPluginFrontmatter数据（用于字数和阅读时间）
const remarkPluginFrontmatter = {
	words: entry.data.words || 0,
	minutes: entry.data.readingTime || Math.ceil((entry.data.words || 0) / 300),
};

const bannerPostMeta = {
	title: entry.data.title,
	description: entry.data.description,
	published: entry.data.published,
	updated: entry.data.updated,
	words: remarkPluginFrontmatter.words,
	minutes: remarkPluginFrontmatter.minutes,
};

// 处理随机图：如果image为"api"，则从配置的API获取随机图
const processedImage = processCoverImageSync(entry.data.image || "", entry.id);
const apiUrls = getApiUrlList(entry.data.image || "", entry.id);
const showPostCover = Boolean(processedImage && coverImageConfig.enableInPost);
const usePostCoverOverlay =
	showPostCover && (coverImageConfig.enableInPostOverlay ?? true);

const getDirectImageUrl = (src: string | undefined): string | null => {
	if (!src) return null;
	if (
		src.startsWith("http://") ||
		src.startsWith("https://") ||
		src.startsWith("//") ||
		src.startsWith("data:")
	) {
		return src;
	}
	return src.startsWith("/") ? url(src) : null;
};

// 海报优先复用页面上已经优化过的图片，本地源路径不再单独导入。
const posterCoverUrl = showPostCover ? null : getDirectImageUrl(processedImage);
const posterCoverSelector = showPostCover ? "#post-cover img" : null;
const posterAvatarUrl = getDirectImageUrl(profileConfig.avatar);
const posterAvatarSelector = profileConfig.avatar
	? ".profile-avatar-image img"
	: null;

dayjs.extend(utc);

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	headline: entry.data.title,
	description: entry.data.description || entry.data.title,
	keywords: entry.data.tags,
	author: {
		"@type": "Person",
		name: profileConfig.name,
		url: Astro.site,
	},
	datePublished: formatDateToYYYYMMDD(entry.data.published),
	inLanguage: entry.data.lang
		? entry.data.lang.replace("_", "-")
		: siteConfig.lang.replace("_", "-"),
};

const relatedPosts = await getRelatedPosts(entry as any, 5);
---

<MainGridLayout
  banner={processedImage}
  title={entry.data.title}
  description={entry.data.description}
  lang={entry.data.lang}
  setOGTypeArticle={true}
  postSlug={entry.id}
  postCategory={entry.data.category || undefined}
  encrypted={!!entry.data.password}
  bannerPostMeta={bannerPostMeta}
>
  <!-- KaTeX 按需加载 - 仅在文章页面 -->
  <KatexManager slot="head" />
  
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(jsonLd)}
  />
  <div
    class="flex w-full rounded-(--radius-large) overflow-hidden relative mb-4"
  >
    <div
      id="post-container"
      class:list={[
        "card-base z-10 px-6 md:px-9 pt-6 pb-4 relative w-full ",
        {},
      ]}
    >
      {
        usePostCoverOverlay && processedImage && (
          <div class="-mx-6 md:-mx-9 -mt-6 mb-6 h-48 md:h-64 relative onload-animation">
            <CoverImage
              id="post-cover"
              src={processedImage}
              basePath={getFileDirFromPath(entry.filePath || "")}
              class="h-full"
              preview={false}
              apiUrls={apiUrls}
            />
            <div class="absolute inset-x-4 top-3 z-10 flex flex-wrap items-center justify-end gap-x-3 gap-y-1 text-xs font-medium text-white drop-shadow-[0_1px_2px_rgb(0_0_0/0.9)]">
              <div class="flex items-center gap-1 whitespace-nowrap">
                <Icon is:inline name="material-symbols:notes-rounded" class="text-base" />
                <span>
                  {remarkPluginFrontmatter.words}
                  {" " + i18n(remarkPluginFrontmatter.words === 1 ? I18nKey.wordCount : I18nKey.wordsCount)}
                </span>
              </div>
              <div class="flex items-center gap-1 whitespace-nowrap">
                <Icon is:inline name="material-symbols:schedule-outline-rounded" class="text-base" />
                <span>
                  {remarkPluginFrontmatter.minutes}
                  {" " + i18n(remarkPluginFrontmatter.minutes === 1 ? I18nKey.minuteCount : I18nKey.minutesCount)}
                </span>
              </div>
              {entry.data.password && (
                <div class="flex items-center gap-1 whitespace-nowrap">
                  <Icon is:inline name="material-symbols:lock-outline" class="text-base" />
                  <span>{i18n(I18nKey.postEncrypted)}</span>
                </div>
              )}
            </div>
            <div class="absolute inset-x-0 bottom-0 px-6 md:px-9 pt-10 pb-3 bg-gradient-to-t from-black/80 via-black/45 to-transparent">
              <div
                data-pagefind-body
                data-pagefind-weight="10"
                data-pagefind-meta="title"
                class="mb-2 text-xl md:text-2xl font-bold leading-tight text-white"
              >
                {entry.data.title}
              </div>
              <PostMetadata
                variant="cover"
                className="gap-x-4 gap-y-1"
                published={entry.data.published}
                updated={entry.data.updated}
                category={entry.data.category || undefined}
                tags={entry.data.tags}
                id={entry.id}
              />
            </div>
          </div>
        )
      }

      <!-- word count and reading time -->
      {
        !usePostCoverOverlay && (
          <div
            class="flex flex-row text-black/30 dark:text-white/30 gap-5 mb-3 transition onload-animation"
          >
            <div class="flex flex-row items-center">
              <div
                class="transition h-6 w-6 rounded-md bg-black/5 dark:bg-white/10 text-black/50 dark:text-white/50 flex items-center justify-center mr-2"
              >
                <Icon is:inline name="material-symbols:notes-rounded" />
              </div>
              <div class="text-sm">
                {remarkPluginFrontmatter.words}
                {" " + i18n(I18nKey.wordsCount)}
              </div>
            </div>
            <div class="flex flex-row items-center">
              <div
                class="transition h-6 w-6 rounded-md bg-black/5 dark:bg-white/10 text-black/50 dark:text-white/50 flex items-center justify-center mr-2"
              >
                <Icon is:inline name="material-symbols:schedule-outline-rounded" />
              </div>
              <div class="text-sm">
                {remarkPluginFrontmatter.minutes}
                {
                  " " +
                    i18n(
                      remarkPluginFrontmatter.minutes === 1
                        ? I18nKey.minuteCount
                        : I18nKey.minutesCount
                    )
                }
              </div>
            </div>
            {entry.data.password && (
              <div class="flex flex-row items-center">
                <div
                  class="transition h-6 w-6 rounded-md bg-black/5 dark:bg-white/10 text-black/50 dark:text-white/50 flex items-center justify-center mr-2"
                >
                  <Icon is:inline name="material-symbols:lock-outline" />
                </div>
                <div class="text-sm">
                  {i18n(I18nKey.postEncrypted)}
                </div>
              </div>
            )}
          </div>
        )
      }

      <!-- title -->
      {
        !usePostCoverOverlay && (
          <div class="relative onload-animation">
            <div
              data-pagefind-body
              data-pagefind-weight="10"
              data-pagefind-meta="title"
              class="transition w-full block font-bold mb-3
                        text-3xl md:text-[2.25rem]/[2.75rem]
                        text-black/90 dark:text-white/90
                        md:before:w-1 before:h-5 before:rounded-md before:bg-(--primary)
                        before:absolute before:top-3 before:-left-4.5"
            >
              {entry.data.title}
            </div>
          </div>
        )
      }

      <!-- metadata -->
      {
        !usePostCoverOverlay && (
          <div class="onload-animation">
            <PostMetadata
              className="mb-5"
              published={entry.data.published}
              updated={entry.data.updated}
              tags={entry.data.tags}
              category={entry.data.category || undefined}
              id={entry.id}
            />
            {
              !showPostCover && (
                <div class="border-(--line-divider) border-dashed border-b mt-3 mb-5" />
              )
            }
          </div>
        )
      }

      {
        showPostCover && !usePostCoverOverlay && processedImage && (
          <div class="mt-4">
            <CoverImage
              id="post-cover"
              src={processedImage}
              basePath={getFileDirFromPath(entry.filePath || "")}
              class="mb-8 rounded-xl banner-container onload-animation"
              preview={false}
              apiUrls={apiUrls}
            />
          </div>
        )
      }

      {entry.data.password ? (
        <EncryptedPost password={entry.data.password} slug={entry.id} hint={entry.data.passwordHint || ""}>
          <div data-pagefind-body class="prose dark:prose-invert prose-base max-w-none! custom-md mb-6 markdown-content onload-animation" set:html={renderedContentHtml}></div>

          {/* 打赏按钮 & 分享按钮 */}
          {
            (siteConfig.post.sharePoster || (sponsorConfig.showButtonInPost && siteConfig.pages.sponsor)) && (
              <div class="mb-6 rounded-xl onload-animation">
                <div class="p-6 bg-(--license-block-bg) rounded-xl">
                  <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
                    <div class="flex items-center gap-3 flex-1">
                      <div class="h-12 w-12 rounded-lg bg-(--primary) flex items-center justify-center text-white dark:text-black/70 shrink-0">
                        <Icon is:inline
                          name={sponsorConfig.showButtonInPost &&
                          siteConfig.pages.sponsor
                            ? "material-symbols:favorite"
                            : "material-symbols:share"}
                          class="text-2xl"
                        />
                      </div>
                      <div>
                        <h3 class="text-lg font-semibold text-neutral-900 dark:text-neutral-100 mb-1">
                          {
                            sponsorConfig.showButtonInPost && siteConfig.pages.sponsor
                              ? i18n(I18nKey.sponsorButton)
                              : i18n(I18nKey.shareOnSocial)
                          }
                        </h3>
                        <p class="text-sm text-neutral-600 dark:text-neutral-400">
                          {
                            sponsorConfig.showButtonInPost && siteConfig.pages.sponsor
                              ? i18n(I18nKey.sponsorButtonText)
                              : i18n(I18nKey.shareOnSocialDescription)
                          }
                        </p>
                      </div>
                    </div>
                    <div class="flex items-center gap-3">
                      {
                        siteConfig.post.sharePoster && (
                          <SharePoster
                            client:load
                            title={entry.data.title}
                            author={profileConfig.name}
                            description={entry.data.description || entry.data.title}
                            pubDate={formatDateToYYYYMMDD(entry.data.published)}
                            coverImage={posterCoverUrl}
                            coverImageSelector={posterCoverSelector}
                            url={Astro.url.href}
                            siteTitle={siteConfig.title}
                            avatar={posterAvatarUrl}
                            avatarSelector={posterAvatarSelector}
                          />
                        )
                      }
                      {
                        sponsorConfig.showButtonInPost && siteConfig.pages.sponsor && (
                          <a
                            href={url("/sponsor/")}
                            class="inline-flex items-center gap-2 px-6 py-3 bg-(--primary) text-white dark:text-black/70 rounded-lg font-medium hover:bg-(--primary)/80 hover:scale-105 active:scale-95 transition-all whitespace-nowrap"
                          >
                            <span>{i18n(I18nKey.sponsor)}</span>
                            <Icon is:inline name="fa7-solid:arrow-right" class="text-sm" />
                          </a>
                        )
                      }
                    </div>
                  </div>
                </div>
              </div>
            )
          }

          {
            licenseConfig.enable && (
              <License
                title={entry.data.title}
                id={entry.id}
                pubDate={entry.data.published}
                author={entry.data.author || profileConfig.name}
                sourceLink={entry.data.sourceLink || ""}
                licenseName={entry.data.licenseName || licenseConfig.name}
                licenseUrl={entry.data.licenseUrl || licenseConfig.url || ""}
                class="mb-6 rounded-xl license-container onload-animation"
              />
            )
          }
        </EncryptedPost>
      ) : (
        <>
          <div data-pagefind-body class="prose dark:prose-invert prose-base max-w-none! custom-md mb-6 markdown-content onload-animation" set:html={renderedContentHtml}></div>

          {/* 打赏按钮 & 分享按钮 */}
          {
            (siteConfig.post.sharePoster || (sponsorConfig.showButtonInPost && siteConfig.pages.sponsor)) && (
              <div class="mb-6 rounded-xl onload-animation">
                <div class="p-6 bg-(--license-block-bg) rounded-xl">
                  <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
                    <div class="flex items-center gap-3 flex-1">
                      <div class="h-12 w-12 rounded-lg bg-(--primary) flex items-center justify-center text-white dark:text-black/70 shrink-0">
                        <Icon is:inline
                          name={sponsorConfig.showButtonInPost &&
                          siteConfig.pages.sponsor
                            ? "material-symbols:favorite"
                            : "material-symbols:share"}
                          class="text-2xl"
                        />
                      </div>
                      <div>
                        <h3 class="text-lg font-semibold text-neutral-900 dark:text-neutral-100 mb-1">
                          {
                            sponsorConfig.showButtonInPost && siteConfig.pages.sponsor
                              ? i18n(I18nKey.sponsorButton)
                              : i18n(I18nKey.shareOnSocial)
                          }
                        </h3>
                        <p class="text-sm text-neutral-600 dark:text-neutral-400">
                          {
                            sponsorConfig.showButtonInPost && siteConfig.pages.sponsor
                              ? i18n(I18nKey.sponsorButtonText)
                              : i18n(I18nKey.shareOnSocialDescription)
                          }
                        </p>
                      </div>
                    </div>
                    <div class="flex items-center gap-3">
                      {
                        siteConfig.post.sharePoster && (
                          <SharePoster
                            client:load
                            title={entry.data.title}
                            author={profileConfig.name}
                            description={entry.data.description || entry.data.title}
                            pubDate={formatDateToYYYYMMDD(entry.data.published)}
                            coverImage={posterCoverUrl}
                            coverImageSelector={posterCoverSelector}
                            url={Astro.url.href}
                            siteTitle={siteConfig.title}
                            avatar={posterAvatarUrl}
                            avatarSelector={posterAvatarSelector}
                          />
                        )
                      }
                      {
                        sponsorConfig.showButtonInPost && siteConfig.pages.sponsor && (
                          <a
                            href={url("/sponsor/")}
                            class="inline-flex items-center gap-2 px-6 py-3 bg-(--primary) text-white dark:text-black/70 rounded-lg font-medium hover:bg-(--primary)/80 hover:scale-105 active:scale-95 transition-all whitespace-nowrap"
                          >
                            <span>{i18n(I18nKey.sponsor)}</span>
                            <Icon is:inline name="fa7-solid:arrow-right" class="text-sm" />
                          </a>
                        )
                      }
                    </div>
                  </div>
                </div>
              </div>
            )
          }

          {
            licenseConfig.enable && (
              <License
                title={entry.data.title}
                id={entry.id}
                pubDate={entry.data.published}
                author={entry.data.author || profileConfig.name}
                sourceLink={entry.data.sourceLink || ""}
                licenseName={entry.data.licenseName || licenseConfig.name}
                licenseUrl={entry.data.licenseUrl || licenseConfig.url || ""}
                class="mb-6 rounded-xl license-container onload-animation"
              />
            )
          }
        </>
      )}
    </div>
  </div>

  <!-- 上次编辑时间 -->
  {
    siteConfig.post.showLastModified && (() => {
      const dateInput = entry.data.updated || entry.data.published;
      if (!dateInput) return null;
      const lastModified = dayjs(dateInput);
      if (!lastModified.isValid()) return null;
      const dateStr = lastModified.format("YYYY-MM-DD");
      const outdatedThreshold = siteConfig.post.outdatedThreshold ?? 1;
      // 避免 dayjs.utc 插件调用 toISOString 时抛 RangeError
      let isoDate: string;
      try {
        isoDate = lastModified.toISOString();
      } catch {
        try {
          isoDate = new Date(dateInput as any).toISOString();
        } catch {
          isoDate = new Date().toISOString();
        }
      }

      return (
        <div 
          id="outdated-card" 
          class="card-base p-6 mb-4 hidden" 
          data-date={isoDate} 
          data-threshold={outdatedThreshold}
        >
          <div class="flex items-center gap-2">
            <div class="transition h-9 w-9 rounded-lg overflow-hidden relative flex items-center justify-center mr-0">
              <Icon is:inline
                name="material-symbols:history-rounded"
                class="text-4xl text-(--primary) transition-transform group-hover:translate-x-0.5 bg-(--enter-btn-bg) p-2 rounded-md"
              />
            </div>

            <div class="flex flex-col gap-0.1">
              <div class="text-[1.0rem] leading-tight text-black/75 dark:text-white/75">
                {i18n(I18nKey.lastModifiedPrefix)}{dateStr}
                <span id="days-ago-text" data-template={i18n(I18nKey.lastModifiedDaysAgo)}></span>
              </div>
              <p id="outdated-warning" class="text-[0.8rem] leading-tight text-black/75 dark:text-white/75 hidden">
                {i18n(I18nKey.lastModifiedOutdated)}
              </p>
            </div>
          </div>
        </div>
      );
    })()
  }

  <script>
    const card = document.getElementById('outdated-card');
    const dateStr = card?.dataset.date;

    if (card && dateStr) {
      const lastModified = new Date(dateStr);
      let daysDiff = 0;
      if (!Number.isNaN(lastModified.getTime())) {
        daysDiff = Math.floor(
          (Date.now() - lastModified.getTime()) / 86400000,
        );
      }
      const threshold = Number(card.dataset.threshold) || 1;

      if (daysDiff >= threshold) {
        card.classList.remove('hidden');

        if (daysDiff >= 1) {
          const textEl = document.getElementById('days-ago-text');
          if (textEl && textEl.dataset.template) {
            textEl.textContent = `，${textEl.dataset.template.replace("{days}", daysDiff.toString())}`;
          }

          const warningEl = document.getElementById('outdated-warning');
          if (warningEl) {
            warningEl.classList.remove('hidden');
          }
        }
      }
    }
  </script>

  <div
    class="flex flex-col md:flex-row justify-between mb-4 gap-4 overflow-hidden w-full"
  >
    <a
      href={entry.data.nextSlug ? getPostUrlBySlug(entry.data.nextSlug) : url("/")}
      class="w-full font-bold overflow-hidden active:scale-95"
    >
      <div class="btn-card rounded-2xl w-full h-15 max-w-full px-4 flex items-center justify-start! gap-4">
        <Icon is:inline
          name="material-symbols:chevron-left-rounded"
          class="text-[2rem] text-(--primary)"
        />
        <div class="overflow-hidden transition text-ellipsis whitespace-nowrap max-w-[calc(100%-3rem)] text-black/75 dark:text-white/75">
          {entry.data.nextTitle || i18n(I18nKey.home)}
        </div>
      </div>
    </a>

    <a
      href={entry.data.prevSlug ? getPostUrlBySlug(entry.data.prevSlug) : url("/")}
      class="w-full font-bold overflow-hidden active:scale-95"
    >
      <div class="btn-card rounded-2xl w-full h-15 max-w-full px-4 flex items-center justify-end! gap-4">
        <div class="overflow-hidden transition text-ellipsis whitespace-nowrap max-w-[calc(100%-3rem)] text-black/75 dark:text-white/75">
          {entry.data.prevTitle || i18n(I18nKey.home)}
        </div>
        <Icon is:inline
          name="material-symbols:chevron-right-rounded"
          class="text-[2rem] text-(--primary)"
        />
      </div>
    </a>
  </div>

  <RecommendedPost relatedPosts={relatedPosts} currentPostId={entry.id} />

  <!-- 评论 -->
  {entry.data.comment && !entry.data.password && <Comment post={entry as any} />}
</MainGridLayout>
