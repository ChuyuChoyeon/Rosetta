---
import ArchivePanel from "@components/controls/ArchivePanel.astro";
import I18nKey from "@i18n/i18nKey";
import { i18nFor, readEffectiveLangHintRaw } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";

const ssrLang = readEffectiveLangHintRaw(Astro);
const t = (k: I18nKey) => i18nFor(k, ssrLang);
---

<MainGridLayout title={t(I18nKey.archive)} titleI18nKey={I18nKey.archive}>
  <ArchivePanel />
</MainGridLayout>

<script>
  // MainGridLayout 渲染的 <title> / <meta og:title> 等头部文案是 SSR 写死到响应流里的，
  // 没有 DOM 节点挂 data-i18n-text-key 供 translation.ts 同步刷新。
  // 这里直接监听 rosetta-lang-change，按当前语言重新写 title / og:title，
  // 保证文档标题随切语言立即变化（reload 前会短暂显示正确语言）。
  import { getCurrentLang, i18n } from "@/i18n/translation";
  import Key from "@/i18n/i18nKey";
  function syncArchiveTitle() {
    const titleText = i18n(Key.archive);
    if (!titleText) return;
    document.title = titleText;
    document
      .querySelectorAll<HTMLMetaElement>('meta[property="og:title"]')
      .forEach((m) => m.setAttribute("content", titleText));
    document
      .querySelectorAll<HTMLMetaElement>('meta[name="twitter:title"]')
      .forEach((m) => m.setAttribute("content", titleText));
  }
  window.addEventListener("rosetta-lang-change", syncArchiveTitle);
  syncArchiveTitle();
</script>
