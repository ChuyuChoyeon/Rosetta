---
import type { Page } from "astro";
import Pagination from "@/components/common/Pagination.astro";
import PostPage from "@/components/layout/PostPage.astro";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { getSortedPosts } from "@/utils/content-utils";
import { loadDynamicConfig } from "@/utils/dynamic-config";
import { applyAstroLangContext } from "@/utils/ssrLangContext";
import { url } from "@/utils/url-utils";

applyAstroLangContext(Astro);

/**
 * 首页（显式路由，优先级高于 catch-all 的 REST 参数）
 *
 * 渲染策略：
 *  - 添加 `export const prerender = false` 强制进入 SSR 模式。
 *    原因：加载链路中（动态配置、Bing 壁纸、内容获取）会触发 Astro.request.headers
 *    等 SSR 专属 API；若以 Prerender 模式运行，Astro 会抛出告警且 props 常为 undefined。
 *  - 分页数据在组件体直接计算（不依赖 getStaticPaths 传递的 props.page），
 *    这样在「静态 / SSR / 混合」三种模式下都能稳定渲染，兜底之前出现的
 *    `Cannot read properties of undefined (reading 'data')` 首页 500。
 */
export const prerender = false;

// 显式首页（/）不需要 getStaticPaths（SSR 不调用它），但保留给静态模式兜底：
// 当构建端强制 prerender 时（例如生产静态部署），仍能通过 props.page 拿到数据。
export const getStaticPaths = async () => {
	const dynamicCfg = await loadDynamicConfig();
	const allBlogPosts = await getSortedPosts();
	const pageSize =
		typeof dynamicCfg?.pagination?.postsPerPage === "number"
			? Math.max(1, dynamicCfg.pagination.postsPerPage)
			: 10;

	const total = allBlogPosts.length;
	const lastPage = Math.max(1, Math.ceil(total / pageSize));
	const currentPage = 1;
	const start = 0;
	const end = Math.min(pageSize, total);
	const data = allBlogPosts.slice(start, end);

	const makePageUrl = (n: number) => (n === 1 ? url("/") : url(`/${n}/`));

	const pageObj: Page<(typeof allBlogPosts)[number]> = {
		data,
		start,
		end: Math.max(0, end - 1),
		size: pageSize,
		total,
		currentPage,
		lastPage,
		url: {
			prev: undefined,
			next: currentPage < lastPage ? makePageUrl(currentPage + 1) : undefined,
			current: makePageUrl(currentPage),
			first: makePageUrl(1),
			last: makePageUrl(lastPage),
		},
	};

	return [{ params: {}, props: { page: pageObj } }];
};

// ===== 1) 优先从 props.page 取（静态模式），SSR 模式下 props.page 为空，走兜底计算 =====
const dynamicCfg = await loadDynamicConfig();
const siteConfig = {
	title: dynamicCfg.site.title,
	description: dynamicCfg.site.description,
	pages: dynamicCfg.pages,
	postListLayout: dynamicCfg.postListLayout,
	categoryBar: dynamicCfg.categoryBarEnabled,
	foldArticle: dynamicCfg.archiveFoldOldArticles,
	pagination: dynamicCfg.pagination,
};

const pageSize =
	typeof dynamicCfg?.pagination?.postsPerPage === "number"
		? Math.max(1, dynamicCfg.pagination.postsPerPage)
		: 10;

// SSR 模式：直接计算首页所需的分页对象（currentPage=1）
async function buildIndexPage(): Promise<Page<any>> {
	const allBlogPosts = await getSortedPosts();
	const total = allBlogPosts.length;
	const lastPage = Math.max(1, Math.ceil(total / pageSize));
	const currentPage = 1;
	const start = 0;
	const end = Math.min(pageSize, total);
	const data = allBlogPosts.slice(start, end);

	const makePageUrl = (n: number) => (n === 1 ? url("/") : url(`/${n}/`));

	return {
		data,
		start,
		end: Math.max(0, end - 1),
		size: pageSize,
		total,
		currentPage,
		lastPage,
		url: {
			prev: undefined,
			next: currentPage < lastPage ? makePageUrl(currentPage + 1) : undefined,
			current: makePageUrl(currentPage),
			first: makePageUrl(1),
			last: makePageUrl(lastPage),
		},
	};
}

// 核心修复：props.page 可能为 undefined（SSR 模式、Astro 7.x prerender 告警等场景）
// 所以这里做双重兜底——props.page 取不到时，现场重新构建一份 page 对象。
const propsPage: Page<any> | undefined = (Astro.props as any)?.page;
const page: Page<any> =
	propsPage && Array.isArray(propsPage.data)
		? propsPage
		: await buildIndexPage();

const len = page.data.length;
---

<MainGridLayout>
  <PostPage page={page} />
  {
    page.total > page.size && (
      <Pagination
        class="mx-auto onload-animation"
        page={page}
        style={`animation-delay: calc(var(--content-delay) + ${len * 50}ms)`}
      />
    )
  }
</MainGridLayout>

<script>
  // 响应式分页处理脚本
  document.addEventListener("DOMContentLoaded", function () {
    const responsiveEnabled = true;
    if (responsiveEnabled) {
      const deviceType = getDeviceType();
      document.body.classList.add(`device-${deviceType}`);

      let resizeTimeout: any;
      window.addEventListener("resize", function () {
        clearTimeout(resizeTimeout);
        resizeTimeout = setTimeout(function () {
          const newDeviceType = getDeviceType();
          const currentDeviceType = document.body.className.match(
            /device-(mobile|tablet|desktop)/
          )?.[1];

          if (currentDeviceType !== newDeviceType) {
            document.body.classList.remove(`device-${currentDeviceType}`);
            document.body.classList.add(`device-${newDeviceType}`);
          }
        }, 250);
      });
    }
  });

  function getDeviceType() {
    if (typeof window === "undefined") return "desktop";
    const width = window.innerWidth;
    if (width < 768) return "mobile";
    if (width < 1024) return "tablet";
    return "desktop";
  }
</script>
