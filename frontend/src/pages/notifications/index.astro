---
import { loadDynamicConfig } from "@/utils/dynamic-config";

const siteConfig = (await loadDynamicConfig()).site;

import MainGridLayout from "@/layouts/MainGridLayout.astro";

const heroTitle = "消息通知";
const siteName = siteConfig?.title || "Rosetta";
---

<MainGridLayout
	title={heroTitle}
	description={heroTitle}
>
	<div class="page-notifications-hero relative overflow-hidden">
		<div class="mx-auto max-w-4xl px-6 py-16 text-center sm:py-24">
			<div
				class="mx-auto mb-8 flex h-24 w-24 items-center justify-center rounded-3xl bg-gradient-to-br from-indigo-500 via-purple-500 to-pink-500 text-4xl text-white shadow-lg shadow-purple-500/30"
			>
				🔔
			</div>
			<h1
				class="mb-4 bg-gradient-to-r from-indigo-600 via-purple-600 to-pink-600 bg-clip-text text-4xl font-extrabold tracking-tight text-transparent sm:text-5xl"
			>
				{heroTitle}
			</h1>
			<p class="mx-auto mb-10 max-w-xl text-base leading-7 text-muted-foreground sm:text-lg">
				站点通知与消息中心正在建设中，敬请期待。<br />
				后续将支持评论回复提醒、系统公告、点赞与关注通知等功能。
			</p>
			<div class="flex flex-wrap items-center justify-center gap-4">
				<a
					href="/"
					class="inline-flex h-11 items-center justify-center rounded-xl bg-foreground px-6 text-sm font-semibold text-background shadow-sm transition hover:opacity-90"
				>
					← 返回首页
				</a>
				<a
					href="/posts"
					class="inline-flex h-11 items-center justify-center rounded-xl border border-border px-6 text-sm font-semibold text-foreground transition hover:bg-muted"
				>
					浏览文章
				</a>
			</div>
		</div>
	</div>
</MainGridLayout>

<style>
	.page-notifications-hero {
		background:
			radial-gradient(circle at 20% 20%, rgba(139, 92, 246, 0.08), transparent 40%),
			radial-gradient(circle at 80% 60%, rgba(236, 72, 153, 0.08), transparent 40%);
	}
</style>
