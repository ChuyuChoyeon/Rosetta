---

import { getEntry, render } from "astro:content";
import Markdown from "@components/common/Markdown.astro";
import { getSiteConfig } from "@/api/site";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

let pageTitle = i18n(I18nKey.about);
let pageContent = "";
let useFallback = true;

// 尝试从后端配置 API 获取关于页面内容
try {
	const config = await getSiteConfig();
	if (config?.about_content) {
		pageContent = config.about_content;
		useFallback = false;
	}
} catch (e) {
	console.warn(
		"[about] Failed to fetch about content from config API, using fallback:",
		e,
	);
}

// 如果后端没有内容，使用静态内容作为回退
let Content: any = null;
if (useFallback || !pageContent) {
	const aboutPost = await getEntry("spec", "about");
	if (aboutPost) {
		const rendered = await render(aboutPost);
		Content = rendered.Content;
	}
}
---
<MainGridLayout title={pageTitle} description={pageTitle}>
    <div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-9 py-6 relative w-full ">
			{!useFallback && pageContent ? (
				<Markdown class="mt-2">
					{pageContent}
				</Markdown>
			) : Content ? (
				<Markdown class="mt-2">
					<Content />
				</Markdown>
			) : (
				<div class="text-neutral-500 dark:text-neutral-400 py-8 text-center">
					{i18n(I18nKey.about)}
				</div>
			)}
        </div>
    </div>
</MainGridLayout>
