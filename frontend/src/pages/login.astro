---
import Layout from "@layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import {
	fetchBingWallpaperByIndex,
	loadDynamicConfig,
} from "@/utils/dynamic-config";

const siteConfig = (await loadDynamicConfig()).site;
const wallpaper = (await loadDynamicConfig()).wallpaper;
// SSR 先拿默认 Bing 今日 meta（title + copyright）——用于右下角灰色块展示，客户端切换时再覆写）
const _loginBingMetaP = fetchBingWallpaperByIndex(0, "zh-CN").catch(() => ({
	idx: 0,
	url: "",
	copyright: "",
	title: "",
	startdate: "",
}));
const loginBingMeta = await _loginBingMetaP;
// 登录背景逻辑（优先级：临时覆盖 > 后台单独配置 login_bg > 全局壁纸 desktop）
// 注意：这里先取全局 wallpaper，客户端 JS 会再按 login_bg_override_type 覆盖。
const defaultDesktopBg =
	typeof (wallpaper.src as any)?.desktop === "string" &&
	(wallpaper.src as any)?.desktop
		? (wallpaper.src as any).desktop
		: "/assets/images/DesktopWallpaper/d1.avif";
// SSR 默认背景若有 Bing 今日图则优先用 Bing 今日（和首页一致）
const loginBingUrl = loginBingMeta?.url?.trim() || "";
const initialBgUrl = loginBingUrl || defaultDesktopBg;
const loginBingTitle = String(
	loginBingMeta?.title || wallpaper?.bingMeta?.title || "",
).trim();
const loginBingCopyright = String(
	loginBingMeta?.copyright || wallpaper?.bingMeta?.copyright || "",
).trim();
---

<Layout title="后台管理登录">
	<div class="login-page">
		<div
			id="login-bg"
			class="login-bg"
			style={`background-image: url(${initialBgUrl})`}
			aria-hidden="true"
		></div>
		<div class="login-vignette" aria-hidden="true"></div>
		<div class="login-grain" aria-hidden="true"></div>

		<!-- ============ Bing meta（右下角灰色块，位置与主页一致，加厚毛玻璃不透明度） ============ -->
		{loginBingTitle || loginBingCopyright ? (
			<div id="login-bing-meta" class="login-bing-meta absolute bottom-24 right-3 md:bottom-32 md:right-5 z-40 pointer-events-none transition-opacity duration-500 max-w-[62vw] md:max-w-[32vw]">
				<div class="bing-wallpaper-meta-inner bg-black/60 dark:bg-black/72 backdrop-blur-xl saturate-[180%] px-3.5 py-2 rounded-lg text-white/90 text-xs md:text-sm shadow-2xl leading-snug border border-white/10">
					{loginBingTitle ? (
						<div class="bing-wallpaper-title font-semibold truncate">{loginBingTitle}</div>
					) : null}
					{loginBingCopyright ? (
						<div class="bing-wallpaper-copyright text-white/78 truncate text-[10.5px] md:text-xs mt-0.5">
							{loginBingCopyright}
						</div>
					) : null}
				</div>
			</div>
		) : (
			// SSR 暂时没有 meta 时占位容器（等客户端脚本填入真实数据，避免后续动态插入闪烁）
			<div id="login-bing-meta" class="login-bing-meta absolute bottom-24 right-3 md:bottom-32 md:right-5 z-40 pointer-events-none transition-opacity duration-500 max-w-[62vw] md:max-w-[32vw]"></div>
		)}

		<!-- 粒子层（暖石色系） -->
		<div class="particles" id="particles" aria-hidden="true"></div>

		<!-- 右上角壁纸来源切换器（Bing每日 / 自定义后台 / 本地默认 / 随机第三方Bing） -->
		<div class="bg-switcher" title="切换登录背景">
			<button type="button" class="bg-switcher-btn" id="bg-switcher-btn" aria-label="切换登录壁纸">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="bg-switcher-icon"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
				<span class="bg-switcher-label" id="bg-switcher-label">Bing每日</span>
			</button>
			<div class="bg-switcher-menu" id="bg-switcher-menu" role="menu">
				<!-- ============ 新增：Bing 历史日期导航（仅当当前 bgtype=bing / mirror 时可点，其他模式下灰掉） ============ -->
				<div class="bing-days-row" role="group" aria-label="Bing 日期切换">
					<button type="button" class="bing-day-btn prev" id="bing-day-prev" aria-label="前一天 Bing 壁纸">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
					</button>
					<button type="button" class="bing-day-label" id="bing-day-label" aria-label="Bing 日期（今日=0）">
						Day 0 · Today
					</button>
					<button type="button" class="bing-day-btn next" id="bing-day-next" aria-label="后一天 Bing 壁纸">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
					</button>
				</div>
				<div class="bg-switcher-divider"></div>
				<button type="button" class="bg-switcher-item" data-bgtype="bing" role="menuitem">
					<span class="dot bing"></span>Bing 每日壁纸
				</button>
				<button type="button" class="bg-switcher-item" data-bgtype="custom" role="menuitem">
					<span class="dot custom"></span>后台自定义
				</button>
				<button type="button" class="bg-switcher-item" data-bgtype="mirror" role="menuitem">
					<span class="dot mirror"></span>随机 Bing 镜像
				</button>
				<button type="button" class="bg-switcher-item" data-bgtype="default" role="menuitem">
					<span class="dot default"></span>本地默认
				</button>
			</div>
		</div>

		<div class="login-content">
			<div class="brand-section">
				<div class="brand-mark">
					<img src="/favicon/rosetta-256.png" alt={siteConfig.title} class="brand-icon-img" />
				</div>
				<div class="brand-text">
					<h1 class="brand-title">{siteConfig.title}</h1>
					<p class="brand-sub">Admin Console</p>
					<div class="brand-divider"></div>
					<p class="brand-desc">管理你的内容世界<br/>Create · Share · Inspire.</p>
				</div>
			</div>

			<div class="login-card-wrap">
			<div class="login-card">
				<div class="card-header">
						<span class="card-eyebrow">WELCOME</span>
						<h2>欢迎回来</h2>
						<p>请登录以继续管理您的内容</p>
					</div>

					<form id="login-form" class="login-form">
						<div class="field">
							<label for="username" class="sr-only">用户名</label>
							<div class="input-wrapper">
								<Icon name="material-symbols:person-rounded" class="input-icon" />
								<input
									type="text"
									id="username"
									name="username"
									required
									autocomplete="username"
									placeholder="请输入用户名"
								/>
								<span class="input-focus-ring"></span>
							</div>
						</div>

						<div class="field">
							<label for="password" class="sr-only">密码</label>
							<div class="input-wrapper">
								<Icon name="material-symbols:lock" class="input-icon" />
								<input
									type="password"
									id="password"
									name="password"
									required
									autocomplete="current-password"
									placeholder="请输入密码"
								/>
								<button type="button" id="toggle-password" class="toggle-password" aria-label="切换密码可见性">
									<Icon name="material-symbols:visibility-rounded" id="eye-icon" />
								</button>
								<span class="input-focus-ring"></span>
							</div>
						</div>

						<div class="form-error" id="login-error"></div>

						<div class="form-options">
							<label class="remember-me">
								<input type="checkbox" id="remember-me" name="remember" />
								<span class="checkmark"></span>
								<span>记住账号密码</span>
							</label>
						</div>

						<button type="submit" class="submit-btn" id="submit-btn">
							<span class="btn-text">登 录</span>
							<svg class="btn-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<line x1="5" y1="12" x2="19" y2="12"/>
								<polyline points="12 5 19 12 12 19"/>
							</svg>
						</button>
					</form>

					<div class="card-footer">
						<a href="/" class="back-link">
							<svg class="back-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<line x1="19" y1="12" x2="5" y2="12"/>
								<polyline points="12 19 5 12 12 5"/>
							</svg>
							<span>返回首页</span>
						</a>
					</div>
				</div>
			</div>
		</div>
	</div>
</Layout>

<style>
	.login-page {
		position: relative;
		min-height: calc(100vh - 80px);
		margin: 0 -2rem -2rem;
		overflow: hidden;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 2rem;
	}

	.login-bg {
		position: absolute;
		inset: -4%;
		background-size: cover;
		background-position: center;
		filter: brightness(0.76) saturate(1.08);
		animation: slowZoom 20s ease-in-out infinite alternate;
		transition: background-image 0.8s ease, filter 0.6s ease;
	}

	@keyframes slowZoom {
		from { transform: scale(1); }
		to { transform: scale(1.08); }
	}

	/* ============ OOBE 青蓝紫色系 Vignette（收敛暗角，避免脏色） ============ */
	.login-vignette {
		position: absolute;
		inset: 0;
		background:
			radial-gradient(ellipse at 30% 20%, hsla(210, 96%, 72%, 0.14) 0%, transparent 45%),
			radial-gradient(ellipse at 80% 85%, hsla(262, 88%, 64%, 0.18) 0%, transparent 46%),
			radial-gradient(ellipse at center, transparent 52%, rgba(6, 10, 28, 0.52) 100%);
		pointer-events: none;
	}

	.login-grain {
		position: absolute;
		inset: 0;
		pointer-events: none;
		opacity: 0.09;
		mix-blend-mode: overlay;
		background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
	}

	/* ============ 壁纸来源切换器（右上角，毛玻璃加厚不透明度） ============ */
	.bg-switcher {
		position: absolute;
		top: 1.5rem;
		right: 1.5rem;
		z-index: 20;
	}
	.bg-switcher-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		padding: 0.55rem 0.95rem;
		border-radius: 9999px;
		background: linear-gradient(120deg, hsla(216, 60%, 98%, 0.36), hsla(258, 58%, 96%, 0.34));
		border: 1px solid hsla(216, 70%, 98%, 0.52);
		backdrop-filter: blur(20px) saturate(180%);
		-webkit-backdrop-filter: blur(20px) saturate(180%);
		color: rgba(248, 252, 255, 0.92);
		font-size: 0.78rem;
		font-weight: 650;
		letter-spacing: 0.04em;
		cursor: pointer;
		transition: all 0.2s ease;
		box-shadow:
			0 10px 28px rgba(12, 18, 44, 0.36),
			inset 0 1px 0 rgba(255, 255, 255, 0.28);
	}
	.bg-switcher-btn:hover {
		background: linear-gradient(120deg, hsla(216, 70%, 98%, 0.46), hsla(258, 66%, 96%, 0.44));
		color: #fff;
		transform: translateY(-1px);
		border-color: hsla(216, 80%, 98%, 0.66);
	}
	.bg-switcher-icon {
		width: 16px;
		height: 16px;
		flex-shrink: 0;
	}
	.bg-switcher-menu {
		position: absolute;
		top: calc(100% + 12px);
		right: 0;
		min-width: 210px;
		background: linear-gradient(160deg, hsla(216, 50%, 98%, 0.50) 0%, hsla(250, 48%, 96%, 0.44) 60%, hsla(258, 50%, 96%, 0.40) 100%);
		border: 1px solid hsla(216, 66%, 98%, 0.52);
		backdrop-filter: blur(26px) saturate(190%);
		-webkit-backdrop-filter: blur(26px) saturate(190%);
		border-radius: 16px;
		padding: 7px;
		box-shadow:
			0 24px 56px rgba(8, 14, 40, 0.48),
			inset 0 1px 0 rgba(255, 255, 255, 0.34);
		opacity: 0;
		visibility: hidden;
		transform: translateY(6px) scale(0.97);
		transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
		z-index: 30;
	}
	.bg-switcher-menu.open {
		opacity: 1;
		visibility: visible;
		transform: translateY(0) scale(1);
	}
	.bg-switcher-item {
		display: flex;
		align-items: center;
		gap: 0.7rem;
		width: 100%;
		padding: 0.6rem 0.8rem;
		border-radius: 11px;
		background: transparent;
		border: none;
		color: rgba(246, 252, 255, 0.88);
		font-size: 0.84rem;
		font-weight: 550;
		text-align: left;
		cursor: pointer;
		transition: all 0.16s ease;
	}
	.bg-switcher-item:hover {
		background: hsla(216, 70%, 98%, 0.20);
		color: #ffffff;
	}
	.bg-switcher-item.active {
		background: linear-gradient(120deg, hsla(216, 92%, 62%, 0.42), hsla(258, 84%, 66%, 0.36));
		color: #ffffff;
		border: 1px solid hsla(236, 92%, 72%, 0.36);
		box-shadow: 0 4px 16px hsla(240, 82%, 60%, 0.24);
	}
	.dot {
		width: 9px;
		height: 9px;
		border-radius: 9999px;
		flex-shrink: 0;
		box-shadow: 0 0 0 2px rgba(255,255,255,0.12);
	}
	.dot.bing    { background: hsl(214, 92%, 62%); }
	.dot.custom  { background: hsl(34, 88%, 62%); }
	.dot.mirror  { background: hsl(192, 78%, 58%); }
	.dot.default { background: hsl(258, 80%, 68%); }

	/* Bing 历史日期导航（< Day X · Today >）——加厚毛玻璃 */
	.bing-days-row {
		display: flex;
		align-items: center;
		gap: 7px;
		padding: 6px;
		border-radius: 13px;
		background: linear-gradient(120deg, hsla(216, 60%, 98%, 0.26), hsla(258, 60%, 96%, 0.22));
		border: 1px solid hsla(216, 70%, 98%, 0.34);
		backdrop-filter: blur(16px) saturate(180%);
		-webkit-backdrop-filter: blur(16px) saturate(180%);
		color: rgba(246, 252, 255, 0.90);
		margin-bottom: 4px;
	}
	.bing-day-btn {
		flex: 0 0 auto;
		width: 30px;
		height: 30px;
		border-radius: 11px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		background: hsla(216, 70%, 98%, 0.24);
		border: 1px solid hsla(216, 70%, 98%, 0.30);
		color: rgba(246, 252, 255, 0.88);
		cursor: pointer;
		transition: all 0.18s ease;
	}
	.bing-day-btn svg { width: 14px; height: 14px; }
	.bing-day-btn:hover:not(:disabled) {
		background: linear-gradient(120deg, hsla(216, 92%, 62%, 0.40), hsla(258, 84%, 66%, 0.34));
		color: #fff;
		border-color: hsla(236, 92%, 72%, 0.50);
		box-shadow: 0 6px 18px hsla(240, 82%, 60%, 0.22);
	}
	.bing-day-btn:disabled {
		opacity: 0.38;
		cursor: not-allowed;
	}
	.bing-day-label {
		flex: 1 1 auto;
		min-width: 0;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		height: 30px;
		padding: 0 8px;
		border-radius: 11px;
		background: linear-gradient(120deg, hsla(216, 92%, 62%, 0.26), hsla(258, 84%, 66%, 0.22));
		border: 1px solid hsla(236, 92%, 72%, 0.36);
		color: rgba(248, 252, 255, 0.94);
		font-size: 0.8rem;
		font-weight: 650;
		letter-spacing: 0.03em;
		cursor: pointer;
		transition: all 0.18s ease;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.bing-day-label:hover {
		background: linear-gradient(120deg, hsla(216, 92%, 62%, 0.42), hsla(258, 84%, 66%, 0.36));
		color: #fff;
		border-color: hsla(236, 92%, 72%, 0.50);
	}
	.bg-switcher-divider {
		height: 1px;
		margin: 6px 4px 8px;
		background: linear-gradient(90deg, transparent, hsla(216, 70%, 98%, 0.34), hsla(258, 70%, 98%, 0.30), transparent);
	}

	.particles {
		position: absolute;
		inset: 0;
		pointer-events: none;
		overflow: hidden;
	}

	.particle {
		position: absolute;
		width: 3px;
		height: 3px;
		background: #fff;
		border-radius: 50%;
		opacity: 0;
		box-shadow:
			0 0 6px 1px hsla(220, 88%, 72%, 0.92),
			0 0 14px 2px hsla(258, 82%, 74%, 0.38);
		animation: float linear infinite;
	}

	@keyframes float {
		0% {
			opacity: 0;
			transform: translateY(100vh) scale(0);
		}
		10% { opacity: 0.9; }
		90% { opacity: 0.65; }
		100% {
			opacity: 0;
			transform: translateY(-20vh) scale(1);
		}
	}

	.login-content {
		position: relative;
		z-index: 2;
		display: flex;
		align-items: center;
		gap: 5rem;
		width: 100%;
		max-width: 960px;
	}

	.brand-section {
		flex: 1;
		color: white;
		animation: slideInLeft 0.9s cubic-bezier(0.16, 1, 0.3, 1) both;
	}

	@keyframes slideInLeft {
		from {
			opacity: 0;
			transform: translateX(-40px);
		}
		to {
			opacity: 1;
			transform: translateX(0);
		}
	}

	.brand-mark {
		margin-bottom: 1.75rem;
		filter:
			drop-shadow(0 2px 10px hsla(216, 78%, 58%, 0.32))
			drop-shadow(0 8px 30px hsla(256, 70%, 58%, 0.24));
	}

	.brand-icon-img {
		width: 92px;
		height: 92px;
		object-fit: contain;
		image-rendering: -webkit-optimize-contrast;
		image-rendering: crisp-edges;
		-webkit-font-smoothing: antialiased;
	}

	/* ============ Brand标题：暖石→青蓝紫渐变（更贴合新LOGO色调） ============ */
	.brand-text h1 {
		margin: 0;
		font-size: 3.25rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		line-height: 1.1;
		background: linear-gradient(135deg, #fffdf5 0%, #e9f2ff 48%, #d9dcff 100%);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
		-webkit-text-fill-color: transparent;
		text-shadow: 0 2px 12px rgba(0, 0, 0, 0.22);
	}

	.brand-sub {
		margin: 0.5rem 0 0;
		font-size: 0.85rem;
		font-weight: 500;
		letter-spacing: 0.4em;
		opacity: 0.82;
		color: rgba(233, 242, 255, 0.82);
		text-transform: uppercase;
	}

	/* ============ Brand分隔线：青蓝→紫渐变 ============ */
	.brand-divider {
		width: 56px;
		height: 3px;
		margin: 1.5rem 0;
		background: linear-gradient(90deg, hsl(208, 88%, 62%) 0%, hsl(258, 72%, 62%) 100%);
		border-radius: 3px;
	}

	.brand-desc {
		margin: 0;
		font-size: 0.98rem;
		line-height: 1.85;
		opacity: 0.86;
		color: rgba(238, 245, 255, 0.88);
	}

	.login-card-wrap {
		flex: 0 0 400px;
		position: relative;
		animation: slideInRight 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.15s both;
	}

	@keyframes slideInRight {
		from {
			opacity: 0;
			transform: translateX(40px);
		}
		to {
			opacity: 1;
			transform: translateX(0);
		}
	}

	.login-card {
		position: relative;
		background: linear-gradient(160deg, hsla(216, 40%, 98%, 0.48) 0%, hsla(248, 38%, 96%, 0.42) 55%, hsla(28, 28%, 96%, 0.38) 100%);
		backdrop-filter: blur(30px) saturate(190%);
		-webkit-backdrop-filter: blur(30px) saturate(190%);
		border: 1px solid hsla(216, 50%, 98%, 0.48);
		border-radius: 1.35rem;
		padding: 2.5rem 2rem;
		box-shadow:
			0 36px 96px rgba(14, 20, 44, 0.42),
			0 12px 32px rgba(14, 20, 44, 0.26),
			inset 0 1px 0 rgba(255, 255, 255, 0.42),
			inset 0 0 0 1px rgba(255, 253, 245, 0.04);
		overflow: hidden;
	}
	/* 卡片微光：左上角青色+右下角紫色 */
	.login-card::before {
		content: "";
		position: absolute;
		inset: -30% -20% auto auto;
		width: 280px;
		height: 280px;
		background: radial-gradient(circle at 70% 30%, hsla(212, 96%, 68%, 0.32) 0%, transparent 62%);
		pointer-events: none;
		z-index: 0;
	}
