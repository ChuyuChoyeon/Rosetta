</style>

<script>
	// @ts-nocheck
	import { login } from "@api/auth";
	import { fetchBingWallpaperByIndex } from "@/utils/dynamic-config";

	const REMEMBER_KEY = "rosetta_remember_credentials";
	const BG_OVERRIDE_KEY = "rosetta_login_bg_override";
	const BING_IDX_KEY = "rosetta_login_bing_idx";
	const form = document.getElementById("login-form") || null;
	const errorEl = document.getElementById("login-error");
	const submitBtn = document.getElementById("submit-btn");
	const togglePasswordBtn = document.getElementById("toggle-password");
	const passwordInput = document.getElementById("password") || null;
	const eyeIcon = document.getElementById("eye-icon") || null;
	const particlesContainer = document.getElementById("particles");
	const rememberCheckbox = document.getElementById("remember-me") || null;
	const usernameInput = document.getElementById("username") || null;
	const bgEl = document.getElementById("login-bg");
	const bgSwitcherBtn = document.getElementById("bg-switcher-btn");
	const bgSwitcherMenu = document.getElementById("bg-switcher-menu");
	const bgSwitcherLabel = document.getElementById("bg-switcher-label");
	const bgItems = document.querySelectorAll(".bg-switcher-item");
	// 新增：Bing 历史日期导航控件
	const bingDayPrev = document.getElementById("bing-day-prev") as HTMLButtonElement | null;
	const bingDayNext = document.getElementById("bing-day-next") as HTMLButtonElement | null;
	const bingDayLabel = document.getElementById("bing-day-label") as HTMLButtonElement | null;
	const loginBingMetaEl = document.getElementById("login-bing-meta");

	const BG_LABELS = {
		bing: "Bing每日",
		custom: "后台自定义",
		mirror: "随机Bing",
		default: "本地默认",
	};

	// 当前 Bing 日期索引（0=今日 1=昨日 ... 7=7 天前）；非 Bing 模式下为 -1
	let currentBingIdx = 0;
	// 当前 bg 类型（用于控制日期导航按钮的可用性）
	let currentBgType: string = "bing";
	let bingMetaLast: { url: string; title: string; copyright: string; startdate: string } | null = null;

	// ============ 工具：更新右下角 Bing meta（登录版，加厚毛玻璃 + 青蓝紫色调）============
	function renderLoginBingMeta(title: string, copyright: string) {
		if (!loginBingMetaEl) return;
		const hasAny = !!(title || copyright);
		// 没有内容时直接占位（保持占位容器存在即可）
		let innerHtml = "";
		if (hasAny) {
			innerHtml =
				'<div class="bing-wallpaper-meta-inner" style="background:linear-gradient(135deg,rgba(12,20,44,0.68),rgba(22,16,54,0.62));backdrop-filter:blur(22px) saturate(180%);-webkit-backdrop-filter:blur(22px) saturate(180%);padding:0.5rem 0.85rem;border-radius:0.625rem;color:rgba(252,254,255,0.92);font-size:0.8rem;line-height:1.55;box-shadow:0 18px 44px rgba(6,10,28,0.52),0 1px 0 rgba(255,255,255,0.08) inset;border:1px solid rgba(236,245,255,0.14);">';
			if (title) {
				innerHtml +=
					'<div class="bing-wallpaper-title" style="font-weight:650;letter-spacing:0.01em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">' +
					title.replace(/"/g, "&quot;") +
					"</div>";
			}
			if (copyright) {
				innerHtml +=
					'<div class="bing-wallpaper-copyright" style="color:rgba(236,245,255,0.78);font-size:0.72rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:0.2rem;">' +
					copyright.replace(/"/g, "&quot;") +
					"</div>";
			}
			innerHtml += "</div>";
		}
		loginBingMetaEl.innerHTML = innerHtml;
		loginBingMetaEl.style.opacity = hasAny ? "1" : "0";
	}

	// ============ 工具：根据 startdate (YYYYMMDD) 转「MM/DD」 显示 ============
	function formatBingStartDate(s: string): string {
		if (!s || !/^\d{8}$/.test(s)) return "";
		const y = s.substring(0, 4);
		const m = s.substring(4, 6);
		const d = s.substring(6, 8);
		// 今日
		const today = new Date();
		const t8 =
			String(today.getFullYear()) +
			String(today.getMonth() + 1).padStart(2, "0") +
			String(today.getDate()).padStart(2, "0");
		if (s === t8) return `${y}/${m}/${d} · Today`;
		return `${y}/${m}/${d}`;
	}

	// ============ 工具：刷新 Bing 日期导航按钮可用状态 + 文本 ============
	function updateBingDaysUI() {
		const isBingMode = currentBgType === "bing" || currentBgType === "mirror";
		const maxIdx = 7;
		// 按钮禁用条件：非 Bing 模式 或 抵达边界
		if (bingDayPrev) bingDayPrev.disabled = !isBingMode || currentBingIdx >= maxIdx;
		if (bingDayNext) bingDayNext.disabled = !isBingMode || currentBingIdx <= 0;
		if (bingDayLabel) {
			const dateLabel = bingMetaLast?.startdate
				? formatBingStartDate(bingMetaLast.startdate)
				: "";
			const idxText =
				currentBingIdx === 0
					? "Day 0 · Today"
					: `Day ${currentBingIdx} · ${currentBingIdx}d ago`;
			bingDayLabel.textContent = dateLabel ? `${idxText}  ·  ${dateLabel}` : idxText;
			bingDayLabel.title =
				currentBgType === "bing" || currentBgType === "mirror"
					? "点击跳回今日 Bing 壁纸"
					: "请先选择「Bing 每日壁纸」或「随机 Bing 镜像」再切换日期";
		}
	}

	// ============ 解析 Bing 代理接口返回的第一张图（title/copyright/url） ============
	function parseBingApi(data: any) {
		const first = Array.isArray(data?.images) && data.images.length > 0 ? data.images[0] : null;
		if (!first) return null;
		const title = typeof first?.title === "string" ? first.title : "";
		const copyright = typeof first?.copyright === "string" ? first.copyright : "";
		const startdate = typeof first?.startdate === "string" ? first.startdate : "";
		let rawUrl = "";
		if (typeof first?.full_url === "string" && first.full_url) rawUrl = first.full_url;
		else if (typeof first?.url === "string" && first.url) rawUrl = first.url;
		let url = "";
		if (rawUrl) {
			if (/^https?:\/\//i.test(rawUrl)) url = rawUrl;
			else if (rawUrl.startsWith("/")) url = "https://www.bing.com" + rawUrl;
			else url = "https://www.bing.com/" + rawUrl;
		}
		return { url, copyright, title, startdate };
	}

	// ============ 切换到某个 Bing 日期 idx ============
	async function applyBingByIdx(idx: number, persist = true, mkt = "zh-CN") {
		const safeIdx = Math.max(0, Math.min(7, Number(idx) || 0));
		currentBingIdx = safeIdx;
		let resolved: { url: string; title: string; copyright: string; startdate: string } | null = null;
		// 优先后端代理
		try {
			const r = await fetch(
				`/api/media/bing-wallpaper?idx=${safeIdx}&n=1&mkt=${encodeURIComponent(mkt)}`,
				{ credentials: "same-origin" },
			);
			if (r.ok) {
				const data = await r.json();
				resolved = parseBingApi(data);
			}
		} catch (e) {
			console.warn("[login] bing idx=" + safeIdx + " proxy failed, fallback:", e);
		}
		// 后端失败则调用 fetchBingWallpaperByIndex（会自己 fallback 第三方镜像）
		if (!resolved || !resolved.url) {
			try {
				const r2 = await fetchBingWallpaperByIndex(safeIdx, mkt);
				resolved = {
					url: r2.url,
					title: r2.title || "",
					copyright: r2.copyright || "",
					startdate: r2.startdate || "",
				};
			} catch (_) { /* ignore */ }
		}
		if (!resolved) return;
		bingMetaLast = resolved;
		if (resolved.url && bgEl) bgEl.style.backgroundImage = "url(" + resolved.url + ")";
		renderLoginBingMeta(resolved.title, resolved.copyright);
		updateBingDaysUI();
		if (persist) {
			try {
				localStorage.setItem(BING_IDX_KEY, String(safeIdx));
			} catch (_) { /* ignore */ }
		}
	}

	// ============ 背景源解析（支持设置覆盖 + 本地临时偏好 + Bing idx 切换） ============
	async function resolveBgUrl(type: string): Promise<string> {
		try {
			if (type === "bing") {
				// 走 applyBingByIdx，返回空串由 applyBg 统一处理
				return "";
			}
			if (type === "mirror") {
				return `https://bing.img.run/?day=${Math.floor(Math.random() * 30)}`;
			}
			if (type === "custom") {
				// 尝试从 /api/site 拿自定义登录背景；失败则fallback Bing
				try {
					const cfg = await fetch("/api/site", { credentials: "same-origin" });
					if (cfg.ok) {
						const j = await cfg.json();
						const raw = j?.login_bg_url || j?.wallpaper_desktop || j?.hero_bg_image;
						if (typeof raw === "string" && raw.trim()) return raw;
					}
				} catch { /* ignore */ }
				return `https://bing.img.run/?day=${Math.floor(Math.random() * 30)}`;
			}
			return "/assets/images/DesktopWallpaper/d1.avif";
		} catch (e) {
			console.warn("[login] bg resolve failed, fallback default:", e);
			return "/assets/images/DesktopWallpaper/d1.avif";
		}
	}

	async function applyBg(type: string, persist = true, useSavedBingIdx: number | null = null) {
		currentBgType = type;
		let finalUrl: string | null = null;
		// Bing 模式 → 按 idx 切换（包含 meta 写入）
		if (type === "bing") {
			let startIdx = 0;
			if (typeof useSavedBingIdx === "number") startIdx = useSavedBingIdx;
			else {
				try {
					const raw = localStorage.getItem(BING_IDX_KEY);
					if (raw) startIdx = Math.max(0, Math.min(7, parseInt(raw, 10) || 0));
				} catch (_) { /* ignore */ }
			}
			await applyBingByIdx(startIdx, persist);
			updateBingDaysUI();
		} else {
			// 非 Bing 模式：清空 Bing meta 相关（meta 留空或保留最后一次 Bing 结果显示）
			const url = await resolveBgUrl(type);
			if (url && bgEl) bgEl.style.backgroundImage = "url(" + url + ")";
			// 非 Bing：让日期控件置灰
			updateBingDaysUI();
		}
		if (bgSwitcherLabel) {
			let label: string = BG_LABELS[type] || "Bing每日";
			if (type === "bing") {
				label =
					currentBingIdx === 0
						? "Bing·今日"
						: `Bing·${currentBingIdx}d前`;
			}
			bgSwitcherLabel.textContent = label;
		}
		bgItems.forEach((el: any) => {
			el.classList.toggle("active", el.dataset.bgtype === type);
		});
		if (persist) {
			try { localStorage.setItem(BG_OVERRIDE_KEY, type); } catch { /* ignore */ }
		}
	}

	// 启动时应用本地覆盖，若无则默认Bing
	(function initBg() {
		let savedType: any = "bing";
		let savedIdx: number | null = null;
		try {
			savedType = localStorage.getItem(BG_OVERRIDE_KEY) || "bing";
			const raw = localStorage.getItem(BING_IDX_KEY);
			if (raw) savedIdx = Math.max(0, Math.min(7, parseInt(raw, 10) || 0));
		} catch { /* ignore */ }
		applyBg(savedType, false, savedIdx);
	})();

	// 壁纸切换器交互
	if (bgSwitcherBtn && bgSwitcherMenu) {
		bgSwitcherBtn.addEventListener("click", (e) => {
			e.stopPropagation();
			bgSwitcherMenu.classList.toggle("open");
		});
		document.addEventListener("click", (e) => {
			if (!bgSwitcherMenu.contains(e.target as Node) && e.target !== bgSwitcherBtn) {
				bgSwitcherMenu.classList.remove("open");
			}
		});
	}
	bgItems.forEach((el: any) => {
		el.addEventListener("click", () => {
			const t = el.dataset.bgtype || "bing";
			applyBg(t, true);
			bgSwitcherMenu?.classList.remove("open");
		});
	});

	// ============ 新增：Bing 日期 < / > / 跳回今日 交互 ============
	if (bingDayPrev) {
		bingDayPrev.addEventListener("click", (ev) => {
			ev.preventDefault();
			ev.stopPropagation();
			const nextIdx = Math.min(7, currentBingIdx + 1);
			if (currentBgType === "bing") applyBingByIdx(nextIdx, true);
			// mirror 模式：不切换全局类型，临时按 idx 拉 Bing 作为等价随机
			else if (currentBgType === "mirror") applyBingByIdx(nextIdx, true);
		});
	}
	if (bingDayNext) {
		bingDayNext.addEventListener("click", (ev) => {
			ev.preventDefault();
			ev.stopPropagation();
			const nextIdx = Math.max(0, currentBingIdx - 1);
			if (currentBgType === "bing") applyBingByIdx(nextIdx, true);
			else if (currentBgType === "mirror") applyBingByIdx(nextIdx, true);
		});
	}
	if (bingDayLabel) {
		bingDayLabel.addEventListener("click", (ev) => {
			ev.preventDefault();
			ev.stopPropagation();
			if (currentBgType === "bing" || currentBgType === "mirror") applyBingByIdx(0, true);
		});
	}

	// 记住的账号密码恢复
	try {
		const saved = localStorage.getItem(REMEMBER_KEY);
		if (saved && rememberCheckbox && usernameInput && passwordInput) {
			const creds = JSON.parse(saved);
			usernameInput.value = creds.username || "";
			passwordInput.value = creds.password || "";
			rememberCheckbox.checked = true;
		}
	} catch {
		/* ignore */
	}

	// 粒子（暖石色系：赭石→胡桃木→靛青 hue 区间 25~245）
	if (particlesContainer) {
		const particleCount = 24;
		for (let i = 0; i < particleCount; i++) {
			const p = document.createElement("div");
			p.className = "particle";
			p.style.left = Math.random() * 100 + "%";
			p.style.animationDuration = (8 + Math.random() * 10) + "s";
			p.style.animationDelay = (Math.random() * 12) + "s";
			const size = 2 + Math.random() * 3;
			p.style.width = size + "px";
			p.style.height = size + "px";
			const hue = 25 + Math.random() * 220; // 25（赭石）..245（靛青）
			p.style.boxShadow = `0 0 ${4 + size * 2}px ${size / 2}px hsla(${hue}, 68%, 70%, 0.72)`;
			particlesContainer.appendChild(p);
		}
	}

	togglePasswordBtn?.addEventListener("click", () => {
		if (!passwordInput) return;
		const isPassword = passwordInput.type === "password";
		passwordInput.type = isPassword ? "text" : "password";
		if (eyeIcon) {
			eyeIcon.setAttribute(
				"name",
				isPassword ? "material-symbols:visibility-off-rounded" : "material-symbols:visibility-rounded",
			);
		}
	});

	form?.addEventListener("submit", async (e) => {
		e.preventDefault();
		if (!form) return;

		const formData = new FormData(form);
		const username = formData.get("username") as string;
		const password = formData.get("password") as string;
		const remember = formData.get("remember") === "on";

		if (errorEl) errorEl.textContent = "";
		if (submitBtn) {
			submitBtn.disabled = true;
			submitBtn.style.opacity = "0.7";
			submitBtn.style.cursor = "not-allowed";
		}

		try {
			await login({ username, password });

			if (remember) {
				localStorage.setItem(REMEMBER_KEY, JSON.stringify({ username, password }));
			} else {
				localStorage.removeItem(REMEMBER_KEY);
			}

			window.location.href = "/admin/";
		} catch (err: any) {
			if (errorEl) {
				errorEl.textContent = err?.message || "登录失败，请检查用户名和密码";
			}
		} finally {
			if (submitBtn) {
				submitBtn.disabled = false;
				submitBtn.style.opacity = "1";
				submitBtn.style.cursor = "pointer";
			}
		}
	});
</script>
