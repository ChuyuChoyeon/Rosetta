# 后端 API Base URL（SSR/浏览器端代理目标；留空=默认 127.0.0.1:8000）
API_BASE_URL=http://127.0.0.1:8000
# SSR 阶段直连后端的 URL（如与 API_BASE_URL 一致可省略）
API_BASE_URL_SSR=http://127.0.0.1:8000
# 站点公开 URL，用于 SEO sitemap/robots/og
SITE_URL=http://localhost:3000
# Session 密钥（生产部署必改，建议 >= 32 字符）
SESSION_SECRET=rosetta-change-me-in-prod-please
# Nuxt 端口
PORT=3000
