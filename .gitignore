astro-check-out.txt
astro-check-output.txt
_coverage_baseline.txt
_cov2.txt
_cov.txt
*.pid
*.seed
*.pid.lock

# --- Debug ---
npm-debug.log
yarn-error.log

# --- Editor swap (guard) ---
*.swp!

