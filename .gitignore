npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*-debug.log*

# --- Astro build output ---
frontend/dist/
frontend/.astro/
frontend/server/
frontend/client/
frontend/.output/

# Pagefind (search index built at runtime)
frontend/src/.pagefind/
frontend/public/pagefind/
frontend/public/pagefind
.pagefind/

# Tailwind / PostCSS
.tailwindcss/

# --- Logs ---
logs/
*.log
*.log.*
# 临时产物：安全审计 / pip-audit / gh CLI 输出
.audit-*.json
.audit-backend.log

# --- Trae/AI IDE ---
.trae/
.shared/
.kiro/
.clinerules/

# --- Media Files (user uploads, runtime generated) ---
media/
uploads/
static/uploads/

