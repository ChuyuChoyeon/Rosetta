*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
*.egg
pip-wheel-metadata/

# --- Virtual Environment ---
.venv/
venv/
ENV/
env/

# --- PyInstaller ---
*.manifest
*.spec

# --- Installer logs ---
pip-log.txt
pip-delete-this-directory.txt

# --- Unit test / coverage reports ---
.coverage
.coverage.*
htmlcov/
.pytest_cache/
coverage.xml
*.cover
.hypothesis/
test_results.json
junit/
.tox/
.nox/

# --- MyPy / Pyre / Pytype / Ruff ---
.ruff_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/

# --- Database ---
# Database files (never commit these)
*.sqlite3
*.sqlite3-journal
*.sqlite3-shm
*.sqlite3-wal
*.db
*.db-shm
*.db-wal

# Database migration files are COMMITTED (keep them!)
# Only ignore compiled migration cache
backend/migrations/**/__pycache__/

# --- Environment & Secrets ---
.env
.env.*
!.env.example
.secrets
*.pem
*.key

# --- IDE & Editors ---
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-workspace

# --- OS generated ---
.DS_Store
Thumbs.db
Desktop.ini
.directory
ehthumbs.db

# --- Testing & Coverage ---
# (duplicate guard)

