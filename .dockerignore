# ============================================================
# Rosetta Docker Ignore
# ============================================================

# Git
.git
.gitignore
.gitattributes
.github

# Python
__pycache__
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info
.eggs
dist
build
.pytest_cache
.mypy_cache
.ruff_cache

# uv 虚拟环境(容器内由 uv sync 重新创建)
.venv
venv
env
ENV

# Node.js
node_modules
frontend/node_modules
.npm
.pnpm-store

# Astro 构建产物(在 Docker 内重新构建)
frontend/dist
frontend/.astro

# 环境变量
.env
.env.local
.env.*.local

# IDE
.vscode
.idea
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# 日志
*.log
logs

# 媒体文件(运行时挂载卷)
media
static
uploads

# 数据库
*.db
*.sqlite
*.sqlite3
*.db-shm
*.db-wal

# OOBE 状态(容器内重新初始化)
.oobe_complete
.oobe_state.json
rosetta.json

# 文档(不需要打包到镜像)
*.md
docs
README.md
DEPLOY.md
backend/AGENTS.md
backend/CLAUDE.md
backend/docs
frontend/AGENTS.md
frontend/CLAUDE.md
frontend/CONTRIBUTING.md

# 测试(生产镜像不需要)
tests
.pytest_cache
.coverage
htmlcov
coverage.xml

# Docker 自身(避免递归)
docker-compose.yml
.dockerignore
Dockerfile

# Trae/AI IDE
.trae
.shared
.kiro

# Vercel / Cloudflare
.vercel
.wrangler
