# ============================================================
# Rosetta Git Attributes
# ============================================================

# 默认文本文件使用 LF 换行(跨平台一致)
* text=auto eol=lf

# Windows 批处理/PowerShell 脚本使用 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Shell 脚本使用 LF
*.sh text eol=lf

# 二进制文件(不做换行转换)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.mp3 binary
*.mp4 binary
*.webm binary
*.wav binary
*.pdf binary
*.zip binary
*.gz binary
*.tar binary

# linguist:Python 文件始终计入语言统计
*.py linguist-detectable

# 文档不计入语言统计
*.md linguist-documentation
docs/** linguist-documentation

# 锁文件不计入语言统计
pnpm-lock.yaml linguist-generated=true
uv.lock linguist-generated=true
